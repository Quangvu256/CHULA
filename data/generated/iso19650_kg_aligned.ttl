iso:term_eir_iso19650_2 a iso:Concept,
        iso:IsoNode ;
    rdfs:label "EIR (ISO 19650-2)" ;
    iso:DERIVED_FROM iso:term_air,
        iso:term_oir,
        iso:term_pir ;
    iso:GOVERNS iso:activity_information_model_delivery ;
    iso:PART_OF iso:term_appointment,

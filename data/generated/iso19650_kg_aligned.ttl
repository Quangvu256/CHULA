    iso:provenanceStandard "ISO 19650-1" ;
    rdf:object iso:term_information_model ;
    rdf:predicate iso:SUBTYPE_OF ;
    rdf:subject iso:term_aim .

iso:rel_120 a rdf:Statement ;
    iso:provenanceClause "Figure 3" ;
    iso:provenanceStandard "ISO 19650-2" ;
    iso:relationshipNote "Activity 8 marks the end of the delivery phase and is not repeated per appointment." ;
    rdf:object iso:activity_project_close_out_delivery ;
    rdf:predicate iso:PRECEDES ;
    rdf:subject iso:activity_information_model_delivery .

iso:rel_121 a rdf:Statement ;
    iso:provenanceClause "3.1.2.1; Figure 2" ;
    iso:provenanceStandard "ISO 19650-2" ;
    iso:relationshipNote "Project team = appointing party and all delivery teams." ;
    rdf:object iso:term_project_team ;
    rdf:predicate iso:MEMBER_OF ;
    rdf:subject iso:term_appointing_party .

iso:rel_122 a rdf:Statement ;
    iso:provenanceClause "3.1.2.1; 0.5" ;
    iso:provenanceStandard "ISO 19650-2" ;
    iso:relationshipNote "Delivery teams can join and leave the project team at any time (0.5 NOTE)." ;
    rdf:object iso:term_project_team ;
    rdf:predicate iso:MEMBER_OF ;
    rdf:subject iso:term_delivery_team .

iso:rel_123 a rdf:Statement ;
    iso:provenanceClause "5.1.1" ;
    iso:provenanceStandard "ISO 19650-2" ;
    iso:relationshipNote "The appointing party nominates individuals from within its own organization to undertake the information management function, or appoints a prospective lead appointed party or third party to undertake all or part of it, in which case a scope of services shall be established considering the tasks the party will be responsible for, the authority delegated, and the competency (knowledge or skills) needed. Shall reflect the long-term asset information management strategy per ISO 19650-1:2018, 5.3." ;
    rdf:object iso:function_project_information_management ;
    rdf:predicate iso:RESPONSIBLE_FOR ;
    rdf:subject iso:term_appointing_party .

iso:rel_124 a rdf:Statement ;
    iso:provenanceClause "5.1.2" ;
    iso:provenanceStandard "ISO 19650-2" ;
    iso:relationshipNote "Established to address the questions to which the appointing party needs answer(s) at each key decision point, considering the project scope, the intended purpose for which the information will be used, the project plan of work, the intended procurement route, the number of key decision points, the decisions needed at each, and the questions needing answers." ;
    rdf:object iso:term_pir ;
    rdf:predicate iso:ESTABLISHES ;
    rdf:subject iso:term_appointing_party .

iso:rel_125 a rdf:Statement ;
    iso:provenanceClause "5.1.3" ;
    iso:provenanceStandard "ISO 19650-2" ;
    rdf:object iso:term_information_delivery_milestone ;
    rdf:predicate iso:ESTABLISHES ;
    rdf:subject iso:term_appointing_party .

iso:rel_126 a rdf:Statement ;
    iso:provenanceClause "5.1.3" ;
    iso:provenanceStandard "ISO 19650-2" ;
    iso:relationshipNote "Information delivery milestones shall be established in accordance with the project's plan of work." ;
    rdf:object iso:term_plan_of_work ;
    rdf:predicate iso:DERIVED_FROM ;
    rdf:subject iso:term_information_delivery_milestone .

iso:rel_127 a rdf:Statement ;
    iso:provenanceClause "5.1.3" ;
    iso:provenanceStandard "ISO 19650-2" ;
    iso:relationshipNote "Milestones are set relative to the appointing party's key decision points, considering the nature and substance of information to be delivered at each key decision point." ;
    rdf:object iso:term_key_decision_point ;
    rdf:predicate iso:CORRESPONDS_TO ;
    rdf:subject iso:term_information_delivery_milestone .

iso:rel_128 a rdf:Statement ;
    iso:provenanceClause "3.1.2.2" ;
    iso:provenanceStandard "ISO 19650-2" ;
    iso:relationshipNote "Details principal stages in the design, construction work and maintenance of a project; may be extended to include demolition and recycling stages." ;
    rdf:object iso:term_delivery_phase ;
    rdf:predicate iso:DESCRIBES ;
    rdf:subject iso:term_plan_of_work .

iso:rel_129 a rdf:Statement ;
    iso:provenanceClause "5.1.4" ;
    iso:provenanceStandard "ISO 19650-2" ;
    rdf:object iso:term_project_information_standard ;
    rdf:predicate iso:ESTABLISHES ;
    rdf:subject iso:term_appointing_party .

iso:rel_13 a rdf:Statement ;
    iso:provenanceClause "3.3.10" ;
    iso:provenanceStandard "ISO 19650-1" ;
    rdf:object iso:term_information_model ;
    rdf:predicate iso:SUBTYPE_OF ;
    rdf:subject iso:term_pim .

iso:rel_130 a rdf:Statement ;
    iso:provenanceClause "5.1.4 d)" ;
    iso:provenanceStandard "ISO 19650-2" ;
    iso:relationshipNote "PdM HOOK: when establishing the project's information standard, the appointing party shall consider 'the use of information during the operational phase of the asset'. This is the normative requirement forcing the delivery phase to anticipate operational and maintenance information needs. See also 5.1.4 a), which covers the exchange of information between the appointing party and external operators or maintainers." ;
    rdf:object iso:term_operational_phase ;
    rdf:predicate iso:APPLIES_TO ;
    rdf:subject iso:term_project_information_standard .

iso:rel_131 a rdf:Statement ;
    iso:provenanceClause "5.1.4 c)" ;
    iso:provenanceStandard "ISO 19650-2" ;
    iso:relationshipNote "The project's information standard determines the method of assignment for level of information need (ISO 19650-1:2018, 11.2)." ;
    rdf:object iso:term_level_of_information_need ;
    rdf:predicate iso:GOVERNS ;
    rdf:subject iso:term_project_information_standard .

iso:rel_132 a rdf:Statement ;
    iso:provenanceClause "5.1.5" ;
    iso:provenanceStandard "ISO 19650-2" ;
    rdf:object iso:term_project_information_production_methods_procedures ;
    rdf:predicate iso:ESTABLISHES ;
    rdf:subject iso:term_appointing_party .

iso:rel_133 a rdf:Statement ;
    iso:provenanceClause "5.1.6; 5.2.2" ;
    iso:provenanceStandard "ISO 19650-2" ;
    iso:relationshipNote "REUSES the Part 3 node. Part 2 5.1.6 expands on the same content: existing asset information (from within the appointing party's organization, from adjacent asset owners such as utility companies, under licence from external providers, and from public libraries and other sources of historical records); shared resources (process output templates such as the BIM execution plan and MIDP, information container templates, style libraries, object libraries); and library objects defined within national and regional standards. 5.2.2: assembled for the tender process, recommended to be made available in a secure environment such as the project's CDE, with a status code identifying the suitability for which the information can be used." ;
    rdf:object iso:term_reference_information_shared_resources ;
    rdf:predicate iso:ESTABLISHES ;
    rdf:subject iso:term_appointing_party .

iso:rel_134 a rdf:Statement ;
    iso:provenanceClause "5.1.7" ;
    iso:provenanceStandard "ISO 19650-2" ;
    iso:relationshipNote "The appointing party shall establish (implement, configure and support) the project's CDE. It shall enable: a) each information container to have a unique ID based on an agreed and documented convention comprised of fields separated by a delimiter; b) each field to be assigned a value from an agreed and documented codification standard; c) each information container to have status (suitability), revision and classification (per ISO 12006-2) attributes assigned; d) information containers to transition between states; e) recording of user name and date when revisions transition between states; f) controlled access at information container level. Strongly recommended to be in place prior to issuing the invitation to tender. A third party can be appointed to host, manage or support the CDE, preferably as a separate appointment before procurement of any other appointed party. UK National Annex NA.2-NA.4 codifies a) to c)." ;
    rdf:object iso:term_cde ;
    rdf:predicate iso:ESTABLISHES ;
    rdf:subject iso:term_appointing_party .

iso:rel_135 a rdf:Statement ;
    iso:provenanceClause "5.1.7 c); NA.4.2" ;
    iso:provenanceStandard "ISO 19650-2" ;
    iso:relationshipNote "The project's CDE shall enable a status (suitability) attribute to be assigned to each information container. The UK National Annex supplies the S0, S1-S5, A1/An and deprecated B1/Bn codes. This duplicates the root semantic edge with Part 2-specific provenance." ;
    rdf:object iso:term_information_container ;
    rdf:predicate iso:DESCRIBES ;
    rdf:subject iso:term_status_code .

iso:rel_136 a rdf:Statement ;
    iso:provenanceClause "5.1.7 c); NA.4.3" ;
    iso:provenanceStandard "ISO 19650-2" ;
    iso:relationshipNote "The project's CDE shall enable a revision attribute to be assigned to each information container. The UK National Annex distinguishes preliminary P-series revisions from contractual C-series revisions. This duplicates the root semantic edge with Part 2-specific provenance." ;
    rdf:object iso:term_information_container ;
    rdf:predicate iso:DESCRIBES ;
    rdf:subject iso:term_revision_code .

iso:rel_137 a rdf:Statement ;
    iso:provenanceClause "5.1.7; 5.6.1-5.6.5" ;
    iso:provenanceStandard "ISO 19650-2" ;
    iso:relationshipNote "Direct requirement: the project CDE is established to support collaborative production. Task teams obtain reference/shared resources from it, coordinate against shared information, and use it for QA and approval-for-sharing workflows." ;
    rdf:object iso:activity_collaborative_production_of_information_delivery ;
    rdf:predicate iso:SUPPORTS ;
    rdf:subject iso:term_cde .

iso:rel_138 a rdf:Statement ;
    iso:provenanceClause "5.1.8" ;
    iso:provenanceStandard "ISO 19650-2" ;
    rdf:object iso:term_project_information_protocol ;
    rdf:predicate iso:ESTABLISHES ;
    rdf:subject iso:term_appointing_party .

iso:rel_139 a rdf:Statement ;
    iso:provenanceClause "5.1.8" ;
    iso:provenanceStandard "ISO 19650-2" ;
    iso:relationshipNote "Covers warranties or liabilities associated to the project information model, background and foreground intellectual property rights, use of information during the project including licensing terms, and re-use of information following the appointment or in the event of termination." ;
    rdf:object iso:term_pim ;
    rdf:predicate iso:GOVERNS ;
    rdf:subject iso:term_project_information_protocol .

iso:rel_14 a rdf:Statement ;
    iso:provenanceClause "3.3.8; 3.3.11" ;
    iso:provenanceStandard "ISO 19650-1" ;
    iso:relationshipNote "an information model is a set of structured and unstructured information containers; federation creates a composite information model from separate containers" ;
    rdf:object iso:term_information_model ;
    rdf:predicate iso:AGGREGATED_INTO ;
    rdf:subject iso:term_information_container .

iso:rel_140 a rdf:Statement ;
    iso:provenanceClause "5.1.8" ;
    iso:provenanceStandard "ISO 19650-2" ;
    iso:relationshipNote "INTERPRETIVE: phase counterparts rather than an equivalence asserted by ISO 19650-2. The Part 2 protocol is embedded in project appointments and includes PIM-related liabilities and re-use considerations; the Part 3 protocol is embedded in operational appointments and concerns the AIM. They are not merged because their scopes and governed appointments differ." ;
    rdf:object iso:term_asset_information_protocol ;
    rdf:predicate iso:CORRESPONDS_TO ;
    rdf:subject iso:term_project_information_protocol .

iso:rel_141 a rdf:Statement ;
    iso:provenanceClause "Annex A; Table A.1" ;
    iso:provenanceStandard "ISO 19650-2" ;
    iso:relationshipNote "Informative specialization of ISO 19650-1:2018, 3.1.1 responsibility matrix: the subject is the 40 information management tasks of Clause 5, the 'functions' are appointing party / third party / lead appointed party / appointed party, and the scale is R-A-C-I." ;
    rdf:object iso:term_responsibility_matrix ;
    rdf:predicate iso:REFINES ;
    rdf:subject iso:term_information_management_assignment_matrix .

iso:rel_142 a rdf:Statement ;
    iso:provenanceClause "5.1.1 NOTE; Annex A" ;
    iso:provenanceStandard "ISO 19650-2" ;
    iso:relationshipNote "Can help with establishing the scope of services needed where the appointing party appoints a prospective lead appointed party or third party to undertake all or part of the information management function." ;
    rdf:object iso:term_im_process_delivery ;
    rdf:predicate iso:APPLIES_TO ;
    rdf:subject iso:term_information_management_assignment_matrix .

iso:rel_143 a rdf:Statement ;
    iso:provenanceClause "5.2.1" ;
    iso:provenanceStandard "ISO 19650-2" ;
    iso:relationshipNote "Established to be met by the prospective lead appointed party during the appointment." ;
    rdf:object iso:term_eir_iso19650_2 ;
    rdf:predicate iso:ESTABLISHES ;
    rdf:subject iso:term_appointing_party .

iso:rel_144 a rdf:Statement ;
    iso:provenanceClause "5.2.1; 5.4.3" ;
    iso:provenanceStandard "ISO 19650-2" ;
    iso:relationshipNote "Delivery-phase specialization of the ISO 19650-1:2018, 3.3.6 concept 'exchange information requirements'. Parallel to term_eir_iso19650_3 REFINES term_eir (ISO 19650-3, 5.2.2): two specializations of the same root term, one for delivery-phase appointments and one for operational-phase appointments." ;
    rdf:object iso:term_eir ;
    rdf:predicate iso:REFINES ;
    rdf:subject iso:term_eir_iso19650_2 .

iso:rel_145 a rdf:Statement ;
    iso:provenanceClause "5.2.1 a)" ;
    iso:provenanceStandard "ISO 19650-2" ;
    iso:relationshipNote "In establishing the information requirements to be served during the appointment, the appointing party shall consider their organizational information requirements." ;
    rdf:object iso:term_oir ;
    rdf:predicate iso:DERIVED_FROM ;
    rdf:subject iso:term_eir_iso19650_2 .

iso:rel_146 a rdf:Statement ;
    iso:provenanceClause "5.2.1 a)" ;
    iso:provenanceStandard "ISO 19650-2" ;
    iso:relationshipNote "CORE PdM HOOK: when establishing the project's EIR, the appointing party shall consider its ASSET INFORMATION REQUIREMENTS. This is the normative mechanism that writes operational and maintenance information needs - and therefore the data foundation for PdM - into the contract right from the delivery phase, before the asset exists." ;
    rdf:object iso:term_air ;
    rdf:predicate iso:DERIVED_FROM ;
    rdf:subject iso:term_eir_iso19650_2 .

iso:rel_147 a rdf:Statement ;
    iso:provenanceClause "5.2.1 a)" ;
    iso:provenanceStandard "ISO 19650-2" ;
    iso:relationshipNote "In establishing the information requirements to be served during the appointment, the appointing party shall consider their project information requirements." ;
    rdf:object iso:term_pir ;
    rdf:predicate iso:DERIVED_FROM ;
    rdf:subject iso:term_eir_iso19650_2 .

iso:rel_148 a rdf:Statement ;
    iso:provenanceClause "5.2.1 b); 5.4.3 b)" ;
    iso:provenanceStandard "ISO 19650-2" ;
    iso:relationshipNote "The level of information need required to meet each information requirement shall be established within the EIR. NOTE: other metrics describing the status of information, such as level of accuracy, can be added as considered appropriate." ;
    rdf:object iso:term_eir_iso19650_2 ;
    rdf:predicate iso:GOVERNS ;
    rdf:subject iso:term_level_of_information_need .

iso:rel_149 a rdf:Statement ;
    iso:provenanceClause "5.2.1 c); 5.4.3 c)" ;
    iso:provenanceStandard "ISO 19650-2" ;
    iso:relationshipNote "REUSES the Part 3 node. Acceptance criteria shall be established for each information requirement, considering the project's information standard, the project's information production methods and procedures, and the use of reference information or shared resources provided by the appointing party (or by the lead appointed party, in 5.4.3 c). The normative definition of this term lives in ISO 19650-2, 3.1.1.1 - see extraction_notes.definitional_home_corrections." ;
    rdf:object iso:term_eir_iso19650_2 ;
    rdf:predicate iso:PART_OF ;
    rdf:subject iso:term_acceptance_criteria .

iso:rel_15 a rdf:Statement ;
    iso:provenanceClause "3.3.13; 12.1" ;
    iso:provenanceStandard "ISO 19650-1" ;
    iso:relationshipNote "status code is metadata of each information container managed through the CDE, showing the permitted use(s) of information" ;
    rdf:object iso:term_information_container ;
    rdf:predicate iso:DESCRIBES ;
    rdf:subject iso:term_status_code .

iso:rel_150 a rdf:Statement ;
    iso:provenanceClause "5.2.1 e); 5.4.3 d)" ;
    iso:provenanceStandard "ISO 19650-2" ;
    iso:relationshipNote "The dates that each requirement has to be met are established relative to the project's information delivery milestones and the appointing party's key decision points, considering the time needed by the appointing party (or lead appointed party) to review and accept/authorize information and their internal assurance processes." ;
    rdf:object iso:term_information_delivery_milestone ;
    rdf:predicate iso:RESPONDS_TO ;
    rdf:subject iso:term_eir_iso19650_2 .

iso:rel_151 a rdf:Statement ;
    iso:provenanceClause "5.2.1 a)" ;
    iso:provenanceStandard "ISO 19650-2" ;
    iso:relationshipNote "INTERPRETIVE: derived via 5.2.1 a) (the EIR shall consider the AIR) plus ISO 19650-1:2018, 5.1 (the purpose 'maintenance and repair' is one of the purposes the appointing party must state for its information deliverables). ISO 19650-2 does not name this purpose directly." ;
    rdf:object iso:purpose_maintenance_repair ;
    rdf:predicate iso:SERVES_PURPOSE ;
    rdf:subject iso:term_eir_iso19650_2 .

iso:rel_152 a rdf:Statement ;
    iso:provenanceClause "5.2.1 a); 5.1.4 d)" ;
    iso:provenanceStandard "ISO 19650-2" ;
    iso:relationshipNote "INTERPRETIVE: derived via 5.2.1 a) (the EIR shall consider the AIR) and 5.1.4 d) (use of information during the operational phase), plus the ISO 19650-1:2018, 5.1 purpose 'operations'." ;
    rdf:object iso:purpose_operations ;
    rdf:predicate iso:SERVES_PURPOSE ;
    rdf:subject iso:term_eir_iso19650_2 .

iso:rel_153 a rdf:Statement ;
    iso:provenanceClause "5.2.3" ;
    iso:provenanceStandard "ISO 19650-2" ;
    iso:relationshipNote "REUSES the Part 3 node. (term_evaluation_criteria - 'response requirements and evaluation criteria'). Part 2 5.2.3: the appointing party shall establish the requirements that tendering organizations shall meet within their tender response, considering the contents of the delivery team's (pre-appointment) BIM execution plan, the competency of the prospective individuals undertaking the information management function, the prospective lead appointed party's assessment of the delivery team's capability and capacity, the delivery team's proposed mobilization plan, and the delivery team's information delivery risk assessment." ;
    rdf:object iso:term_evaluation_criteria ;
    rdf:predicate iso:ESTABLISHES ;
    rdf:subject iso:term_appointing_party .

iso:rel_154 a rdf:Statement ;
    iso:provenanceClause "5.2.4" ;
    iso:provenanceStandard "ISO 19650-2" ;
    rdf:object iso:term_invitation_to_tender_information ;
    rdf:predicate iso:ESTABLISHES ;
    rdf:subject iso:term_appointing_party .

iso:rel_155 a rdf:Statement ;
    iso:provenanceClause "5.2.4" ;
    iso:provenanceStandard "ISO 19650-2" ;
    rdf:object iso:term_invitation_to_tender_information ;
    rdf:predicate iso:PART_OF ;
    rdf:subject iso:term_eir_iso19650_2 .

iso:rel_156 a rdf:Statement ;
    iso:provenanceClause "5.2.4" ;
    iso:provenanceStandard "ISO 19650-2" ;
    iso:relationshipNote "The relevant reference information and shared resources, held within the project's common data environment." ;
    rdf:object iso:term_invitation_to_tender_information ;
    rdf:predicate iso:PART_OF ;
    rdf:subject iso:term_reference_information_shared_resources .

iso:rel_157 a rdf:Statement ;
    iso:provenanceClause "5.2.4" ;
    iso:provenanceStandard "ISO 19650-2" ;
    iso:relationshipNote "Tender response requirements and evaluation criteria, if applicable." ;
    rdf:object iso:term_invitation_to_tender_information ;
    rdf:predicate iso:PART_OF ;
    rdf:subject iso:term_evaluation_criteria .

iso:rel_158 a rdf:Statement ;
    iso:provenanceClause "5.2.4" ;
    iso:provenanceStandard "ISO 19650-2" ;
    rdf:object iso:term_invitation_to_tender_information ;
    rdf:predicate iso:PART_OF ;
    rdf:subject iso:term_information_delivery_milestone .

iso:rel_159 a rdf:Statement ;
    iso:provenanceClause "5.2.4" ;
    iso:provenanceStandard "ISO 19650-2" ;
    rdf:object iso:term_invitation_to_tender_information ;
    rdf:predicate iso:PART_OF ;
    rdf:subject iso:term_project_information_standard .

iso:rel_16 a rdf:Statement ;
    iso:provenanceClause "11.2" ;
    iso:provenanceStandard "ISO 19650-1" ;
    iso:relationshipNote "the level of information need of each information deliverable is determined according to its purpose and can vary from deliverable to deliverable; described within OIR, PIR, AIR or EIR" ;
    rdf:object iso:term_information_container ;
    rdf:predicate iso:APPLIES_TO ;
    rdf:subject iso:term_level_of_information_need .

iso:rel_160 a rdf:Statement ;
    iso:provenanceClause "5.2.4" ;
    iso:provenanceStandard "ISO 19650-2" ;
    rdf:object iso:term_invitation_to_tender_information ;
    rdf:predicate iso:PART_OF ;
    rdf:subject iso:term_project_information_production_methods_procedures .

iso:rel_161 a rdf:Statement ;
    iso:provenanceClause "5.2.4" ;
    iso:provenanceStandard "ISO 19650-2" ;
    rdf:object iso:term_invitation_to_tender_information ;
    rdf:predicate iso:PART_OF ;
    rdf:subject iso:term_project_information_protocol .

iso:rel_162 a rdf:Statement ;
    iso:provenanceClause "5.3.1" ;
    iso:provenanceStandard "ISO 19650-2" ;
    iso:relationshipNote "The prospective lead appointed party nominates individuals from within its own organization, or appoints a prospective appointed party or third party (with a scope of services), considering the appointing party's EIR, the tasks and authority delegated, the competency needed, and probity arrangements if potential conflicts of interest may arise. Where the appointing party appoints the prospective lead appointed party to undertake the function on its behalf, it is recommended that individuals undertake the function on behalf of either one party or the other, not both." ;
    rdf:object iso:function_project_information_management ;
    rdf:predicate iso:RESPONSIBLE_FOR ;
    rdf:subject iso:term_lead_appointed_party .

iso:rel_163 a rdf:Statement ;
    iso:provenanceClause "5.3.2; 5.4.1" ;
    iso:provenanceStandard "ISO 19650-2" ;
    iso:relationshipNote "REUSES the Part 3 node. The normative definition lives in ISO 19650-2, 3.1.3.1 - see extraction_notes.definitional_home_corrections. The pre-appointment version is established by the prospective lead appointed party for inclusion in the tender response (5.3.2), including a proposed schedule of software (with versions), hardware and IT infrastructure the delivery team intends to adopt (5.3.2 g), and any proposed additions or amendments to the project's information production methods and procedures (5.3.2 e) and information standard (5.3.2 f). It is confirmed in agreement with each appointed party at appointment (5.4.1): confirm the individuals undertaking the information management function, update the information delivery strategy and high-level responsibility matrix as required, confirm and document the delivery team's proposed information production methods and procedures, agree with the appointing party any additions or amendments to the project's information standard, and confirm the schedule of software, hardware and IT infrastructure." ;
    rdf:object iso:term_bim_execution_plan ;
    rdf:predicate iso:ESTABLISHES ;
    rdf:subject iso:term_lead_appointed_party .

iso:rel_164 a rdf:Statement ;
    iso:provenanceClause "5.3.2 b)" ;
    iso:provenanceStandard "ISO 19650-2" ;
    iso:relationshipNote "The delivery team's information delivery strategy contains the delivery team's approach to meeting the appointing party's exchange information requirements." ;
    rdf:object iso:term_eir_iso19650_2 ;
    rdf:predicate iso:RESPONDS_TO ;
    rdf:subject iso:term_bim_execution_plan .

iso:rel_165 a rdf:Statement ;
    iso:provenanceClause "5.3.2 b); 5.4.1 b)" ;
    iso:provenanceStandard "ISO 19650-2" ;
    rdf:object iso:term_bim_execution_plan ;
    rdf:predicate iso:PART_OF ;
    rdf:subject iso:term_information_delivery_strategy .

iso:rel_166 a rdf:Statement ;
    iso:provenanceClause "5.3.2 c)" ;
    iso:provenanceStandard "ISO 19650-2" ;
    iso:relationshipNote "The proposed federation strategy to be adopted by the delivery team is a required consideration of the (pre-appointment) BIM execution plan; ISO 19650-1:2018, 10.4 defines the concept and its development into information container breakdown structures." ;
    rdf:object iso:term_bim_execution_plan ;
    rdf:predicate iso:PART_OF ;
    rdf:subject iso:term_federation_strategy .

iso:rel_167 a rdf:Statement ;
    iso:provenanceClause "5.3.2 d); 5.4.1 c)" ;
    iso:provenanceStandard "ISO 19650-2" ;
    rdf:object iso:term_bim_execution_plan ;
    rdf:predicate iso:PART_OF ;
    rdf:subject iso:term_high_level_responsibility_matrix .

iso:rel_168 a rdf:Statement ;
    iso:provenanceClause "5.3.2 d)" ;
    iso:provenanceStandard "ISO 19650-2" ;
    iso:relationshipNote "Delivery-phase, delivery-team-level form of the ISO 19650-1:2018, 3.1.1 responsibility matrix: allocated responsibility for each element of the information model and the key deliverables associated to each element." ;
    rdf:object iso:term_responsibility_matrix ;
    rdf:predicate iso:REFINES ;
    rdf:subject iso:term_high_level_responsibility_matrix .

iso:rel_169 a rdf:Statement ;
    iso:provenanceClause "5.3.3; 5.3.4" ;
    iso:provenanceStandard "ISO 19650-2" ;
    iso:relationshipNote "REUSES the Part 1 node. Each task team assesses its capability and capacity to deliver information in accordance with the appointing party's EIR and the proposed (pre-appointment) BIM execution plan, considering: capability and capacity to MANAGE information (relevant experience and number of members who have managed information per the proposed information delivery strategy; education and training available); capability and capacity to PRODUCE information (experience and number of members who have produced information per the project's information production methods and procedures; education and training available); and availability of IT (proposed IT schedule, specification and quantity of hardware, architecture/maximum capacity/current utilization of IT infrastructure, support and service level agreements). The prospective lead appointed party aggregates these into a summary of the delivery team's capability to manage and produce information and its capacity for timely delivery (5.3.4)." ;
    rdf:object iso:activity_tender_response_delivery ;
    rdf:predicate iso:PART_OF ;
    rdf:subject iso:term_capability_capacity_review .

iso:rel_17 a rdf:Statement ;
    iso:provenanceClause "3.2.13; 6.2" ;
    iso:provenanceStandard "ISO 19650-1" ;
    iso:relationshipNote "a trigger event results in information exchange; during the operational phase trigger events can require an information management response" ;
    rdf:object iso:term_information_exchange ;
    rdf:predicate iso:RESULTS_IN ;
    rdf:subject iso:term_trigger_event .

iso:rel_170 a rdf:Statement ;
    iso:provenanceClause "5.3.3" ;
    iso:provenanceStandard "ISO 19650-2" ;
    iso:relationshipNote "Each task team shall assess its own capability and capacity to deliver information." ;
    rdf:object iso:term_capability_capacity_review ;
    rdf:predicate iso:RESPONSIBLE_FOR ;
    rdf:subject iso:term_task_team .

iso:rel_171 a rdf:Statement ;
    iso:provenanceClause "5.3.4" ;
    iso:provenanceStandard "ISO 19650-2" ;
    iso:relationshipNote "The prospective lead appointed party aggregates the task-team assessments into a delivery-team capability and capacity summary." ;
    rdf:object iso:term_capability_capacity_review ;
    rdf:predicate iso:RESPONSIBLE_FOR ;
    rdf:subject iso:term_lead_appointed_party .

iso:rel_172 a rdf:Statement ;
    iso:provenanceClause "5.3.3" ;
    iso:provenanceStandard "ISO 19650-2" ;
    iso:relationshipNote "The assessment is explicitly undertaken to determine capability and capacity to deliver information in accordance with the appointing party's EIR and proposed pre-appointment BIM execution plan." ;
    rdf:object iso:term_eir_iso19650_2 ;
    rdf:predicate iso:RESPONDS_TO ;
    rdf:subject iso:term_capability_capacity_review .

iso:rel_173 a rdf:Statement ;
    iso:provenanceClause "5.3.5" ;
    iso:provenanceStandard "ISO 19650-2" ;
    iso:relationshipNote "REUSES the Part 3 node. Part 2 5.3.5 adds two project-specific items not present in ISO 19650-3, 5.3.5: configuring and testing the PROJECT's CDE per 5.1.7, and configuring and testing the DELIVERY TEAM's (distributed) CDE and its connectivity to the project CDE per 5.1.7." ;
    rdf:object iso:term_mobilization_plan ;
    rdf:predicate iso:ESTABLISHES ;
    rdf:subject iso:term_lead_appointed_party .

iso:rel_174 a rdf:Statement ;
    iso:provenanceClause "5.3.6" ;
    iso:provenanceStandard "ISO 19650-2" ;
    iso:relationshipNote "REUSES the Part 3 node. Part 2 5.3.6: risks associated with the timely delivery of information in accordance with the appointing party's EIR and how the delivery team intends to manage them, considering risks associated with assumptions made in relation to the EIR, meeting the project's information delivery milestones, the contents of the project's information protocol, achieving the proposed information delivery strategy, adopting the project's information standard and information production methods and procedures, inclusion (or non-inclusion) of proposed amendments to the project's information standard, and mobilization of the delivery team to achieve the required capability and capacity. NOTE: can be incorporated within other risk registers used throughout the project." ;
    rdf:object iso:term_risk_register ;
    rdf:predicate iso:ESTABLISHES ;
    rdf:subject iso:term_lead_appointed_party .

iso:rel_175 a rdf:Statement ;
    iso:provenanceClause "5.3.6" ;
    iso:provenanceStandard "ISO 19650-2" ;
    iso:relationshipNote "The risk register addresses timely information delivery in accordance with the appointing party's EIR; the individual 'shall consider' risk factors remain folded into the establishing relationship note." ;
    rdf:object iso:term_eir_iso19650_2 ;
    rdf:predicate iso:RESPONDS_TO ;
    rdf:subject iso:term_risk_register .

iso:rel_176 a rdf:Statement ;
    iso:provenanceClause "5.3.6; 5.3.7" ;
    iso:provenanceStandard "ISO 19650-2" ;
    iso:relationshipNote "ISO 19650-2, 5.3.7 calls the output of 5.3.6 an 'information delivery risk assessment' when listing the contents of the tender response - confirming that this is the operationalization of the ISO 19650-1:2018, 6.3.1 concept." ;
    rdf:object iso:term_information_delivery_risk_assessment ;
    rdf:predicate iso:CORRESPONDS_TO ;
    rdf:subject iso:term_risk_register .

iso:rel_177 a rdf:Statement ;
    iso:provenanceClause "5.3.7" ;
    iso:provenanceStandard "ISO 19650-2" ;
    rdf:object iso:term_delivery_team_tender_response ;
    rdf:predicate iso:ESTABLISHES ;
    rdf:subject iso:term_lead_appointed_party .

iso:rel_178 a rdf:Statement ;
    iso:provenanceClause "5.3.7" ;
    iso:provenanceStandard "ISO 19650-2" ;
    rdf:object iso:term_delivery_team_tender_response ;
    rdf:predicate iso:PART_OF ;
    rdf:subject iso:term_bim_execution_plan .

iso:rel_179 a rdf:Statement ;
    iso:provenanceClause "5.3.7" ;
    iso:provenanceStandard "ISO 19650-2" ;
    iso:relationshipNote "Included as the capability and capacity assessment summary (5.3.4)." ;
    rdf:object iso:term_delivery_team_tender_response ;
    rdf:predicate iso:PART_OF ;
    rdf:subject iso:term_capability_capacity_review .

iso:rel_18 a rdf:Statement ;
    iso:provenanceClause "5.3" ;
    iso:provenanceStandard "ISO 19650-1" ;
    iso:relationshipNote "a set of AIR should be prepared in response to each trigger event during asset operation" ;
    rdf:object iso:term_trigger_event ;
    rdf:predicate iso:RESPONDS_TO ;
    rdf:subject iso:term_air .

iso:rel_180 a rdf:Statement ;
    iso:provenanceClause "5.3.7" ;
    iso:provenanceStandard "ISO 19650-2" ;
    rdf:object iso:term_delivery_team_tender_response ;
    rdf:predicate iso:PART_OF ;
    rdf:subject iso:term_mobilization_plan .

iso:rel_181 a rdf:Statement ;

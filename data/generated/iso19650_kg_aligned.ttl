iso:rel_657 a rdf:Statement ;
    iso:provenanceClause "7.5.1 b)" ;
    iso:provenanceStandard "ISO 19650-5" ;
    iso:relationshipNote "The compliance of any delivery team with all relevant aspects of the security management plan shall be assessed, as a minimum on a risk-based sampling approach." ;
    rdf:object iso:term_delivery_team ;
    rdf:predicate iso:APPLIES_TO ;
    rdf:subject iso:term_security_monitoring_auditing .

iso:rel_658 a rdf:Statement ;
    iso:provenanceClause "7.5.3" ;
    iso:provenanceStandard "ISO 19650-5" ;
    iso:relationshipNote "The organization CAN delegate some responsibility for compliance verification within the delivery team to a lead appointed party, but retains accountability for the overall effectiveness of the security controls." ;
    rdf:object iso:term_security_monitoring_auditing ;
    rdf:predicate iso:RESPONSIBLE_FOR ;
    rdf:subject iso:term_lead_appointed_party .

iso:rel_659 a rdf:Statement ;
    iso:provenanceClause "7.5.1 NOTE 2" ;
    iso:provenanceStandard "ISO 19650-5" ;
    iso:relationshipNote "Explicit link back to ISO 19650-1: where applicable, the compliance of the delivery team with all relevant aspects of the security management plan CAN form part of the capability and capacity review defined in ISO 19650-1 (8.1; 8.2)." ;
    rdf:object iso:term_security_management_plan ;
    rdf:predicate iso:APPLIES_TO ;
    rdf:subject iso:term_capability_capacity_review .

iso:rel_66 a rdf:Statement ;
    iso:provenanceClause "4.3" ;
    iso:provenanceStandard "ISO 19650-1" ;
    iso:relationshipNote "perspectives should be incorporated in the specification of information requirements, in the planning for information delivery, and in the delivery of information; defined case-by-case, the four in Table 1 recommended" ;

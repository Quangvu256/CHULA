    iso:relationshipNote "CDE shall enable each information container to have a revision attribute assigned." ;
    rdf:object iso:term_information_container ;
    rdf:predicate iso:DESCRIBES ;
    rdf:subject iso:term_revision_code .

iso:rel_327 a rdf:Statement ;
    iso:provenanceClause "5.1.10; 5.1.11 Note 1; A.5" ;
    iso:provenanceStandard "ISO 19650-3" ;
    iso:relationshipNote "AIM can be held across any combination of new and existing enterprise systems provided they are appropriately linked and AIM contents are controlled using the CDE workflow of ISO 19650-1; information quality and security processes within linked systems shall be established/adapted to comply with ISO 19650-3." ;
    rdf:object iso:term_aim ;
    rdf:predicate iso:LINKED_TO ;
    rdf:subject iso:term_enterprise_system .

iso:rel_328 a rdf:Statement ;
    iso:provenanceClause "5.1.11" ;
    iso:provenanceStandard "ISO 19650-3" ;
    iso:relationshipNote "The AIM shall be a federated information model which can include contents from different information providers (appointed parties)." ;
    rdf:object iso:term_aim ;
    rdf:predicate iso:APPLIES_TO ;
    rdf:subject iso:term_federation .

iso:rel_329 a rdf:Statement ;
    iso:provenanceClause "5.1.12" ;
    iso:provenanceStandard "ISO 19650-3" ;
    iso:relationshipNote "Maintain the AIM for as long as appropriate; period can be based on ownership/occupancy/operating/asset-management agreement duration and constrained by strategic, contractual, statutory, legal, regulatory, health and safety, environmental, social and fiscal constraints (Note 1)." ;
    rdf:object iso:term_aim ;
    rdf:predicate iso:APPLIES_TO ;
    rdf:subject iso:term_aim_maintenance_process .

iso:rel_33 a rdf:Statement ;
    iso:provenanceClause "12.1; 12.4; Figure 10" ;

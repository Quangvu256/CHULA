iso:rel_832 a rdf:Statement ;
    iso:provenanceClause "Table 4" ;
    iso:provenanceStandard "ISO 19650-6" ;
    iso:relationshipNote "The order of listing in Table 4 reflects the hierarchy of controls in descending order of effectiveness: Elimination, Substitution, Control, Information. See ISO 45001, ISO 45002 and ISO 45006." ;
    rdf:object iso:term_treatment_substitution ;
    rdf:predicate iso:PRECEDES ;
    rdf:subject iso:term_treatment_elimination .


    iso:relationshipNote "Operational-phase specialization of the ISO 19650-1:2018, 3.3.6 concept 'exchange information requirements'; established per appointment and per trigger event to meet AIR and therefore OIR." ;
    rdf:object iso:term_eir ;
    rdf:predicate iso:REFINES ;
    rdf:subject iso:term_eir_iso19650_3 .

iso:rel_335 a rdf:Statement ;
    iso:provenanceClause "5.2.2" ;
    iso:provenanceStandard "ISO 19650-3" ;
    iso:relationshipNote "EIR (ISO 19650-3) necessary to enable the appointing party to meet its AIR, and therefore the appropriate OIR." ;
    rdf:object iso:term_air ;
    rdf:predicate iso:DERIVED_FROM ;
    rdf:subject iso:term_eir_iso19650_3 .


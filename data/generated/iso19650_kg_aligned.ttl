iso:term_exchange_mobilization_testing a iso:Concept,
        iso:IsoNode ;
    rdfs:label "mobilization and testing prior to information exchange" ;
    iso:CORRESPONDS_TO iso:activity_mobilization,
        iso:activity_mobilization_delivery ;
    iso:PRECEDES iso:term_information_exchange_process ;
    iso:definition "testing of the methods and procedures of undertaking an information exchange to ensure flow of information, prior to finalizing requirements and exchanging deliverables; the information provider shall review and confirm the selected authoring software, which shall support import of the schemas and data formats of relevant reference information, export of the requested schemas and data formats, and interaction with any agreed issue and risk registering and agreed management tools; the information receivers and reviewers shall review and confirm the versions of open and proprietary data formats to be used; the receivers shall check and confirm review and integration software capable of importing into a persistent information container, federating using applications to create a temporary information resource, and linking as information references or semantic web linking" ;
    iso:nodeId "term_exchange_mobilization_testing" ;
    iso:part "ISO 19650-4" ;
    iso:pdmRelevance "high" ;
    iso:provenanceClause "5.1.2" ;
    iso:provenanceStandard "ISO 19650-4" ;
    iso:sourceType "body_clause" .

iso:term_hs_classification_safety a iso:Concept,
        iso:IsoNode ;
    rdfs:label "safety issue" ;
    iso:LINKED_TO iso:term_asset_failure_history,
        iso:term_failure_mode ;
    iso:PART_OF iso:term_hs_categorization ;
    iso:definition "third top-level category of the example health and safety classification: 31 fall (311 from ladder, 312 from open edge, 313 from scaffold, 314 through fragile material, 315 slip or trip on the same level); 32 trapped (321 confinement, 322 crushed by excavation, 323 unintended collapse, 324 drowning and flooding, 325 asphyxiation); 33 event (331 electric shock, 332 fire or explosion, 333 machinery guarding, 334 loss of control); 34 handling (341 materials handling including manual handling, 342 mechanical lifting operation, 343 mobile elevating work platform operation, 346 working overhead); 35 struck (351 by falling object, 352 by moving vehicle, 353 by machinery or part, 354 overturning plant or moving machinery); 36 public protection issue" ;
    iso:nodeId "term_hs_classification_safety" ;
    iso:part "ISO 19650-6" ;
    iso:pdmRelevance "high" ;
    iso:provenanceClause "Annex B" ;
    iso:provenanceStandard "ISO 19650-6" ;
    iso:sourceType "body_clause" .


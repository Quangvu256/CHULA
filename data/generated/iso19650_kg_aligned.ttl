iso:term_security_management_plan a iso:Concept,
        iso:IsoNode ;
    rdfs:label "security management plan" ;
    iso:GOVERNS iso:term_appointed_party_security_management,
        iso:term_appointment ;
    iso:LINKED_TO iso:term_asset_management ;
    iso:PART_OF iso:term_security_minded_approach ;
    iso:RESPONDS_TO iso:term_security_risk_mitigation_measure ;
    iso:SPECIFIED_IN iso:term_security_strategy ;
    iso:definition "plan developed, maintained and implemented by the organization(s) which enables the agreed mitigation measures set out in the security strategy to be implemented in a consistent and holistic manner; shall contain, in relation to the organization(s) and its delivery team: a) the policies setting out the security-related business rules derived from the agreed mitigation measures; b) the processes derived from those policies and guidance on their consistent implementation; c) the security information requirements; d) the requirements relating to the provision of information to third parties; e) where applicable, logistical security requirements; f) a security breach/incident management plan; g) details of accountability and responsibility for implementation; h) monitoring and auditing requirements including testing of security measures in place; and i) the mechanisms for reviewing and updating the plan" ;
    iso:nodeId "term_security_management_plan" ;
    iso:part "ISO 19650-5" ;
    iso:pdmRelevance "high" ;
    iso:provenanceClause "7.1" ;
    iso:provenanceStandard "ISO 19650-5" ;

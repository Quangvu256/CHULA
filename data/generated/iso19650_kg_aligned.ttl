    iso:provenanceStandard "ISO 19650-3" ;
    iso:relationshipNote "Information to be captured during the response to the trigger event shall be consistent with any definition of level of information need (ISO 19650-1:2018, 11.2)." ;
    rdf:object iso:term_eir_iso19650_3 ;
    rdf:predicate iso:GOVERNS ;
    rdf:subject iso:term_level_of_information_need .


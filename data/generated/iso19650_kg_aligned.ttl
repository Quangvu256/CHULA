iso:term_hs_identifier a iso:Concept,
        iso:IsoNode ;
    rdfs:label "health and safety record identifier" ;
    iso:PART_OF iso:term_hs_schema ;
    iso:definition "identifier which shall be unique to the project or asset; the context identifier is composed of the project/asset identifier as identified in the project/asset information standard (example PR101); risk, risk treatment and incident identifiers are composed of the project/asset identifier - the originator identifier - the sequential number ( - record type), where the identifier includes the originator raising the risk, treatment or incident, the sequential number is unique within the context and typically four digits, and an optional final element (record type) can distinguish among risk, treatment or incident (example PR101-AAA-0003-Risk)" ;
    iso:nodeId "term_hs_identifier" ;
    iso:part "ISO 19650-6" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceClause "4.4; Figure 2; Figure 3" ;
    iso:provenanceStandard "ISO 19650-6" ;
    iso:sourceType "body_clause" .


iso:term_security_triage a iso:Concept,
        iso:IsoNode ;
    rdfs:label "security triage process" ;
    iso:PART_OF iso:term_security_strategy ;
    iso:RESULTS_IN iso:decision_triage_a_subject_sensitive ;
    iso:definition "three-question process (Figure 3) applied by the organization(s) to determine whether a security-minded approach is required: A - is the initiative, project, asset, product or service, as well as any associated information, in whole or in part, whether planned or existing, considered sensitive (4.3)? B - will access be, or has already been, gained to information about another organization, its assets, products or services that is not otherwise publicly available (4.4.1)? C - is that information about another organization considered sensitive (4.4.2)? The outcome is recorded as ST1, ST2, ST3 or ST4" ;
    iso:nodeId "term_security_triage" ;
    iso:part "ISO 19650-5" ;
    iso:pdmRelevance "high" ;
    iso:provenanceClause "4.7; 4.8; Figure 3" ;
    iso:provenanceStandard "ISO 19650-5" ;
    iso:sourceType "body_clause" .


    iso:provenanceStandard "ISO 19650-6" ;
    rdf:object iso:term_treatment_information ;
    rdf:predicate iso:PRECEDES ;
    rdf:subject iso:term_treatment_control .

iso:rel_835 a rdf:Statement ;
    iso:provenanceClause "4.5.4 a)" ;
    iso:provenanceStandard "ISO 19650-6" ;
    iso:relationshipNote "4.5.4 a): hazards TO BE ELIMINATED by informed decisions - so elimination belongs to the design stage. Introduction: risk treatments are linked so as to prioritize the production of INHERENTLY SAFER outcomes during the delivery and operational phases." ;
    rdf:object iso:stage_design ;
    rdf:predicate iso:APPLIES_TO ;
    rdf:subject iso:term_treatment_elimination .

iso:rel_836 a rdf:Statement ;
    iso:provenanceClause "4.3.3; Table 2" ;
    iso:provenanceStandard "ISO 19650-6" ;
    iso:relationshipNote "The 'Application stage' enumeration is shared across the risk, incident and treatment schemas; it is based on ISO 22263 with the addition of operation and repurposing." ;
    rdf:object iso:stage_briefing ;
    rdf:predicate iso:PRECEDES ;
    rdf:subject iso:stage_inception .

iso:rel_837 a rdf:Statement ;
    iso:provenanceClause "4.3.3; Table 2" ;
    iso:provenanceStandard "ISO 19650-6" ;
    rdf:object iso:stage_design ;
    rdf:predicate iso:PRECEDES ;
    rdf:subject iso:stage_briefing .


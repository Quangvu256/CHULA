iso:term_security_risk_mitigation_measure a iso:Concept,
        iso:IsoNode ;
    rdfs:label "security risk mitigation measure" ;
    iso:PRECEDES iso:term_tolerated_security_risk ;
    iso:RESPONDS_TO iso:term_security_risk ;
    iso:SPECIFIED_IN iso:term_security_strategy ;
    iso:definition "measure identified and recorded by the organization(s) for each security risk or combination of risks, considering personnel, physical, and technical security controls and requirements around the management of information; each potential measure is assessed against a) the cost of the measure and its implementation, b) the risk reduction achievable and the level of residual risk, c) the predicted cost impact, d) other impacts on the asset (which can include usability, efficiency and appearance), e) the potential for the measure to create further vulnerabilities, and f) whether the measure delivers any other business benefits" ;
    iso:nodeId "term_security_risk_mitigation_measure" ;
    iso:part "ISO 19650-5" ;
    iso:pdmRelevance "high" ;
    iso:provenanceClause "6.3" ;
    iso:provenanceStandard "ISO 19650-5" ;
    iso:sourceType "body_clause" .


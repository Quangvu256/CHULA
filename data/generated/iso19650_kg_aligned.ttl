iso:term_third_party_information_provision_assessment a iso:Concept,
        iso:IsoNode ;
    rdfs:label "third-party information provision assessment" ;
    iso:APPLIES_TO iso:term_information_model ;
    iso:PART_OF iso:term_security_management_plan ;
    iso:PRECEDES iso:term_logistical_security ;
    iso:RESPONDS_TO iso:term_information_aggregation_risk,
        iso:term_pattern_of_life,
        iso:term_pattern_of_use ;
    iso:definition "assessment required by the security management plan prior to sharing and/or publishing new, modified or existing information or an information model in whole or in part; shall be capable of responding to the need to comply with regulatory and statutory process, requests for information received by an organization subject to public access or transparency legislation, and the need to have material usable at public and professional events, in marketing material, in technical, academic or other publications and websites; shall consider whether the information or information model a) contains or allows sensitive information, including information about vulnerabilities, to be deduced about an initiative, project, asset, product, service, individual or group/community, b) when aggregated with existing shared or published material allows sensitive information to be deduced, and c) where applicable, contributes to determining the pattern-of-use of an asset(s) and/or the pattern-of-life of individuals or groups/communities not otherwise publicly available" ;
    iso:nodeId "term_third_party_information_provision_assessment" ;
    iso:part "ISO 19650-5" ;
    iso:pdmRelevance "high" ;
    iso:provenanceClause "7.2; Annex C" ;
    iso:provenanceStandard "ISO 19650-5" ;
    iso:sourceType "mixed_normative_informative" .


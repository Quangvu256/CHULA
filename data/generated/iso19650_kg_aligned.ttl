iso:rel_802 a rdf:Statement ;
    iso:provenanceClause "4.2.6" ;
    iso:provenanceStandard "ISO 19650-6" ;
    iso:relationshipNote "All incidents shall be recorded, INCLUDING near miss events." ;
    rdf:object iso:term_hs_incident ;
    rdf:predicate iso:SUBTYPE_OF ;
    rdf:subject iso:term_near_miss .

iso:rel_803 a rdf:Statement ;
    iso:provenanceClause "4.3.3; 4.3.4; Introduction" ;
    iso:provenanceStandard "ISO 19650-6" ;
    iso:relationshipNote "PdM HOOK: the two schemas of Table 2 and Table 3 are almost mirror images in their fields, which allows an incident that HAS OCCURRED to be matched against a risk REGISTERED BEFOREHAND on the same product/activity/location triple. Introduction: health and safety information becomes meaningful only when interpreted in the light of the history of events and accidents associated with that risk. This is a prediction-accuracy measurement supplied at schema level." ;
    rdf:object iso:term_hs_risk ;
    rdf:predicate iso:CORRESPONDS_TO ;
    rdf:subject iso:term_hs_incident .

iso:rel_804 a rdf:Statement ;
    iso:provenanceClause "4.2.1; 4.3.1" ;
    iso:provenanceStandard "ISO 19650-6" ;
    iso:relationshipNote "The appointing party shall adopt the common method for structuring health and safety information, defined in 4.3 to 4.5." ;
    rdf:object iso:term_health_safety_information ;
    rdf:predicate iso:DESCRIBES ;
    rdf:subject iso:term_hs_schema .


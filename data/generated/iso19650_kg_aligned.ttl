iso:term_logistical_security a iso:Concept,
        iso:IsoNode ;
    rdfs:label "logistical security" ;
    iso:APPLIES_TO iso:term_asset ;
    iso:PART_OF iso:term_security_management_plan ;
    iso:PRECEDES iso:term_security_breach_incident_management_plan ;
    iso:RESPONDS_TO iso:term_counterfeit_component_risk,
        iso:term_hostile_reconnaissance ;
    iso:definition "appropriate and proportionate security measures set out in the security management plan, where applicable, around the specification, procurement, design, manufacture, transport, installation and commissioning of any sensitive assets; the organization(s) shall consider a) the timing of the installation of any sensitive security-related assets or systems to allow, where possible, access to those assets or areas to be limited to those with a legitimate need, b) implementing appropriate and proportionate security measures around any sensitive assets and systems which, for logistical reasons, have to be installed earlier than would generally be desirable, and c) implementing appropriate and proportionate measures to limit, or disrupt the success of, physical hostile reconnaissance" ;
    iso:nodeId "term_logistical_security" ;
    iso:part "ISO 19650-5" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceClause "7.3" ;
    iso:provenanceStandard "ISO 19650-5" ;
    iso:sourceType "body_clause" .


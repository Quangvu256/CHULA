    iso:PART_OF iso:term_technological_security_control ;
    iso:SUPPORTS iso:term_pdm_model ;
    iso:definition "the ability of information, services and systems to transform, renew and recover in a timely way in response to adverse events" ;
    iso:nodeId "term_resilience" ;

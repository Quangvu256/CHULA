iso:term_sensitivity_assessment a iso:Concept,
        iso:IsoNode ;
    rdfs:label "sensitivity assessment process" ;
    iso:DESCRIBES iso:term_sensitive_information ;
    iso:PRECEDES iso:term_security_triage ;
    iso:RESPONDS_TO iso:term_security_risk ;
    iso:definition "process by which the organization(s) determines whether an initiative, project, asset, product or service, as well as any associated information, in whole or in part and whether planned or existing, shall be considered sensitive; comprises understanding the range of security risks arising through greater availability of information, integration of services and systems and increased dependency on technology-based systems (4.2), identifying organizational sensitivities (4.3), and establishing any third-party sensitivities (4.4)" ;
    iso:nodeId "term_sensitivity_assessment" ;
    iso:part "ISO 19650-5" ;
    iso:pdmRelevance "high" ;
    iso:provenanceClause "4.1; 4.2; 4.3; 4.4; 4.5; 4.6" ;
    iso:provenanceStandard "ISO 19650-5" ;
    iso:sourceType "body_clause" .


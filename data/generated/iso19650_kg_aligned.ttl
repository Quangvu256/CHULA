iso:term_information_redaction a iso:Concept,
        iso:IsoNode ;
    rdfs:label "redaction and protective formatting" ;
    iso:APPLIES_TO iso:term_information_model ;
    iso:PART_OF iso:term_third_party_information_provision_assessment ;
    iso:definition "measures by which sensitive information is suitably separated and protected when information is supplied or exchanged with third parties in order to comply with regulatory and statutory processes; may include redaction or removal of sensitive information regarding sensitive features, specific uses of areas within a built asset and uses of protective measures, and may also include providing unstructured information in formats such as hard copy, images or non-interactive PDF formats rather than giving access to, for example, interactive information models" ;
    iso:nodeId "term_information_redaction" ;
    iso:part "ISO 19650-5" ;
    iso:pdmRelevance "high" ;
    iso:provenanceClause "C.2.2; C.2.3" ;
    iso:provenanceStandard "ISO 19650-5" ;
    iso:sourceType "informative_annex" .

iso:term_information_security_control a iso:Concept,
        iso:IsoNode ;
    rdfs:label "information security control" ;
    iso:APPLIES_TO iso:term_aim,
        iso:term_lifecycle_synthesis,
        iso:term_pdm_model ;
    iso:PART_OF iso:term_security_risk_mitigation_measure ;
    iso:definition "policies and processes relating to information security which should consider including: the requirements for conducting inspections and surveys that can gather sensitive information not otherwise publicly available; the management and monitoring of the secure storage of, secure access to, and ultimately secure disposal and destruction of information, including information retained for a period to comply with legal or other regulatory requirements and with any specific requirements of the organization(s), whichever is longer; the maximum amount of information relating to sensitive assets/products or systems to be contained in databases, information exchanges and, where applicable, information models; the embedding of any requirements relating to special handling or protection of information which has security sensitivity and has been provided to the organization(s) by a third party; protection against the loss, disclosure, corruption of, or loss of access or unauthorized changes to information, metadata and referential master data; and monitoring and recording changes to processes and technologies used for information capture, processing including information synthesis, and storage" ;
    iso:nodeId "term_information_security_control" ;
    iso:part "ISO 19650-5" ;
    iso:pdmRelevance "high" ;
    iso:provenanceClause "B.4.1" ;
    iso:provenanceStandard "ISO 19650-5" ;
    iso:sourceType "informative_annex" .


    iso:relationshipNote "Hazard = source of potential harm; the scope of risk management covers 'the risks AND HAZARDS' per 4.2.2." ;
    rdf:object iso:term_hs_risk ;
    rdf:predicate iso:RESULTS_IN ;
    rdf:subject iso:term_hazard .


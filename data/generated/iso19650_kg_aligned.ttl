iso:term_context_sub_schema a iso:Concept,
        iso:IsoNode ;
    rdfs:label "context sub-schema" ;
    iso:DESCRIBES iso:term_hs_context ;
    iso:LINKED_TO iso:term_information_delivery_milestone ;
    iso:PART_OF iso:term_hs_schema ;
    iso:definition "property fields for describing context so that any risks and incidents can be assessed appropriately (Table 1): Identifier (text, unique context identifier); Category (enumeration, classification of the asset); Description (text, detailed description and narrative of the asset); Associated product (text or identifier, facility or system - only systems that are exceptional given the overall context need to be recorded); Associated activity (text or identifier, asset life cycle stage or work package - only exceptional work packages need recording); Associated location (text or identifier, site or zone - only exceptional zones need recording); Contextual location (coordinates, optional, cartesian, geo-spatial or alignment based); Context link (text or link to main context); Context linkage (inverse links to sub-contexts, optional depending on implementation); Risk linkage (inverse linkage to risks, optional); Incident linkage (inverse linkage to incidents, optional); History (varies, record of dates and actions including creation and updates - entries shall not be deleted)" ;
    iso:nodeId "term_context_sub_schema" ;
    iso:part "ISO 19650-6" ;
    iso:pdmRelevance "high" ;
    iso:provenanceClause "4.3.2; Table 1" ;
    iso:provenanceStandard "ISO 19650-6" ;
    iso:sourceType "body_clause" .


iso:term_iot_security_assessment a iso:Concept,
        iso:IsoNode ;
    rdfs:label "internet of things security assessment" ;
    iso:APPLIES_TO iso:term_condition_monitoring_system,
        iso:term_cyber_physical_system,
        iso:term_scada_system ;
    iso:PART_OF iso:term_technological_security_control ;
    iso:RESPONDS_TO iso:term_risk_appetite ;
    iso:definition "assessment that the organization(s) should undertake prior to the implementation of any system based on the internet of things or other distributed technologies, comprising: a) understanding the security architecture of the proposed technologies; b) determining the extent to which that architecture meets the security requirements of the organization(s); c) assessing any security risks, including the potential impact of a failure of the technology, against the risk appetite of the organization(s) and the benefits which it is anticipated can be gained; and d) putting in place appropriate and proportionate security risk mitigation measures to manage any unacceptable security risks" ;
    iso:nodeId "term_iot_security_assessment" ;
    iso:part "ISO 19650-5" ;
    iso:pdmRelevance "high" ;
    iso:provenanceClause "B.3.4" ;
    iso:provenanceStandard "ISO 19650-5" ;
    iso:sourceType "informative_annex" .


    iso:provenanceStandard "ISO 19650-3" ;
    iso:relationshipNote "Includes processes to improve information quality to support organizational objectives and to verify information against AIR." ;
    rdf:object iso:term_information_quality ;
    rdf:predicate iso:SUPPORTS ;
    rdf:subject iso:term_aim_maintenance_process .

iso:rel_331 a rdf:Statement ;

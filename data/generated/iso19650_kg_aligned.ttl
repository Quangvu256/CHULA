iso:term_spatial_coordination_issue a iso:Concept,
        iso:IsoNode ;
    rdfs:label "spatial coordination issue (clash)" ;
    iso:APPLIES_TO iso:term_information_model,
        iso:term_space ;
    iso:definition "issues in the information model should be avoided during production of information rather than detected after delivery; issues can be spatial (e.g. structural elements and building services occupying the same space) or functional (e.g. fire protection materials incompatible with the required fire rating of a wall); spatial coordination issues can be 'hard' (two objects occupying the same space), 'soft' (one item occupies the operating or maintenance space of another item) or 'time' (two objects present in the same place at the same time)" ;
    iso:nodeId "term_spatial_coordination_issue" ;
    iso:part "ISO 19650-1" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceClause "11.1" ;
    iso:provenanceStandard "ISO 19650-1" ;
    iso:sourceType "body_clause" .


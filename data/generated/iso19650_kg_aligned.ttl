    iso:PART_OF iso:term_information_exchange_process ;
    iso:RESPONDS_TO iso:term_exchange_review_criteria ;
    iso:RESULTS_IN iso:state_published,
        iso:term_change_action_process ;
    iso:definition "review by the information receiver of an information container using the criteria in Clause 7, either rejecting or authorizing and accepting it for the published state (ISO 19650-1:2018, 12.5, ISO 19650-2:2018, 5.7.2 and ISO 19650-3:2020, 5.6.6); can be carried out in two steps, authorization by the lead appointed party then acceptance by the appointing party (ISO 19650-2:2018, 5.7.4 and ISO 19650-3:2020, 5.7.2); the reviewers shall consider the effectiveness of quality control and assurance processes applied by the provider before sharing and quality control processes applied by reviewers after sharing" ;
    iso:nodeId "decision_b_authorize_accept_publication" ;
    iso:part "ISO 19650-4" ;
    iso:pdmRelevance "high" ;
    iso:provenanceClause "6.2; Figure 1 (B)" ;
    iso:provenanceStandard "ISO 19650-4" ;

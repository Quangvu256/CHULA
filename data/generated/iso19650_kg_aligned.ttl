iso:rel_813 a rdf:Statement ;
    iso:provenanceClause "4.3.1; 4.3.7" ;
    iso:provenanceStandard "ISO 19650-6" ;
    iso:relationshipNote "Health and safety context, risks, incidents and treatments shall be described using the sub-schemas of 4.3.2-4.3.5 OR as identified in the project/asset information standard - so the project information standard (ISO 19650-2, 5.1.4) is entitled to replace the default schema." ;
    rdf:object iso:term_project_information_standard ;
    rdf:predicate iso:SPECIFIED_IN ;
    rdf:subject iso:term_hs_schema .

iso:rel_814 a rdf:Statement ;
    iso:provenanceClause "4.3.1; 4.3.7" ;
    iso:provenanceStandard "ISO 19650-6" ;
    iso:relationshipNote "The asset-side branch of the same requirement: the asset information standard (ISO 19650-3, 5.1.6) is likewise entitled to define a substitute schema." ;
    rdf:object iso:term_asset_information_standard ;
    rdf:predicate iso:SPECIFIED_IN ;
    rdf:subject iso:term_hs_schema .

iso:rel_815 a rdf:Statement ;
    iso:provenanceClause "4.3.1" ;
    iso:provenanceStandard "ISO 19650-6" ;
    iso:relationshipNote "BRIDGE TO PART 5. 4.3.1 (normative): there shall be consideration of the implementation requirements needed to ensure that the health and safety information provided meets the necessary INTEGRITY, AVAILABILITY and CONFIDENTIALITY requirements - three of the eight aspects of ISO 19650-5, B.3.3." ;
    rdf:object iso:term_integrity ;
    rdf:predicate iso:RESPONDS_TO ;
    rdf:subject iso:term_hs_schema .

iso:rel_816 a rdf:Statement ;
    iso:provenanceClause "4.3.1" ;
    iso:provenanceStandard "ISO 19650-6" ;
    iso:relationshipNote "BRIDGE TO PART 5; see the note on the relationship term_hs_schema RESPONDS_TO term_integrity." ;
    rdf:object iso:term_availability ;
    rdf:predicate iso:RESPONDS_TO ;
    rdf:subject iso:term_hs_schema .

iso:rel_817 a rdf:Statement ;
    iso:provenanceClause "4.3.1" ;
    iso:provenanceStandard "ISO 19650-6" ;
    iso:relationshipNote "BRIDGE TO PART 5; see the note on the relationship term_hs_schema RESPONDS_TO term_integrity." ;
    rdf:object iso:term_confidentiality ;
    rdf:predicate iso:RESPONDS_TO ;
    rdf:subject iso:term_hs_schema .

iso:rel_818 a rdf:Statement ;
    iso:provenanceClause "4.4" ;
    iso:provenanceStandard "ISO 19650-6" ;
    iso:relationshipNote "Risk, risk treatment, context and incident identifiers shall be UNIQUE to the project or asset." ;
    rdf:object iso:term_hs_schema ;
    rdf:predicate iso:PART_OF ;
    rdf:subject iso:term_hs_identifier .


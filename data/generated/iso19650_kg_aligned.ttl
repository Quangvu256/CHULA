iso:rel_660 a rdf:Statement ;
    iso:provenanceClause "9.1.4; 9.1.5" ;
    iso:provenanceStandard "ISO 19650-5" ;
    iso:relationshipNote "9.1.4: as part of the appointed party selection process, all tender documentation shall be assessed to establish how the security requirements set out in the security management plan are intended to be met. 9.1.5: the security understanding, capability, competence and experience of the organizations being considered for an appointment shall be assessed, along with any security training, coaching and support requirements." ;
    rdf:object iso:term_security_minded_approach ;
    rdf:predicate iso:APPLIES_TO ;
    rdf:subject iso:term_capability_capacity_review .

iso:rel_661 a rdf:Statement ;

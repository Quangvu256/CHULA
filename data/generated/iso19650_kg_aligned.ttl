iso:criterion_completeness a iso:Concept,
        iso:IsoNode ;
    rdfs:label "review criterion - completeness" ;
    iso:PART_OF iso:term_exchange_review_criteria ;
    iso:RESPONDS_TO iso:term_eir,
        iso:term_level_of_information_need ;
    iso:SUPPORTS iso:term_information_quality ;
    iso:definition "check for the presence and adequacy of the information against the level of information need specified by the EIR and any additional expectations; the reviewer shall consider three requirements: to satisfy the purposes associated to the immediate delivery stage or operational trigger event; to support oversight and coordination of the delivery or operational phase; and to enable long-term management and societal requirements, using standard naming and classification and open standards; the reviewer shall consider using a formalized procedure when checking against the information requirements or checklists derived from them, possibly including structured rules using REPEATABLE AUTOMATED PROCESSES, and means of sharing checking procedures with information providers through the information production methods and procedures" ;
    iso:nodeId "criterion_completeness" ;
    iso:part "ISO 19650-4" ;
    iso:pdmRelevance "high" ;
    iso:provenanceClause "7.6" ;
    iso:provenanceStandard "ISO 19650-4" ;
    iso:sourceType "body_clause" .

iso:criterion_consistency a iso:Concept,
        iso:IsoNode ;
    rdfs:label "review criterion - consistency" ;
    iso:LINKED_TO iso:term_federation ;
    iso:PART_OF iso:term_exchange_review_criteria ;
    iso:RESPONDS_TO iso:term_spatial_coordination_issue,
        iso:term_status_code ;
    iso:definition "check for the internal consistency with any referenced information containers in terms of: spatial, physical and process consistency including the absence of duplication and conflicts such as overlaps or gaps; attribute and property consistency such as contradictions; gaps, overlaps or incorrect allocation with adjacent information containers within the federation strategy; and appropriate accuracy, including quantitative accuracy of locational and property values and thematic accuracy of classification and text properties; the reviewer shall also consider the intended status code prior to the shared state or the assigned status code prior to the published state (ISO 19650-1:2018, 3.3.12 and 12.1)" ;
    iso:nodeId "criterion_consistency" ;
    iso:part "ISO 19650-4" ;
    iso:pdmRelevance "high" ;
    iso:provenanceClause "7.5" ;
    iso:provenanceStandard "ISO 19650-4" ;
    iso:sourceType "body_clause" .


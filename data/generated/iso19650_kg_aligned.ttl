iso:term_information_verification_validation a iso:Concept,
        iso:IsoNode ;
    rdfs:label "information verification and validation" ;
    iso:APPLIES_TO iso:activity_collaborative_production_of_information_delivery,
        iso:activity_information_model_delivery,
        iso:term_information_exchange ;
    iso:definition "checking of information at the start and end of project stages during information exchange: delivery of information by the lead appointed party checked by the appointing party against the requirements, and provision of information from the appointing party checked against what is needed to start the next stage, with iteration to complete the exchange; approval and acceptance procedures should be agreed and documented before any information exchange takes place; a second information check to start a stage is particularly important where the appointed party changes between stages (with attention to usability of the information received) or where there is a delay before the next stage; verification of designers' intentions should also take place through review of asset performance during the operational phase, with remedial works where verification fails" ;
    iso:nodeId "term_information_verification_validation" ;
    iso:part "ISO 19650-1" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceClause "6.3.3; 6.2" ;
    iso:provenanceStandard "ISO 19650-1" ;
    iso:sourceType "body_clause" .


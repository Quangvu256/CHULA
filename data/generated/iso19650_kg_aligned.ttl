    iso:RESPONDS_TO iso:term_security_minded_approach ;
    iso:definition "methods and procedures for producing asset information, considering: capture of existing asset information; generation, review or approval of new information; security of information; and delivery of information to the appointing party in a format compatible with the systems and processes it already operates" ;
    iso:nodeId "term_asset_information_production_methods_procedures" ;
    iso:part "ISO 19650-3" ;
    iso:pdmRelevance "high" ;
    iso:provenanceClause "5.1.7" ;

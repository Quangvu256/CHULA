iso:term_aim_maintenance_process a iso:Concept,
        iso:IsoNode ;
    rdfs:label "processes to maintain the AIM" ;
    iso:APPLIES_TO iso:term_aim ;
    iso:RESPONDS_TO iso:term_security_minded_approach ;
    iso:SUPPORTS iso:term_information_quality ;
    iso:definition "processes to maintain the AIM for as long as appropriate, including: task allocation for production/maintenance/retention/transmission/access/assurance/archiving; transfer of AIM maintenance requirements or ownership on change of owner or appointing party; version control, integrity checking and verification against AIR; information quality improvement; archiving or disposal of obsolete/unreliable/unwanted information; security compliance per ISO 19650-5; safe and retrievable storage with preventative maintenance against physical/technological deterioration or obsolescence; and maintaining the agreed level of alignment between AIM contents and the state of the physical asset" ;
    iso:nodeId "term_aim_maintenance_process" ;
    iso:part "ISO 19650-3" ;
    iso:pdmRelevance "high" ;
    iso:provenanceClause "5.1.12" ;
    iso:provenanceStandard "ISO 19650-3" ;
    iso:sourceType "body_clause" .


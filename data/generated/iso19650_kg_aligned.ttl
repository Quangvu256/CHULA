iso:function_security_management a iso:Function,
        iso:IsoNode ;
    rdfs:label "security management function" ;
    iso:PRECEDES iso:term_security_minded_approach ;
    iso:RESPONSIBLE_FOR iso:term_security_management_plan,
        iso:term_security_strategy ;
    iso:definition "function fulfilled by the individual(s) defined by the organization(s) as responsible for: providing a holistic view of the security threats and vulnerabilities arising out of the use of, and reliance on, information and communications technologies; offering guidance and direction on the handling of the resultant security risks; managing the development of a security strategy (or embedding the additional risks and mitigation measures into an existing one); managing the development and assisting the implementation of a security management plan (or embedding the relevant additional policies and processes into an existing one); assisting in embedding the necessary security requirements into procurement and appointment documentation; promoting a security-minded culture; briefing relevant third parties on appropriate aspects of the security policies and processes; advising on and undertaking review and audit of the relevant security policies and processes; advising on and undertaking or commissioning testing of the relevant security measures; and seeking advice from appropriate security experts where necessary" ;
    iso:nodeId "function_security_management" ;
    iso:part "ISO 19650-5" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceClause "5.1.3; 5.1.4; 5.1.5; 7.4" ;
    iso:provenanceStandard "ISO 19650-5" ;
    iso:sourceType "body_clause" .


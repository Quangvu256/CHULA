    rdf:predicate iso:PRECEDES ;
    rdf:subject iso:stage_repurposing .

iso:rel_843 a rdf:Statement ;
    iso:provenanceClause "4.3.3; Table 2" ;
    iso:provenanceStandard "ISO 19650-6" ;
    iso:relationshipNote "INTERPRETIVE: the five values Inception, Briefing, Design, Production and Handover fall within the delivery phase of ISO 19650-1 (3.2.11: the part of the life cycle during which an asset is designed, constructed and commissioned); the note to Table 2 confirms that Handover already includes commissioning and testing." ;
    rdf:object iso:term_delivery_phase ;
    rdf:predicate iso:STAGE_OF ;
    rdf:subject iso:stage_inception .

iso:rel_844 a rdf:Statement ;
    iso:provenanceClause "4.3.3; Table 2" ;
    iso:provenanceStandard "ISO 19650-6" ;
    iso:relationshipNote "INTERPRETIVE; see the note on stage_inception STAGE_OF term_delivery_phase." ;
    rdf:object iso:term_delivery_phase ;
    rdf:predicate iso:STAGE_OF ;
    rdf:subject iso:stage_briefing .

iso:rel_845 a rdf:Statement ;
    iso:provenanceClause "4.3.3; Table 2" ;
    iso:provenanceStandard "ISO 19650-6" ;
    iso:relationshipNote "INTERPRETIVE; see the note on stage_inception STAGE_OF term_delivery_phase." ;
    rdf:object iso:term_delivery_phase ;
    rdf:predicate iso:STAGE_OF ;
    rdf:subject iso:stage_design .

iso:rel_846 a rdf:Statement ;
    iso:provenanceClause "4.3.3; Table 2" ;
    iso:provenanceStandard "ISO 19650-6" ;
    iso:relationshipNote "INTERPRETIVE; see the note on stage_inception STAGE_OF term_delivery_phase." ;
    rdf:object iso:term_delivery_phase ;
    rdf:predicate iso:STAGE_OF ;
    rdf:subject iso:stage_production .

iso:rel_847 a rdf:Statement ;
    iso:provenanceClause "4.3.3; Table 2" ;
    iso:provenanceStandard "ISO 19650-6" ;
    iso:relationshipNote "INTERPRETIVE. Note to Table 2: handover already includes commissioning and testing - it is the last value still belonging to the delivery phase." ;
    rdf:object iso:term_delivery_phase ;
    rdf:predicate iso:STAGE_OF ;
    rdf:subject iso:stage_handover .

iso:rel_848 a rdf:Statement ;
    iso:provenanceClause "4.3.3; Table 2" ;
    iso:provenanceStandard "ISO 19650-6" ;
    iso:relationshipNote "The note to Table 2 states explicitly that operation was ADDED to the ISO 22263 basis as a NON-PROJECT, IN-USE stage - corresponding directly to term_operational_phase of ISO 19650-1, 3.2.12." ;
    rdf:object iso:term_operational_phase ;
    rdf:predicate iso:STAGE_OF ;
    rdf:subject iso:stage_operation .

iso:rel_849 a rdf:Statement ;
    iso:provenanceClause "4.3.3; Table 2" ;
    iso:provenanceStandard "ISO 19650-6" ;
    iso:relationshipNote "INTERPRETIVE: repurposing was likewise added to the ISO 22263 basis; compare trigger_major_works of ISO 19650-3, A.3 (major works on an existing asset such as major repairs, refurbishments or major upgrades)." ;
    rdf:object iso:term_operational_phase ;
    rdf:predicate iso:STAGE_OF ;
    rdf:subject iso:stage_repurposing .


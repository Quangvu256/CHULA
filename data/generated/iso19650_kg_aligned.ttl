    iso:provenanceStandard "ISO 19650-3" ;
    iso:relationshipNote "Preparing EIR in advance of the trigger event means appointment of lead appointed party is not delayed - important for trigger events likely to require an emergency response, such as foreseeable breakdowns of critical equipment." ;
    rdf:object iso:term_foreseen_trigger_event ;

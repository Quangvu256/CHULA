    iso:RESULTS_IN iso:term_security_minded_approach ;
    iso:definition "triage outcome where the initiative, project, asset, product or service is itself sensitive but no sensitive third-party information is held: protect sensitive information regarding the initiative, project, asset, product or service by applying Clause 5 to Clause 9" ;
    iso:nodeId "term_triage_outcome_st2" ;
    iso:part "ISO 19650-5" ;
    iso:pdmRelevance "high" ;
    iso:provenanceClause "4.7; Figure 3" ;
    iso:provenanceStandard "ISO 19650-5" ;
    iso:sourceType "body_clause" .


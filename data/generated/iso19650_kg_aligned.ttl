        iso:IsoNode ;
    rdfs:label "decision A - approve for sharing" ;
    iso:CORRESPONDS_TO iso:term_quality_assurance_check ;
    iso:PART_OF iso:term_information_exchange_process ;
    iso:RESPONDS_TO iso:term_exchange_review_criteria ;
    iso:RESULTS_IN iso:state_shared,
        iso:term_change_action_process ;
    iso:definition "review by the information provider of their information using the criteria in Clause 7, prior to either withholding or granting approval for the information to transition to the shared state (ISO 19650-1:2018, 12.3, ISO 19650-2:2018, 5.6.3 and ISO 19650-3:2020, 5.6.3); outcomes per Figure 1: approve (a1), change action (a0), or omission from the shared state under the 6.4 controls (a2); the provider shall consider the effectiveness of quality assurance processes by the provider and quality control processes by the provider and receivers" ;
    iso:nodeId "decision_a_approve_sharing" ;
    iso:part "ISO 19650-4" ;
    iso:pdmRelevance "high" ;

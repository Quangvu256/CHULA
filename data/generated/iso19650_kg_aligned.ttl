    iso:provenanceStandard "ISO 19650-6" ;
    rdf:object iso:term_asset ;
    rdf:predicate iso:APPLIES_TO ;
    rdf:subject iso:term_hs_categorization .

iso:rel_823 a rdf:Statement ;
    iso:provenanceClause "4.2.4" ;
    iso:provenanceStandard "ISO 19650-6" ;
    iso:relationshipNote "All known or perceived health and safety risks shall be documented; risks shall be prioritized to identify those needing further scrutiny to ensure the correct risk treatment is proposed." ;
    rdf:object iso:term_hs_risk ;
    rdf:predicate iso:APPLIES_TO ;
    rdf:subject iso:term_hs_risk_prioritization .

iso:rel_824 a rdf:Statement ;
    iso:provenanceClause "4.2.4 a); 4.2.4 b)" ;
    iso:provenanceStandard "ISO 19650-6" ;
    iso:relationshipNote "Prioritization shall be assessed TWICE: before consideration of the opportunities for risk treatment, AND after agreement on the treatment. IFC4.3 encodes this before/after pair as Unmitigated*/Mitigated* (Annex D)." ;
    rdf:object iso:term_risk_treatment ;
    rdf:predicate iso:PRECEDES ;
    rdf:subject iso:term_hs_risk_prioritization .

iso:rel_825 a rdf:Statement ;
    iso:provenanceClause "3.5; 4.3.8" ;
    iso:provenanceStandard "ISO 19650-6" ;
    iso:relationshipNote "The outcome of an assessment of a health and safety risk using any appropriate method shall be communicated. NOTE 2 to 4.3.8: ISO 45001 requires that assessment be 'systematic and PROACTIVE'." ;
    rdf:object iso:term_hs_risk_prioritization ;
    rdf:predicate iso:SPECIFIED_IN ;
    rdf:subject iso:term_level_of_risk .

iso:rel_826 a rdf:Statement ;
    iso:provenanceClause "4.3.3; Table 2" ;
    iso:provenanceStandard "ISO 19650-6" ;
    iso:relationshipNote "The Level of risk field appears in both the risk and the incident schemas, but NOT in the context or treatment schemas (Table A.1)." ;
    rdf:object iso:term_hs_risk ;
    rdf:predicate iso:DESCRIBES ;
    rdf:subject iso:term_level_of_risk .

iso:rel_827 a rdf:Statement ;
    iso:provenanceClause "4.3.4; Table 3" ;
    iso:provenanceStandard "ISO 19650-6" ;
    rdf:object iso:term_hs_incident ;
    rdf:predicate iso:DESCRIBES ;
    rdf:subject iso:term_level_of_risk .


iso:term_ifc_representation a iso:Concept,
        iso:IsoNode ;
    rdfs:label "IFC representation of health and safety information" ;
    iso:ENABLES iso:term_hs_risk_prioritization ;
    iso:SPECIFIED_IN iso:term_hs_schema ;
    iso:definition "mapping of the 4.3 schema to ISO 16739-1 IFC4.3, IFC4.0 and IFC2x3 (Table D.1): Context maps to IfcProject, with location as IfcSite/IfcZone, product as IfcFacility/IfcSystem and activity as IfcProject/IfcWorkPlan; Risk, Incident and Treatment map to Pset_Risk and IfcAnnotation, with location as IfcSpaceType/IfcSpace, product as IfcElementType/IfcElement and activity as IfcTaskType/IfcTask; Party maps to IfcActor and IfcActorRole; context is represented by the higher-level objects, and treatments can be represented by changes to the specifications of the associated locations, products and activities associated to the risks and incidents; Pset_Risk can be associated to locations, products and/or tasks, or to a separate annotation such as a 2D or 3D symbol compliant to ISO 7010" ;
    iso:nodeId "term_ifc_representation" ;
    iso:part "ISO 19650-6" ;
    iso:pdmRelevance "high" ;
    iso:provenanceClause "Annex D; Table D.1; Table D.2" ;

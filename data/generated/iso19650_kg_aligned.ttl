iso:criterion_cde a iso:Concept,
        iso:IsoNode ;
    rdfs:label "review criterion - common data environment (CDE)" ;
    iso:APPLIES_TO iso:term_cde,
        iso:term_information_container ;
    iso:PART_OF iso:term_exchange_review_criteria ;
    iso:RESPONDS_TO iso:term_security_information_requirements ;
    iso:definition "check that the naming and metadata requirements of the CDE are correctly applied to the information container; that the metadata describes the information necessary to support the required workflow and the information within the container; and that security and handling requirements have not been breached, especially relating to the visibility of the information container to others" ;
    iso:nodeId "criterion_cde" ;
    iso:part "ISO 19650-4" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceClause "7.1" ;
    iso:provenanceStandard "ISO 19650-4" ;

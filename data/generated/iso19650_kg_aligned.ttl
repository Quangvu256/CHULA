    iso:provenanceClause "9.3; 9.4" ;
    iso:provenanceStandard "ISO 19650-5" ;
    rdf:object iso:term_end_of_appointment_information_handling ;
    rdf:predicate iso:PRECEDES ;
    rdf:subject iso:term_post_appointment_security_assurance .

iso:rel_689 a rdf:Statement ;
    iso:provenanceClause "9.2.1; 9.4" ;
    iso:provenanceStandard "ISO 19650-5" ;
    rdf:object iso:term_security_management_plan ;
    rdf:predicate iso:PART_OF ;
    rdf:subject iso:term_end_of_appointment_information_handling .

iso:rel_69 a rdf:Statement ;
    iso:provenanceClause "7.2" ;
    iso:provenanceStandard "ISO 19650-1" ;
    iso:relationshipNote "leadership in validating information supplied from each appointed party and authorizing it for inclusion in the AIM" ;
    rdf:object iso:term_aim ;
    rdf:predicate iso:RESPONSIBLE_FOR ;
    rdf:subject iso:function_asset_information_management .

iso:rel_690 a rdf:Statement ;
    iso:provenanceClause "9.2.10" ;
    iso:provenanceStandard "ISO 19650-5" ;
    iso:relationshipNote "PdM HOOK: 9.2.10 is the only normative requirement in ISO 19650-5 that names ASSET INFORMATION directly - sufficient decommissioning and demobilization processes shall be put in place TO MAINTAIN THE SECURITY OF ASSET INFORMATION. Data continuity risk: when a maintenance contractor leaves, the condition and failure history that constitutes the training set of the prediction model can be destroyed with it. Compare ISO 19650-3, 5.1.12 (transfer of AIM maintenance requirements or ownership on change of owner or appointing party)." ;
    rdf:object iso:term_aim ;
    rdf:predicate iso:APPLIES_TO ;
    rdf:subject iso:term_end_of_appointment_information_handling .

iso:rel_691 a rdf:Statement ;
    iso:provenanceClause "9.2.8; 9.2.9; 9.4" ;
    iso:provenanceStandard "ISO 19650-5" ;
    iso:relationshipNote "9.2.9: where appropriate, the appointed party shall be required to VERIFY that the defined procedures for the delivery, disposal or destruction of sensitive information have been completed, and to verify the ongoing security arrangements for sensitive information that is to be retained." ;
    rdf:object iso:term_appointed_party ;
    rdf:predicate iso:APPLIES_TO ;
    rdf:subject iso:term_end_of_appointment_information_handling .

iso:rel_692 a rdf:Statement ;
    iso:provenanceClause "9.2.8; D.1.3 b)" ;
    iso:provenanceStandard "ISO 19650-5" ;
    rdf:object iso:term_lifecycle_purging ;
    rdf:predicate iso:RESULTS_IN ;
    rdf:subject iso:term_end_of_appointment_information_handling .

iso:rel_693 a rdf:Statement ;
    iso:provenanceClause "6.3.2; B.1" ;
    iso:provenanceStandard "ISO 19650-5" ;
    iso:relationshipNote "6.3.2 (normative): in identifying and recording possible mitigation measures, the organization shall consider personnel, physical and technical security controls and requirements around the management of information. Annex B is the informative elaboration of those four groups." ;
    rdf:object iso:term_security_risk_mitigation_measure ;
    rdf:predicate iso:PART_OF ;
    rdf:subject iso:term_personnel_security_control .

iso:rel_694 a rdf:Statement ;
    iso:provenanceClause "6.3.2; B.2" ;
    iso:provenanceStandard "ISO 19650-5" ;
    rdf:object iso:term_security_risk_mitigation_measure ;
    rdf:predicate iso:PART_OF ;
    rdf:subject iso:term_physical_security_control .

iso:rel_695 a rdf:Statement ;
    iso:provenanceClause "6.3.2; B.3" ;
    iso:provenanceStandard "ISO 19650-5" ;
    rdf:object iso:term_security_risk_mitigation_measure ;
    rdf:predicate iso:PART_OF ;
    rdf:subject iso:term_technological_security_control .

iso:rel_696 a rdf:Statement ;
    iso:provenanceClause "6.3.2; B.4" ;
    iso:provenanceStandard "ISO 19650-5" ;
    rdf:object iso:term_security_risk_mitigation_measure ;
    rdf:predicate iso:PART_OF ;
    rdf:subject iso:term_information_security_control .

iso:rel_697 a rdf:Statement ;
    iso:provenanceClause "B.1" ;
    iso:provenanceStandard "ISO 19650-5" ;
    iso:relationshipNote "Informative (Annex B). Security screening and vetting for any individual in contact with sensitive assets including information, security competence requirements by role, and access and permission requirements to information and information models." ;
    rdf:object iso:term_task_team ;
    rdf:predicate iso:APPLIES_TO ;
    rdf:subject iso:term_personnel_security_control .

iso:rel_698 a rdf:Statement ;
    iso:provenanceClause "B.3.2" ;
    iso:provenanceStandard "ISO 19650-5" ;
    rdf:object iso:term_technological_security_control ;
    rdf:predicate iso:PART_OF ;
    rdf:subject iso:term_secure_by_default .

iso:rel_699 a rdf:Statement ;
    iso:provenanceClause "B.3.4" ;
    iso:provenanceStandard "ISO 19650-5" ;
    rdf:object iso:term_technological_security_control ;
    rdf:predicate iso:PART_OF ;
    rdf:subject iso:term_iot_security_assessment .

iso:rel_7 a rdf:Statement ;
    iso:provenanceClause "5.5; Figure 2" ;
    iso:provenanceStandard "ISO 19650-1" ;
    iso:relationshipNote "technical aspects of the EIR specify the detailed pieces of information needed to answer the PIR" ;
    rdf:object iso:term_pir ;
    rdf:predicate iso:DERIVED_FROM ;
    rdf:subject iso:term_eir .

iso:rel_70 a rdf:Statement ;
    iso:provenanceClause "7.2" ;
    iso:provenanceStandard "ISO 19650-1" ;
    iso:relationshipNote "asset information management should be involved in all stages of project delivery, because handover information should include what is required for operation and maintenance of the asset" ;
    rdf:object iso:term_delivery_phase ;
    rdf:predicate iso:APPLIES_TO ;
    rdf:subject iso:function_asset_information_management .

iso:rel_700 a rdf:Statement ;
    iso:provenanceClause "B.3.4; Introduction" ;
    iso:provenanceStandard "ISO 19650-5" ;
    iso:relationshipNote "Informative Annex B.3.4 recommends this assessment before implementation of an internet-of-things or distributed-technology system, including a condition-monitoring sensor network." ;
    rdf:object iso:term_cyber_physical_system ;
    rdf:predicate iso:APPLIES_TO ;
    rdf:subject iso:term_iot_security_assessment .

iso:rel_701 a rdf:Statement ;
    iso:provenanceClause "B.3.4 c)" ;
    iso:provenanceStandard "ISO 19650-5" ;
    iso:relationshipNote "Informative Annex B.3.4 recommends assessing technology-failure impact and other IoT risks against organizational risk appetite and anticipated benefits. It is a useful design check for a PdM business case, not a normative approval gate." ;
    rdf:object iso:term_risk_appetite ;
    rdf:predicate iso:RESPONDS_TO ;
    rdf:subject iso:term_iot_security_assessment .

iso:rel_702 a rdf:Statement ;
    iso:provenanceClause "B.3.3 a)" ;
    iso:provenanceStandard "ISO 19650-5" ;
    iso:relationshipNote "Informative (Annex B). One of eight aspects (with availability, safety, resilience, possession, authenticity, utility and integrity) against which software used to capture, process or store sensitive information is assessed during selection, at a level appropriate and proportionate to the sensitivity of that information." ;
    rdf:object iso:term_technological_security_control ;
    rdf:predicate iso:PART_OF ;
    rdf:subject iso:term_confidentiality .

iso:rel_703 a rdf:Statement ;
    iso:provenanceClause "B.3.3 b)" ;
    iso:provenanceStandard "ISO 19650-5" ;
    rdf:object iso:term_technological_security_control ;
    rdf:predicate iso:PART_OF ;
    rdf:subject iso:term_availability .

iso:rel_704 a rdf:Statement ;
    iso:provenanceClause "B.3.3 c)" ;
    iso:provenanceStandard "ISO 19650-5" ;
    iso:relationshipNote "The third of the eight B.3.3 aspects: systems and related processes are designed, implemented, operated and maintained so as to prevent the creation of harmful states which can lead to injury or loss of life, unintentional environmental damage, or damage to assets." ;
    rdf:object iso:term_technological_security_control ;
    rdf:predicate iso:PART_OF ;
    rdf:subject iso:term_safety .

iso:rel_705 a rdf:Statement ;
    iso:provenanceClause "B.3.3 d)" ;
    iso:provenanceStandard "ISO 19650-5" ;
    rdf:object iso:term_technological_security_control ;
    rdf:predicate iso:PART_OF ;
    rdf:subject iso:term_resilience .

iso:rel_706 a rdf:Statement ;
    iso:provenanceClause "B.3.3 e)" ;
    iso:provenanceStandard "ISO 19650-5" ;
    rdf:object iso:term_technological_security_control ;
    rdf:predicate iso:PART_OF ;
    rdf:subject iso:term_possession .

iso:rel_707 a rdf:Statement ;
    iso:provenanceClause "B.3.3 f)" ;
    iso:provenanceStandard "ISO 19650-5" ;
    rdf:object iso:term_technological_security_control ;
    rdf:predicate iso:PART_OF ;
    rdf:subject iso:term_authenticity .

iso:rel_708 a rdf:Statement ;
    iso:provenanceClause "B.3.3 g)" ;
    iso:provenanceStandard "ISO 19650-5" ;
    rdf:object iso:term_technological_security_control ;
    rdf:predicate iso:PART_OF ;
    rdf:subject iso:term_utility .

iso:rel_709 a rdf:Statement ;
    iso:provenanceClause "B.3.3 h)" ;
    iso:provenanceStandard "ISO 19650-5" ;
    rdf:object iso:term_technological_security_control ;
    rdf:predicate iso:PART_OF ;
    rdf:subject iso:term_integrity .

iso:rel_71 a rdf:Statement ;
    iso:provenanceClause "7.3" ;
    iso:provenanceStandard "ISO 19650-1" ;
    iso:relationshipNote "project information management involves leadership in establishing the project's information standard, the production methods and procedures, and the project's CDE" ;
    rdf:object iso:term_cde ;
    rdf:predicate iso:ESTABLISHES ;
    rdf:subject iso:function_project_information_management .

iso:rel_710 a rdf:Statement ;
    iso:provenanceClause "B.3.3 a)" ;
    iso:provenanceStandard "ISO 19650-5" ;
    iso:relationshipNote "Controlling, and preventing unauthorized access to, information which can be sensitive or breach privacy, IN ISOLATION OR IN AGGREGATE." ;
    rdf:object iso:term_sensitive_information ;
    rdf:predicate iso:GOVERNS ;
    rdf:subject iso:term_confidentiality .

iso:rel_711 a rdf:Statement ;
    iso:provenanceClause "B.3.3 a)" ;
    iso:provenanceStandard "ISO 19650-5" ;
    iso:relationshipNote "The phrase 'in isolation or in aggregate' in B.3.3 a) links the confidentiality aspect directly to the aggregation risk of A.1 g)." ;
    rdf:object iso:term_information_aggregation_risk ;
    rdf:predicate iso:RESPONDS_TO ;
    rdf:subject iso:term_confidentiality .

iso:rel_712 a rdf:Statement ;
    iso:provenanceClause "B.3.3 h)" ;
    iso:provenanceStandard "ISO 19650-5" ;
    iso:relationshipNote "The five attributes of integrity (completeness, accuracy, consistency, coherence, configuration) overlap almost entirely with the information quality of ISO 19650-1, 11.3, but are approached from the security side. This is the bridge between the data quality axis and the data security axis." ;
    rdf:object iso:term_information_quality ;
    rdf:predicate iso:SUPPORTS ;
    rdf:subject iso:term_integrity .

iso:rel_713 a rdf:Statement ;
    iso:provenanceClause "B.3.3 f)" ;
    iso:provenanceStandard "ISO 19650-5" ;
    iso:relationshipNote "Covers both the INPUT to and the OUTPUT from systems as well as the state of the system - which for PdM means both sensor readings and prediction alerts must be verifiable as genuine." ;
    rdf:object iso:term_information_quality ;
    rdf:predicate iso:SUPPORTS ;
    rdf:subject iso:term_authenticity .

iso:rel_714 a rdf:Statement ;
    iso:provenanceClause "B.3.3 h); B.4.1 e); A.1 d) 4)" ;
    iso:provenanceStandard "ISO 19650-5" ;
    iso:relationshipNote "A.1 d) 4) names master referential data integrity as one of four things malicious acts can compromise; B.4.1 e) requires protection against the loss, disclosure, corruption of, or loss of access or unauthorized changes to information, metadata AND referential master data." ;
    rdf:object iso:term_referential_master_data ;
    rdf:predicate iso:APPLIES_TO ;
    rdf:subject iso:term_integrity .

iso:rel_715 a rdf:Statement ;
    iso:provenanceClause "A.1 d) 3); B.4.1 e)" ;
    iso:provenanceStandard "ISO 19650-5" ;
    rdf:object iso:term_metadata ;
    rdf:predicate iso:APPLIES_TO ;
    rdf:subject iso:term_integrity .

iso:rel_716 a rdf:Statement ;
    iso:provenanceClause "B.3.3 g)" ;
    iso:provenanceStandard "ISO 19650-5" ;
    iso:relationshipNote "PdM HOOK: utility is the only one of the eight B.3.3 aspects that names ASSET INFORMATION directly - ensuring that asset information and systems REMAIN USEFUL over the period access to that information may be required. It matches ISO 19650-3, 5.1.12 (safe and retrievable storage with preventative maintenance against physical or technological deterioration or obsolescence) and ISO 19650-2, 5.8.1 (future access requirements, future re-use). It decides whether failure data from many years ago can still be used as a training set." ;
    rdf:object iso:term_aim ;
    rdf:predicate iso:SUPPORTS ;
    rdf:subject iso:term_utility .

iso:rel_717 a rdf:Statement ;
    iso:provenanceClause "B.3.3 b)" ;
    iso:provenanceStandard "ISO 19650-5" ;
    iso:relationshipNote "INTERPRETIVE: B.3.3 b) requires information, systems and associated processes to be consistently discoverable, accessible and usable IN A TIMELY FASHION, with a quantitative SLA-style target in its NOTE. ISO 19650-3, 5.1.12 Note 2 defines the AIM-to-physical-asset alignment as the time interval between changes occurring to the asset and those changes being reflected in the AIM. The two requirements bound data latency from two different directions." ;
    rdf:object iso:term_aim_asset_alignment ;
    rdf:predicate iso:SUPPORTS ;
    rdf:subject iso:term_availability .

iso:rel_718 a rdf:Statement ;
    iso:provenanceClause "B.4.2" ;
    iso:provenanceStandard "ISO 19650-5" ;
    iso:relationshipNote "Informative (Annex B): the information security policies and processes should be applicable ACROSS the generic information lifecycle." ;
    rdf:object iso:term_information_security_control ;
    rdf:predicate iso:APPLIES_TO ;
    rdf:subject iso:term_generic_information_lifecycle .

iso:rel_719 a rdf:Statement ;
    iso:provenanceClause "B.4.2 a)" ;
    iso:provenanceStandard "ISO 19650-5" ;
    rdf:object iso:term_generic_information_lifecycle ;
    rdf:predicate iso:PART_OF ;
    rdf:subject iso:term_lifecycle_capture .

iso:rel_72 a rdf:Statement ;
    iso:provenanceClause "7.4" ;
    iso:provenanceStandard "ISO 19650-1" ;
    iso:relationshipNote "information management functions should be assigned for each task team where delivery teams are sub-divided" ;
    rdf:object iso:term_task_team ;
    rdf:predicate iso:ASSIGNED_TO ;
    rdf:subject iso:function_task_information_management .

iso:rel_720 a rdf:Statement ;
    iso:provenanceClause "B.4.2 b)" ;
    iso:provenanceStandard "ISO 19650-5" ;
    rdf:object iso:term_generic_information_lifecycle ;
    rdf:predicate iso:PART_OF ;
    rdf:subject iso:term_lifecycle_acquisition .

iso:rel_721 a rdf:Statement ;
    iso:provenanceClause "B.4.2 c)" ;
    iso:provenanceStandard "ISO 19650-5" ;
    rdf:object iso:term_generic_information_lifecycle ;
    rdf:predicate iso:PART_OF ;
    rdf:subject iso:term_lifecycle_maintenance .

iso:rel_722 a rdf:Statement ;
    iso:provenanceClause "B.4.2 d)" ;
    iso:provenanceStandard "ISO 19650-5" ;
    rdf:object iso:term_generic_information_lifecycle ;
    rdf:predicate iso:PART_OF ;
    rdf:subject iso:term_lifecycle_synthesis .

iso:rel_723 a rdf:Statement ;
    iso:provenanceClause "B.4.2 e)" ;
    iso:provenanceStandard "ISO 19650-5" ;
    rdf:object iso:term_generic_information_lifecycle ;
    rdf:predicate iso:PART_OF ;
    rdf:subject iso:term_lifecycle_usage .

iso:rel_724 a rdf:Statement ;
    iso:provenanceClause "B.4.2 f)" ;
    iso:provenanceStandard "ISO 19650-5" ;
    rdf:object iso:term_generic_information_lifecycle ;
    rdf:predicate iso:PART_OF ;
    rdf:subject iso:term_lifecycle_archival .

iso:rel_725 a rdf:Statement ;
    iso:provenanceClause "B.4.2 g)" ;
    iso:provenanceStandard "ISO 19650-5" ;
    rdf:object iso:term_generic_information_lifecycle ;
    rdf:predicate iso:PART_OF ;
    rdf:subject iso:term_lifecycle_publication .

iso:rel_726 a rdf:Statement ;
    iso:provenanceClause "B.4.2 h)" ;
    iso:provenanceStandard "ISO 19650-5" ;
    rdf:object iso:term_generic_information_lifecycle ;
    rdf:predicate iso:PART_OF ;
    rdf:subject iso:term_lifecycle_purging .

iso:rel_727 a rdf:Statement ;
    iso:provenanceClause "B.4.2 a)" ;
    iso:provenanceStandard "ISO 19650-5" ;
    iso:relationshipNote "The capture step covers the creation and initial storage of a piece of information, INCLUDING its metadata." ;
    rdf:object iso:term_metadata ;
    rdf:predicate iso:APPLIES_TO ;
    rdf:subject iso:term_lifecycle_capture .

iso:rel_728 a rdf:Statement ;
    iso:provenanceClause "B.4.2 c)" ;
    iso:provenanceStandard "ISO 19650-5" ;
    iso:relationshipNote "PdM HOOK: the seven activities of the maintenance step (validation and verification, cleansing, reformatting, enrichment, movement, integration from multiple systems, updating of published information) are the closest description of a real data pre-processing pipeline anywhere in the ISO 19650 series." ;
    rdf:object iso:term_information_quality ;
    rdf:predicate iso:SUPPORTS ;
    rdf:subject iso:term_lifecycle_maintenance .

iso:rel_729 a rdf:Statement ;
    iso:provenanceClause "B.4.2 f)" ;
    iso:provenanceStandard "ISO 19650-5" ;
    iso:relationshipNote "The Part 5 definition is STRICTER than state_archive of ISO 19650-1, 12.7: archival here explicitly excludes all maintenance, usage and publication. When loading into Neo4j the two nodes must be kept separate and joined only by CORRESPONDS_TO, never merged." ;
    rdf:object iso:state_archive ;
    rdf:predicate iso:CORRESPONDS_TO ;
    rdf:subject iso:term_lifecycle_archival .

iso:rel_73 a rdf:Statement ;
    iso:provenanceClause "6.1" ;
    iso:provenanceStandard "ISO 19650-1" ;
    iso:relationshipNote "one of the four overarching principles for the specification and delivery of project and asset information" ;
    rdf:object iso:term_information_management ;
    rdf:predicate iso:GOVERNS ;
    rdf:subject iso:principle_delivery_cycle_1 .

iso:rel_730 a rdf:Statement ;
    iso:provenanceClause "B.4.2 g)" ;
    iso:provenanceStandard "ISO 19650-5" ;
    iso:relationshipNote "Broader than state_published of ISO 19650-1, 12.6: 'publication' in Part 5 includes making information available WITHIN the organization, not only authorizing it for use." ;
    rdf:object iso:state_published ;
    rdf:predicate iso:CORRESPONDS_TO ;
    rdf:subject iso:term_lifecycle_publication .

iso:rel_731 a rdf:Statement ;
    iso:provenanceClause "7.2.1; B.4.2 g)" ;
    iso:provenanceStandard "ISO 19650-5" ;
    iso:relationshipNote "Every act of sharing or publication must first pass the 7.2 assessment." ;
    rdf:object iso:term_third_party_information_provision_assessment ;
    rdf:predicate iso:RESPONDS_TO ;
    rdf:subject iso:term_lifecycle_publication .

iso:rel_732 a rdf:Statement ;
    iso:provenanceClause "B.4.1 c)" ;
    iso:provenanceStandard "ISO 19650-5" ;
    iso:relationshipNote "PdM design tension: informative Annex B.4.1 c) recommends considering the maximum amount of sensitive asset information held in databases, exchanges and information models, while Part 3 lists rich AIM content examples. The security information requirements are the appropriate place to reconcile minimization and analytical value." ;
    rdf:object iso:term_aim ;
    rdf:predicate iso:APPLIES_TO ;
    rdf:subject iso:term_information_security_control .

iso:rel_733 a rdf:Statement ;
    iso:provenanceClause "B.4.1 f)" ;
    iso:provenanceStandard "ISO 19650-5" ;
    iso:relationshipNote "PdM HOOK: B.4.1 f) requires monitoring and recording of changes to the processes and technologies used for information capture, processing - NAMING information synthesis explicitly - and storage. That means changing a prediction algorithm or model version falls under change control and must leave an audit trail." ;
    rdf:object iso:term_lifecycle_synthesis ;
    rdf:predicate iso:APPLIES_TO ;
    rdf:subject iso:term_information_security_control .

iso:rel_734 a rdf:Statement ;
    iso:provenanceClause "5.2.3" ;
    iso:provenanceStandard "ISO 19650-5" ;
    iso:relationshipNote "BRIDGE TO PART 2. 5.2.3 (normative): where a project relates to the delivery phase of an asset using BIM, the security-minded approach SHALL be developed ALONGSIDE the requirements described in ISO 19650-2. ISO 19650-2 is a normative reference of ISO 19650-5." ;
    rdf:object iso:term_im_process_delivery ;
    rdf:predicate iso:LINKED_TO ;
    rdf:subject iso:term_security_minded_approach .

iso:rel_735 a rdf:Statement ;
    iso:provenanceClause "5.2.4" ;
    iso:provenanceStandard "ISO 19650-5" ;
    iso:relationshipNote "BRIDGE TO PART 3. 5.2.4 (normative): where the activity relates to the operational phase of an asset using BIM, the security-minded approach SHALL be developed ALONGSIDE the requirements described in ISO 19650-3. ISO 19650-3 is a normative reference of ISO 19650-5." ;
    rdf:object iso:term_im_process_operational ;
    rdf:predicate iso:LINKED_TO ;
    rdf:subject iso:term_security_minded_approach .

iso:rel_736 a rdf:Statement ;
    iso:provenanceClause "5.2.3; Figure 1 (E)" ;
    iso:provenanceStandard "ISO 19650-5" ;
    iso:relationshipNote "Figure 1 group E: activities undertaken during the delivery phase of the asset (see also ISO 19650-2)." ;
    rdf:object iso:term_delivery_phase ;
    rdf:predicate iso:APPLIES_TO ;
    rdf:subject iso:term_security_minded_approach .

iso:rel_737 a rdf:Statement ;
    iso:provenanceClause "5.2.4; Figure 1 (D)" ;
    iso:provenanceStandard "ISO 19650-5" ;
    iso:relationshipNote "Figure 1 group D: activities undertaken during the operational phase of assets, including asset operational use (12) and performance measurement and improvement actions (13)." ;
    rdf:object iso:term_operational_phase ;
    rdf:predicate iso:APPLIES_TO ;
    rdf:subject iso:term_security_minded_approach .

iso:rel_738 a rdf:Statement ;
    iso:provenanceClause "5.1.7 c)" ;
    iso:provenanceStandard "ISO 19650-3" ;
    iso:relationshipNote "CLOSES AN OPEN HOOK FROM PART 3. ISO 19650-3, 5.1.7 c) requires the asset information production methods and procedures to consider the 'security of information' per ISO 19650-5. The provenance carries the name of the standard that STATES the requirement (Part 3), not Part 5." ;
    rdf:object iso:term_security_minded_approach ;
    rdf:predicate iso:RESPONDS_TO ;
    rdf:subject iso:term_asset_information_production_methods_procedures .

iso:rel_739 a rdf:Statement ;
    iso:provenanceClause "5.1.11 e)" ;
    iso:provenanceStandard "ISO 19650-3" ;
    iso:relationshipNote "CLOSES AN OPEN HOOK FROM PART 3. ISO 19650-3, 5.1.11 e) requires the establishment or adaptation of the AIM to consider security-minded design and operation of the AIM, per ISO 19650-5." ;
    rdf:object iso:term_security_minded_approach ;
    rdf:predicate iso:RESPONDS_TO ;
    rdf:subject iso:term_aim .

iso:rel_74 a rdf:Statement ;
    iso:provenanceClause "6.1" ;
    iso:provenanceStandard "ISO 19650-1" ;
    iso:relationshipNote "one of the four overarching principles for the specification and delivery of project and asset information" ;
    rdf:object iso:term_information_management ;
    rdf:predicate iso:GOVERNS ;
    rdf:subject iso:principle_delivery_cycle_2 .

iso:rel_740 a rdf:Statement ;
    iso:provenanceClause "5.1.12" ;
    iso:provenanceStandard "ISO 19650-3" ;
    iso:relationshipNote "CLOSES AN OPEN HOOK FROM PART 3. ISO 19650-3, 5.1.12 requires the processes to maintain the AIM to include security compliance per ISO 19650-5, alongside safe and retrievable storage with preventative maintenance against physical deterioration, technological deterioration or obsolescence." ;
    rdf:object iso:term_security_minded_approach ;
    rdf:predicate iso:RESPONDS_TO ;
    rdf:subject iso:term_aim_maintenance_process .

iso:rel_741 a rdf:Statement ;
    iso:provenanceClause "5.2.2 a)" ;
    iso:provenanceStandard "ISO 19650-3" ;
    iso:relationshipNote "CLOSES AN OPEN HOOK FROM PART 3. ISO 19650-3, 5.2.2 a) requires the EIR (ISO 19650-3) to establish security-minded considerations per ISO 19650-5 for each appointment and each trigger event." ;
    rdf:object iso:term_security_minded_approach ;
    rdf:predicate iso:RESPONDS_TO ;
    rdf:subject iso:term_eir_iso19650_3 .

iso:rel_742 a rdf:Statement ;
    iso:provenanceClause "5.1.10" ;
    iso:provenanceStandard "ISO 19650-3" ;
    iso:relationshipNote "CLOSES AN OPEN HOOK FROM PART 3. ISO 19650-3, 5.1.10 requires the appointing party to establish or adapt information quality and INFORMATION SECURITY processes within enterprise systems, irrespective of where or how information is stored, including where the system is outside its direct control. Compare ISO 19650-5, B.3.1 b) on the security of interconnections and interactions between systems." ;
    rdf:object iso:term_security_minded_approach ;
    rdf:predicate iso:RESPONDS_TO ;
    rdf:subject iso:term_enterprise_system .

iso:rel_743 a rdf:Statement ;
    iso:provenanceClause "5.1.5 c)" ;
    iso:provenanceStandard "ISO 19650-2" ;
    iso:relationshipNote "CLOSES AN OPEN HOOK FROM PART 2. ISO 19650-2, 5.1.5 c) requires the project information production methods and procedures to consider 'the security or distribution of information'. Note that ISO 19650-2:2018 was published BEFORE ISO 19650-5:2020 and so could not cite Part 5 - this link is inferred, unlike the Part 3 hooks which cite ISO 19650-5 explicitly." ;
    rdf:object iso:term_security_minded_approach ;
    rdf:predicate iso:RESPONDS_TO ;
    rdf:subject iso:term_project_information_production_methods_procedures .

iso:rel_744 a rdf:Statement ;
    iso:provenanceClause "5.1.7 f)" ;
    iso:provenanceStandard "ISO 19650-2" ;
    iso:relationshipNote "CLOSES AN OPEN HOOK FROM PART 2. ISO 19650-2, 5.1.7 f) requires the project CDE to enable controlled access AT INFORMATION CONTAINER LEVEL - the technical mechanism enforcing the need-to-know principle of ISO 19650-5, 3.4. ISO 19650-2, 5.1.7 e) (recording the name of user and date when revisions transition between states) is the corresponding audit mechanism." ;
    rdf:object iso:term_security_minded_approach ;
    rdf:predicate iso:RESPONDS_TO ;
    rdf:subject iso:term_cde .

iso:rel_745 a rdf:Statement ;
    iso:provenanceClause "9" ;
    iso:provenanceStandard "ISO 19650-1" ;
    iso:relationshipNote "CLOSES AN OPEN HOOK FROM PART 1. Principle (f) of ISO 19650-1 Clause 9: processes related to security of information should be put in place during the WHOLE life time of the asset to address issues such as unauthorized access, information loss or corruption, degradation and, as far as is practicable, obsolescence. This is the root principle that the whole of ISO 19650-5 implements." ;
    rdf:object iso:term_security_minded_approach ;
    rdf:predicate iso:SUPPORTS ;
    rdf:subject iso:principle_collab_f .

iso:rel_746 a rdf:Statement ;
    iso:provenanceClause "10.4" ;
    iso:provenanceStandard "ISO 19650-1" ;
    iso:relationshipNote "CLOSES AN OPEN HOOK FROM PART 1. The second purpose of the federation strategy in Annex A of ISO 19650-1 is INFORMATION SECURITY: separating information containers or spatial sections by access permission - for example in a prison, separating general site information, general design information and security-specific information. This is the structural mechanism for enforcing the data partitioning that ISO 19650-5, A.1 g) calls for in order to limit aggregation risk." ;
    rdf:object iso:term_security_minded_approach ;
    rdf:predicate iso:RESPONDS_TO ;
    rdf:subject iso:term_federation_strategy .

iso:rel_747 a rdf:Statement ;
    iso:provenanceClause "3.11; 4.3.2" ;
    iso:provenanceStandard "ISO 19650-5" ;
    iso:relationshipNote "INTERPRETIVE but a direct consequence: once a built asset is classified as sensitive under 4.3.2, all information relating to it - that is, the AIM contents per ISO 19650-3 - falls within the 3.11 definition of sensitive information, including the maintenance history, failure history, condition data, operational data, spares inventory and downtime impact of Part 3 Annex A." ;
    rdf:object iso:term_aim ;
    rdf:predicate iso:APPLIES_TO ;
    rdf:subject iso:term_sensitive_information .

iso:rel_748 a rdf:Statement ;
    iso:provenanceClause "Introduction" ;
    iso:provenanceStandard "ISO 19650-5" ;
    iso:relationshipNote "Uses sensors to control or influence physical parts of the system; already found in transportation, utilities, infrastructure, buildings, manufacturing, health care and defence." ;
    rdf:object iso:term_asset ;
    rdf:predicate iso:APPLIES_TO ;
    rdf:subject iso:term_cyber_physical_system .

iso:rel_749 a rdf:Statement ;
    iso:provenanceClause "Introduction" ;
    iso:provenanceStandard "ISO 19650-5" ;
    iso:relationshipNote "PdM HOOK: the cyber-physical system of the ISO 19650-5 Introduction and the condition monitoring system of ISO 19650-3, A.5 describe the same class of system from two viewpoints - Part 3 treats it as enterprise system functionality linked into the AIM, Part 5 treats it as a source of security risk to be assessed under B.3.4." ;
    rdf:object iso:term_condition_monitoring_system ;
    rdf:predicate iso:CORRESPONDS_TO ;
    rdf:subject iso:term_cyber_physical_system .

iso:rel_75 a rdf:Statement ;
    iso:provenanceClause "6.1" ;
    iso:provenanceStandard "ISO 19650-1" ;
    iso:relationshipNote "one of the four overarching principles for the specification and delivery of project and asset information" ;
    rdf:object iso:term_information_management ;
    rdf:predicate iso:GOVERNS ;
    rdf:subject iso:principle_delivery_cycle_3 .

iso:rel_750 a rdf:Statement ;
    iso:provenanceClause "Introduction; B.3.1 c)" ;
    iso:provenanceStandard "ISO 19650-5" ;
    iso:relationshipNote "B.3.1 c) requires consideration of the security around 'systems controlling physical assets' - precisely the definition of SCADA in ISO 19650-3, A.5." ;
    rdf:object iso:term_scada_system ;
    rdf:predicate iso:CORRESPONDS_TO ;
    rdf:subject iso:term_cyber_physical_system .

iso:rel_751 a rdf:Statement ;
    iso:provenanceClause "Introduction" ;
    iso:provenanceStandard "ISO 19650-5" ;
    iso:relationshipNote "INTERPRETIVE: the Introduction states that cyber-physical systems capture real-time information about asset USE and CONDITION; ISO 19650-3, A.4.2 calls that dataset asset operational data (performance characteristics and design limits)." ;
    rdf:object iso:term_asset_operational_data ;
    rdf:predicate iso:RESULTS_IN ;
    rdf:subject iso:term_cyber_physical_system .

iso:rel_752 a rdf:Statement ;
    iso:provenanceClause "Introduction" ;
    iso:provenanceStandard "ISO 19650-5" ;
    iso:relationshipNote "INTERPRETIVE: ISO 19650-3, A.4.4 asset condition and duty including intensity of use is the kind of data that capturing real-time information about use and condition produces." ;
    rdf:object iso:term_asset_condition_duty ;
    rdf:predicate iso:RESULTS_IN ;
    rdf:subject iso:term_cyber_physical_system .

iso:rel_753 a rdf:Statement ;
    iso:provenanceClause "Introduction; A.1 NOTE 2 4)" ;
    iso:provenanceStandard "ISO 19650-5" ;
    iso:relationshipNote "THE CORE PdM TENSION: the very capability to capture real-time information about how an asset is used - the thing that makes predictive maintenance valuable - is also what creates the pattern-of-use that A.1 NOTE 2 4) names as a target of hostile reconnaissance and that 7.2.3 c) requires to be assessed before sharing. You cannot have one without the other; you can only control who is allowed to see it." ;
    rdf:object iso:term_pattern_of_use ;
    rdf:predicate iso:RESULTS_IN ;
    rdf:subject iso:term_cyber_physical_system .

iso:rel_754 a rdf:Statement ;
    iso:provenanceClause "Introduction" ;
    iso:provenanceStandard "ISO 19650-5" ;
    iso:relationshipNote "INTERPRETIVE: the REAL-TIME capability of a cyber-physical system is the technical means of narrowing the interval between changes occurring to the asset and those changes being reflected in the AIM - which is exactly the AIM-to-physical-asset alignment defined in ISO 19650-3, 5.1.12 Note 2." ;
    rdf:object iso:term_aim_asset_alignment ;
    rdf:predicate iso:SUPPORTS ;
    rdf:subject iso:term_cyber_physical_system .

iso:rel_755 a rdf:Statement ;
    iso:provenanceClause "Introduction" ;
    iso:provenanceStandard "ISO 19650-5" ;
    iso:relationshipNote "INTERPRETIVE: 'better asset lifecycle management by capturing real-time information about asset use and condition' is the most direct description of a predictive maintenance architecture in the whole ISO 19650 series; the corresponding purpose is 'maintenance and repair' from ISO 19650-1, 5.1." ;
    rdf:object iso:purpose_maintenance_repair ;
    rdf:predicate iso:SUPPORTS ;
    rdf:subject iso:term_cyber_physical_system .

iso:rel_756 a rdf:Statement ;
    iso:provenanceClause "Introduction" ;
    iso:provenanceStandard "ISO 19650-5" ;
    iso:relationshipNote "INTERPRETIVE: the Introduction cites increases in energy efficiency among the benefits - corresponding to the 'operations' purpose of ISO 19650-1, 5.1." ;
    rdf:object iso:purpose_operations ;
    rdf:predicate iso:SUPPORTS ;
    rdf:subject iso:term_cyber_physical_system .

iso:rel_757 a rdf:Statement ;
    iso:provenanceClause "Introduction" ;
    iso:provenanceStandard "ISO 19650-5" ;
    iso:relationshipNote "Introduction: as a consequence of the increasing use of, and dependence on, information and communications technologies, there is a need to address inherent vulnerability issues and therefore the security implications that arise." ;
    rdf:object iso:term_cyber_physical_system ;
    rdf:predicate iso:APPLIES_TO ;
    rdf:subject iso:term_vulnerability .

iso:rel_758 a rdf:Statement ;
    iso:provenanceClause "4.2.1; 6.2.1; B.3.4 c)" ;
    iso:provenanceStandard "ISO 19650-5" ;
    iso:relationshipNote "The three sources of security risk named in 4.2.1 and 6.2.1 - greater availability of information, greater integration of services and systems, and greater dependency on technology-based systems - are the three defining characteristics of a cyber-physical or PdM deployment." ;
    rdf:object iso:term_cyber_physical_system ;
    rdf:predicate iso:APPLIES_TO ;
    rdf:subject iso:term_security_risk .

iso:rel_759 a rdf:Statement ;
    iso:provenanceClause "A.1 g); A.1 NOTE 5" ;
    iso:provenanceStandard "ISO 19650-5" ;
    iso:relationshipNote "PdM TENSION: interpretive, but almost direct. Per ISO 19650-3, 5.1.11 the AIM SHALL be a federated information model which can include contents from different information providers, and ISO 19650-3, 5.1.10 permits CMMS/CAFM, condition monitoring, SCADA and GIS to be linked into it. That is 'aggregation by association' exactly as described in A.1 NOTE 5: individually the data types have little impact if compromised, but associated together the level of impact is far higher. Design consequence: sensitivity classification must be applied at the level of the data COMBINATION, not only per information container." ;
    rdf:object iso:term_aim ;
    rdf:predicate iso:APPLIES_TO ;
    rdf:subject iso:term_information_aggregation_risk .

iso:rel_76 a rdf:Statement ;
    iso:provenanceClause "6.1" ;
    iso:provenanceStandard "ISO 19650-1" ;
    iso:relationshipNote "one of the four overarching principles for the specification and delivery of project and asset information" ;
    rdf:object iso:term_information_management ;
    rdf:predicate iso:GOVERNS ;
    rdf:subject iso:principle_delivery_cycle_4 .

iso:rel_760 a rdf:Statement ;
    iso:provenanceClause "7.2.3 b); A.1 g)" ;
    iso:provenanceStandard "ISO 19650-5" ;
    rdf:object iso:term_information_model ;
    rdf:predicate iso:APPLIES_TO ;
    rdf:subject iso:term_information_aggregation_risk .

iso:rel_761 a rdf:Statement ;
    iso:provenanceClause "7.2.3 c); A.1 NOTE 2 4)" ;
    iso:provenanceStandard "ISO 19650-5" ;
    iso:relationshipNote "PdM TENSION: interpretive. The record of proactive and reactive maintenance (ISO 19650-3, A.4.1) reveals the frequency, timing and intensity of equipment operation, and therefore contributes to determining the pattern-of-use of an asset in the sense of 7.2.3 c). The same dataset is simultaneously the most valuable input to a failure-prediction model and material that must be screened before any external sharing." ;
    rdf:object iso:term_pattern_of_use ;
    rdf:predicate iso:SUPPORTS ;
    rdf:subject iso:term_maintenance_history .

iso:rel_762 a rdf:Statement ;
    iso:provenanceClause "4.3.2 a)" ;
    iso:provenanceStandard "ISO 19650-5" ;
    iso:relationshipNote "INTERPRETIVE: ISO 19650-3, 5.1.3 requires the criticality of each asset for key business operations to be considered when identifying which assets need their information managed; ISO 19650-5, 4.3.2 a) requires any built asset constituting critical national infrastructure to be classified as sensitive. The two criticality scales differ (enterprise vs national) but frequently coincide on the same assets - so the assets where PdM has the greatest economic value are also the assets under the tightest security constraints." ;
    rdf:object iso:term_sensitive_built_asset ;
    rdf:predicate iso:LINKED_TO ;
    rdf:subject iso:term_asset_criticality .

iso:rel_763 a rdf:Statement ;
    iso:provenanceClause "B.4.2 d); B.4.1 f)" ;
    iso:provenanceStandard "ISO 19650-5" ;
    iso:relationshipNote "AN IMPORTANT PdM HOOK: interpretive. ISO 19650-3, A.2 gives the example OIR 'information to support a means to PREDICT THE PERFORMANCE of the asset to support operational decision making' - the only predictive requirement in the whole ISO 19650 series. ISO 19650-5, B.4.2 d) defines information synthesis as 'the creation of DERIVED INFORMATION'. The output of a performance-prediction model is derived information, and therefore attracts the same information security policies as the source data - and may be MORE sensitive than that source data, because it states outright a vulnerability the asset is about to develop (compare 7.2.3 a): information allowing vulnerabilities to be deduced)." ;
    rdf:object iso:term_asset_performance_prediction ;
    rdf:predicate iso:SUPPORTS ;
    rdf:subject iso:term_lifecycle_synthesis .

iso:rel_764 a rdf:Statement ;
    iso:provenanceClause "7.1.3 c)" ;
    iso:provenanceStandard "ISO 19650-5" ;
    iso:relationshipNote "PdM TENSION: interpretive. The example OIR on asset performance prediction (ISO 19650-3, A.2) has to be reconciled against the security information requirements, which detail which information is to be regarded as sensitive and what lifecycle policy applies to it. This is the formal reconciliation point between the data appetite of predictive maintenance and the restrictions of B.4.1 c) and 7.2.3." ;
    rdf:object iso:term_security_information_requirements ;
    rdf:predicate iso:RESPONDS_TO ;
    rdf:subject iso:term_asset_performance_prediction .

iso:rel_765 a rdf:Statement ;
    iso:provenanceClause "A.1 c)" ;
    iso:provenanceStandard "ISO 19650-5" ;
    iso:relationshipNote "PdM HOOK: interpretive. A failure-prediction model assumes that the installed component is of the type declared in the AIM, which is what licenses the use of that type's nominal service life, wear curves and failure data. A counterfeit, fraudulently sub-standard or contaminated component breaks that assumption silently: the model keeps running but is systematically wrong. The corresponding mitigation is logistical security (7.3)." ;
    rdf:object iso:term_asset_performance_prediction ;
    rdf:predicate iso:APPLIES_TO ;
    rdf:subject iso:term_counterfeit_component_risk .

iso:rel_766 a rdf:Statement ;
    iso:provenanceClause "7.3.1; A.1 c)" ;
    iso:provenanceStandard "ISO 19650-5" ;
    iso:relationshipNote "Logistical security covers specification, procurement, design, manufacture, transport, installation and commissioning - the chain through which a counterfeit or sub-standard component can enter." ;
    rdf:object iso:term_counterfeit_component_risk ;
    rdf:predicate iso:RESPONDS_TO ;
    rdf:subject iso:term_logistical_security .

iso:rel_767 a rdf:Statement ;
    iso:provenanceClause "9.2.8; 9.2.10" ;
    iso:provenanceStandard "ISO 19650-5" ;
    iso:relationshipNote "PdM TENSION: interpretive. 9.2.8 requires that on termination of an appointment ALL relevant information, including that which the appointed party has shared with other members of its delivery team, is delivered, stored securely, disposed of or DESTROYED in compliance with organizational and appointment-related requirements. For data held by a maintenance contractor, this clause decides whether the maintenance and failure history - the training set of the prediction model - is handed back or lost. The 'delivery' branch must be specified explicitly in the appointment documentation; otherwise a default of destruction breaks data continuity across successive contractors." ;
    rdf:object iso:term_maintenance_history ;
    rdf:predicate iso:APPLIES_TO ;
    rdf:subject iso:term_end_of_appointment_information_handling .

iso:rel_768 a rdf:Statement ;
    iso:provenanceClause "Mapping ISO 19650-5 7.1.3 c) to PdM condition observations" ;
    iso:provenanceStandard "USE-CASE EXTENSION" ;
    iso:relationshipNote "Classifies observation fields and defines their creation, distribution, use, storage, disposal and destruction policy." ;
    rdf:object iso:term_condition_observation ;
    rdf:predicate iso:GOVERNS ;
    rdf:subject iso:term_security_information_requirements .

iso:rel_769 a rdf:Statement ;
    iso:provenanceClause "Mapping ISO 19650-5 7.1.3 c) to PdM failure modes" ;
    iso:provenanceStandard "USE-CASE EXTENSION" ;
    rdf:object iso:term_failure_mode ;
    rdf:predicate iso:GOVERNS ;
    rdf:subject iso:term_security_information_requirements .

iso:rel_77 a rdf:Statement ;
    iso:provenanceClause "9" ;
    iso:provenanceStandard "ISO 19650-1" ;
    iso:relationshipNote "fundamental principle of information container-based collaborative working" ;
    rdf:object iso:term_information_container ;
    rdf:predicate iso:GOVERNS ;
    rdf:subject iso:principle_collab_a .

iso:rel_770 a rdf:Statement ;
    iso:provenanceClause "Mapping ISO 19650-5 7.1.3 c) to PdM model artifacts" ;
    iso:provenanceStandard "USE-CASE EXTENSION" ;
    iso:relationshipNote "Covers model artifacts, configuration and access without treating ISO 19650-5 as an algorithm-governance standard." ;
    rdf:object iso:term_pdm_model ;
    rdf:predicate iso:GOVERNS ;
    rdf:subject iso:term_security_information_requirements .

iso:rel_771 a rdf:Statement ;
    iso:provenanceClause "Mapping ISO 19650-5 7.1.3 c) to PdM health indicators" ;
    iso:provenanceStandard "USE-CASE EXTENSION" ;
    rdf:object iso:term_health_indicator ;
    rdf:predicate iso:GOVERNS ;
    rdf:subject iso:term_security_information_requirements .

iso:rel_772 a rdf:Statement ;
    iso:provenanceClause "Mapping ISO 19650-5 7.1.3 c) to PdM anomaly events" ;
    iso:provenanceStandard "USE-CASE EXTENSION" ;
    iso:relationshipNote "An operational anomaly event is distinct from a security incident; the security policy applies to the information artifact, not its operational meaning." ;
    rdf:object iso:term_anomaly_event ;
    rdf:predicate iso:GOVERNS ;
    rdf:subject iso:term_security_information_requirements .

iso:rel_773 a rdf:Statement ;
    iso:provenanceClause "Mapping ISO 19650-5 7.1.3 c) to PdM RUL predictions" ;
    iso:provenanceStandard "USE-CASE EXTENSION" ;
    rdf:object iso:term_remaining_useful_life_prediction ;
    rdf:predicate iso:GOVERNS ;
    rdf:subject iso:term_security_information_requirements .

iso:rel_774 a rdf:Statement ;
    iso:provenanceClause "Mapping ISO 19650-5 7.1.3 c) to PdM maintenance alerts" ;
    iso:provenanceStandard "USE-CASE EXTENSION" ;
    rdf:object iso:term_maintenance_alert ;
    rdf:predicate iso:GOVERNS ;
    rdf:subject iso:term_security_information_requirements .

iso:rel_775 a rdf:Statement ;
    iso:provenanceClause "Mapping ISO 19650-5 7.1.3 c) to PdM work orders" ;
    iso:provenanceStandard "USE-CASE EXTENSION" ;
    rdf:object iso:term_maintenance_work_order ;
    rdf:predicate iso:GOVERNS ;
    rdf:subject iso:term_security_information_requirements .

iso:rel_776 a rdf:Statement ;
    iso:provenanceClause "Mapping ISO 19650-5 7.1.3 c) to PdM intervention outcomes" ;
    iso:provenanceStandard "USE-CASE EXTENSION" ;
    rdf:object iso:term_maintenance_intervention_outcome ;
    rdf:predicate iso:GOVERNS ;
    rdf:subject iso:term_security_information_requirements .

iso:rel_777 a rdf:Statement ;
    iso:provenanceClause "B.3.4; mapping to ISO 19650-3 A.5" ;
    iso:provenanceStandard "ISO 19650-5" ;
    iso:relationshipNote "Informative mapping: a distributed condition-monitoring sensor network is a natural instance of the IoT systems addressed by B.3.4." ;
    rdf:object iso:term_condition_monitoring_system ;
    rdf:predicate iso:APPLIES_TO ;
    rdf:subject iso:term_iot_security_assessment .

iso:rel_778 a rdf:Statement ;
    iso:provenanceClause "B.3.4; mapping to ISO 19650-3 A.5" ;
    iso:provenanceStandard "ISO 19650-5" ;
    iso:relationshipNote "Informative mapping where SCADA is implemented as, or integrated with, distributed or IoT technologies." ;
    rdf:object iso:term_scada_system ;
    rdf:predicate iso:APPLIES_TO ;
    rdf:subject iso:term_iot_security_assessment .

iso:rel_779 a rdf:Statement ;
    iso:provenanceClause "B.3.1; mapping to ISO 19650-3 A.5" ;
    iso:provenanceStandard "ISO 19650-5" ;
    rdf:object iso:term_condition_monitoring_system ;
    rdf:predicate iso:APPLIES_TO ;
    rdf:subject iso:term_technological_security_control .

iso:rel_78 a rdf:Statement ;
    iso:provenanceClause "9" ;
    iso:provenanceStandard "ISO 19650-1" ;
    iso:relationshipNote "fundamental principle of information container-based collaborative working" ;
    rdf:object iso:term_information_container ;
    rdf:predicate iso:GOVERNS ;
    rdf:subject iso:principle_collab_b .

iso:rel_780 a rdf:Statement ;
    iso:provenanceClause "B.3.1 c); mapping to ISO 19650-3 A.5" ;
    iso:provenanceStandard "ISO 19650-5" ;
    rdf:object iso:term_scada_system ;
    rdf:predicate iso:APPLIES_TO ;
    rdf:subject iso:term_technological_security_control .

iso:rel_781 a rdf:Statement ;
    iso:provenanceClause "Mapping ISO 19650-5 B.3.3 h) to PdM observations" ;
    iso:provenanceStandard "USE-CASE EXTENSION" ;
    iso:relationshipNote "Completeness, accuracy, consistency, coherence and configuration are prerequisites for trustworthy condition observations." ;
    rdf:object iso:term_condition_observation ;
    rdf:predicate iso:SUPPORTS ;
    rdf:subject iso:term_integrity .

iso:rel_782 a rdf:Statement ;
    iso:provenanceClause "Mapping ISO 19650-5 B.3.3 f) to PdM observations" ;
    iso:provenanceStandard "USE-CASE EXTENSION" ;
    iso:relationshipNote "A PdM pipeline needs assurance that sensor inputs and their source-system state are genuine." ;
    rdf:object iso:term_condition_observation ;
    rdf:predicate iso:SUPPORTS ;
    rdf:subject iso:term_authenticity .

iso:rel_783 a rdf:Statement ;
    iso:provenanceClause "Mapping ISO 19650-5 B.3.3 f) to PdM alerts" ;
    iso:provenanceStandard "USE-CASE EXTENSION" ;
    iso:relationshipNote "Authenticity applies to system outputs as well as inputs, including maintenance alerts." ;
    rdf:object iso:term_maintenance_alert ;
    rdf:predicate iso:SUPPORTS ;
    rdf:subject iso:term_authenticity .

iso:rel_784 a rdf:Statement ;
    iso:provenanceClause "Mapping ISO 19650-5 B.3.3 b) to the PdM service" ;
    iso:provenanceStandard "USE-CASE EXTENSION" ;
    rdf:object iso:term_pdm_model ;
    rdf:predicate iso:SUPPORTS ;
    rdf:subject iso:term_availability .

iso:rel_785 a rdf:Statement ;
    iso:provenanceClause "Mapping ISO 19650-5 B.3.3 d) to the PdM service" ;
    iso:provenanceStandard "USE-CASE EXTENSION" ;
    rdf:object iso:term_pdm_model ;
    rdf:predicate iso:SUPPORTS ;
    rdf:subject iso:term_resilience .

iso:rel_786 a rdf:Statement ;
    iso:provenanceClause "Mapping ISO 19650-5 B.3.3 g) to long-lived PdM data and models" ;
    iso:provenanceStandard "USE-CASE EXTENSION" ;
    rdf:object iso:term_pdm_model ;
    rdf:predicate iso:SUPPORTS ;
    rdf:subject iso:term_utility .

iso:rel_787 a rdf:Statement ;
    iso:provenanceClause "Mapping ISO 19650-5 B.4.2 d) to PdM derived information" ;
    iso:provenanceStandard "USE-CASE EXTENSION" ;
    iso:relationshipNote "A remaining-useful-life prediction is derived information and therefore an instance of information synthesis for this use case." ;
    rdf:object iso:term_remaining_useful_life_prediction ;
    rdf:predicate iso:CORRESPONDS_TO ;
    rdf:subject iso:term_lifecycle_synthesis .

iso:rel_788 a rdf:Statement ;
    iso:provenanceClause "Mapping ISO 19650-5 B.4.1 to PdM model processing and storage" ;
    iso:provenanceStandard "USE-CASE EXTENSION" ;
    rdf:object iso:term_pdm_model ;
    rdf:predicate iso:APPLIES_TO ;
    rdf:subject iso:term_information_security_control .

iso:rel_789 a rdf:Statement ;
    iso:provenanceClause "Mapping ISO 19650-5 7.5 to the PdM service" ;
    iso:provenanceStandard "USE-CASE EXTENSION" ;
    iso:relationshipNote "This is security-control assurance for the PdM service, not validation of prediction accuracy." ;
    rdf:object iso:term_pdm_model ;
    rdf:predicate iso:APPLIES_TO ;
    rdf:subject iso:term_security_monitoring_auditing .

iso:rel_79 a rdf:Statement ;
    iso:provenanceClause "9" ;
    iso:provenanceStandard "ISO 19650-1" ;
    iso:relationshipNote "fundamental principle of information container-based collaborative working" ;
    rdf:object iso:term_information_container ;
    rdf:predicate iso:GOVERNS ;
    rdf:subject iso:principle_collab_c .

iso:rel_790 a rdf:Statement ;
    iso:provenanceClause "Mapping ISO 19650-5 7.2.3 b) and Annex A.1 g) to aggregated telemetry" ;
    iso:provenanceStandard "USE-CASE EXTENSION" ;

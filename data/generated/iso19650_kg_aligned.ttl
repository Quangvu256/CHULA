iso:rel_662 a rdf:Statement ;
    iso:provenanceClause "8.1.1 b); 8.2" ;
    iso:provenanceStandard "ISO 19650-5" ;
    iso:relationshipNote "Includes events that NEARLY occurred (including one that nearly occurred)." ;
    rdf:object iso:term_security_breach ;
    rdf:predicate iso:RESPONDS_TO ;
    rdf:subject iso:term_security_breach_incident_management_plan .

iso:rel_663 a rdf:Statement ;

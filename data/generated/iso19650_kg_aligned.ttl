iso:term_risk_urgency_prioritization a iso:Concept,
        iso:IsoNode ;
    rdfs:label "operational prioritization of risk" ;
    iso:DERIVED_FROM iso:term_level_of_risk ;
    iso:GOVERNS iso:term_maintenance_alert ;
    iso:SUPPORTS iso:purpose_maintenance_repair ;
    iso:definition "interpretation of the level-of-risk enumeration in operational terms: Very high - risk or residual risk is unacceptable, consider revising to reduce to an acceptable and manageable level, in exceptional circumstances consult with the appointing party to confirm if acceptable due to other factors, can relate to 'very urgent' prioritization during operations; High - consider revising to reduce to an acceptable and manageable level, in exceptional circumstances consult with the appointing party, can relate to 'urgent' prioritization; Moderate - considered permissible given the context, can relate to 'short term' prioritization; Low - permissible given the context, can relate to 'medium term' prioritization; Very low - permitted given the context, can relate to 'long term' prioritization during operations" ;
    iso:nodeId "term_risk_urgency_prioritization" ;
    iso:part "ISO 19650-6" ;
    iso:pdmRelevance "high" ;
    iso:provenanceClause "Annex C; Table C.3" ;

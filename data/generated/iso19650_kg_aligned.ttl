iso:term_security_review a iso:Concept,
        iso:IsoNode ;
    rdfs:label "periodic and event-driven security review" ;
    iso:APPLIES_TO iso:term_appointment,
        iso:term_sensitivity_assessment ;
    iso:CORRESPONDS_TO iso:term_trigger_event ;
    iso:PART_OF iso:term_security_management_plan,
        iso:term_security_strategy ;
    iso:PRECEDES iso:term_security_triage ;
    iso:RESPONDS_TO iso:term_security_breach ;
    iso:definition "suitable mechanism established by the organization(s) for performing periodic and event-driven reviews of the sensitivity assessment (4.6), the security strategy (6.5), the security management plan including the security information requirements and the security breach/incident management plan (7.6), and information sharing agreements (D.1.4), to check that each remains fit for purpose; event-driven reviews are undertaken when political, economic, social, organizational, technological, legal or environmental changes occur that can significantly impact the initiative, project, asset, product or service, when events occur that reveal vulnerabilities not previously anticipated, and upon a security breach or incident" ;
    iso:nodeId "term_security_review" ;
    iso:part "ISO 19650-5" ;
    iso:pdmRelevance "high" ;
    iso:provenanceClause "4.6; 6.5; 7.6; D.1.4" ;

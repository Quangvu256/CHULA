iso:rel_820 a rdf:Statement ;
    iso:provenanceClause "4.3.7" ;
    iso:provenanceStandard "ISO 19650-6" ;
    iso:relationshipNote "Assets, health and safety risks and incidents shall be categorized according to the regional, national or project/asset convention identified in the project/asset information standard." ;
    rdf:object iso:term_hs_risk ;
    rdf:predicate iso:APPLIES_TO ;
    rdf:subject iso:term_hs_categorization .


iso:term_hs_information_sharing a iso:Concept,
        iso:IsoNode ;
    rdfs:label "health and safety information sharing" ;
    iso:APPLIES_TO iso:term_cde ;
    iso:RESPONDS_TO iso:term_security_minded_approach,
        iso:term_third_party_information_provision_assessment ;
    iso:SUPPORTS iso:term_aim_asset_alignment ;
    iso:definition "requirement that appointing parties, lead appointed parties and appointed parties shall share ALL generated health and safety information with ALL parties; lead appointed parties shall consider the need for health and safety information to be shared with other lead appointed parties in order to effectively manage project risks, whether the appointments are concurrent or in parallel; each party shall a) share an analysis of the health and safety risks at the start of their appointment (or upon initiation in the case of the appointing party), b) implement a process enabling health and safety information to be inputted, maintained and extracted through the CDE and/or information models for use by other parties throughout the project and asset life cycle, c) provide health and safety information for other parties and design, construction and operation teams to assess and manage provisions/arrangements/controls, key features, assumptions including required sequences and techniques, and zones/areas/allocated spaces, d) expand, populate and utilize the properties within the relevant information containers to treat, manage and communicate prioritized health and safety risks, risk treatments and incidents, and e) access and reference publicly available information and be familiar with health and safety issues being communicated from within their own organization, industry, professional and statutory bodies, and evaluate the relevance and benefit with regard to the nature of works" ;
    iso:nodeId "term_hs_information_sharing" ;
    iso:part "ISO 19650-6" ;
    iso:pdmRelevance "high" ;
    iso:provenanceClause "4.5.2" ;
    iso:provenanceStandard "ISO 19650-6" ;
    iso:sourceType "body_clause" .


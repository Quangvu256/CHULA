    iso:nodeId "term_aim_asset_alignment" ;
    iso:part "ISO 19650-3" ;
    rdfs:label "AIM-physical asset alignment" ;
    iso:definition "the time interval between changes occurring to the asset and those changes being reflected in the AIM" ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO 19650-3" ;
    iso:provenanceClause "5.1.12 Note 2" .
iso:term_asset_information_protocol a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_asset_information_protocol" ;
    iso:part "ISO 19650-3" ;
    rdfs:label "asset information protocol" ;
    iso:definition "The appointing party shall establish the asset information protocol to set out the rights and obligations of the appointing party and the appointed parties in relation to the AIM, and shall incorporate the information protocol into all appointments." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO 19650-3" ;
    iso:provenanceClause "5.1.13" .

iso:term_security_risk_mitigation_measure iso:SPECIFIED_IN iso:term_security_strategy .
iso:rel_1063 a rdf:Statement ;
    rdfs:label "reference number : 1063" ;
    rdf:subject iso:term_security_risk_mitigation_measure ;

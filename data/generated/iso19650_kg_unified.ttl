    iso:termNo "3.1.1" ;
    iso:sourceType "terms_clause" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO 19650-3" ;
    iso:provenanceClause "3.1.1" .
iso:term_facility_management a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_facility_management" ;
    iso:part "ISO 19650-3" ;
    rdfs:label "facility management" ;
    iso:definition "organizational function which integrates people, place and process within the built environment with the purpose of improving the quality of life of people and the productivity of the core business" ;
    iso:termNo "3.1.2" ;
    iso:sourceType "terms_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO 19650-3" ;
    iso:provenanceClause "3.1.2" .
iso:term_im_process_operational a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_im_process_operational" ;
    iso:part "ISO 19650-3" ;
    rdfs:label "information management process (operational phase)" ;
    iso:definition "The information management process (Figure 4) shall be applied throughout the operational phase of each asset identified through the use of 5.1.3, and in the case of an existing asset shall be applied to all legacy information relating to that asset. The information management process shall operate within or link with such enterprise systems or organizational functions as necessary to optimize its implementation." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO 19650-3" ;
    iso:provenanceClause "4.1; Figure 4" .
iso:decision_trigger_event_path a iso:IsoNode, iso:Concept ;
    iso:nodeId "decision_trigger_event_path" ;
    iso:part "ISO 19650-3" ;
    rdfs:label "Figure 4 decision H - trigger-event information path" ;
    iso:definition "decision point that determines the path by which a trigger event provides information: route M through an appointment made before the trigger, route N through information received from another appointing party or asset owner, or route P through an appointment made after the trigger or a delivery phase using ISO 19650-2" ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO 19650-3" ;
    iso:provenanceClause "Figure 4 (H, M, N, P)" .
iso:route_pre_trigger_appointment a iso:IsoNode, iso:Concept ;
    iso:nodeId "route_pre_trigger_appointment" ;
    iso:part "ISO 19650-3" ;
    rdfs:label "Figure 4 route M - appointment before trigger event" ;
    iso:definition "operational information-management route using an appointment made before the trigger event; procurement and information planning are completed in advance, resources remain ready, and information production starts when the trigger occurs" ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO 19650-3" ;
    iso:provenanceClause "Figure 4 (M); 5.2.2 Note 1; 5.5.4" .
iso:route_external_information_model a iso:IsoNode, iso:Concept ;
    iso:nodeId "route_external_information_model" ;
    iso:part "ISO 19650-3" ;
    rdfs:label "Figure 4 route N - information from another appointing party or asset owner" ;
    iso:definition "asset-acquisition route in which an information model is received from another appointing party or asset owner and proceeds to appointing-party acceptance before AIM aggregation" ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO 19650-3" ;
    iso:provenanceClause "Figure 4 (N, D); 5.7.1" .
iso:route_post_trigger_or_part2 a iso:IsoNode, iso:Concept ;
    iso:nodeId "route_post_trigger_or_part2" ;
    iso:part "ISO 19650-3" ;
    rdfs:label "Figure 4 route P - appointment after trigger or ISO 19650-2 delivery phase" ;
    iso:definition "information-management route using an appointment made after the trigger event or a delivery phase applying ISO 19650-2; procurement, planning and production activities follow the trigger" ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO 19650-3" ;
    iso:provenanceClause "Figure 4 (P, C); 4.2" .
iso:decision_continue_appointment a iso:IsoNode, iso:Concept ;
    iso:nodeId "decision_continue_appointment" ;
    iso:part "ISO 19650-3" ;
    rdfs:label "Figure 4 decision K - continuation of appointment" ;
    iso:definition "decision after AIM aggregation on whether the appointment continues: Q1 means the lead appointed party waits for the next trigger event; Q2 means it progresses to the next delivery milestone; R means no and the process proceeds to decision L" ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO 19650-3" ;
    iso:provenanceClause "Figure 4 (K, Q1, Q2, R)" .
iso:decision_continue_information_management a iso:IsoNode, iso:Concept ;
    iso:nodeId "decision_continue_information_management" ;
    iso:part "ISO 19650-3" ;
    rdfs:label "Figure 4 decision L - continuation of information-management process" ;
    iso:definition "decision on whether the information-management process continues: Q3 means the appointing party still has responsibility for the asset and returns to assessment and need; R means no and the process ends" ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO 19650-3" ;
    iso:provenanceClause "Figure 4 (L, Q3, R)" .

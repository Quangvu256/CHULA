    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO 19650-2" ;
    iso:provenanceClause "5.5; 5.5.4; Figure 3 (5); Figure 8" .
iso:activity_collaborative_production_of_information_delivery a iso:IsoNode, iso:Activity ;

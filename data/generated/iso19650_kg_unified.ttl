    iso:nodeId "activity_assessment_and_need_delivery" ;
    iso:part "ISO 19650-2" ;
    rdfs:label "assessment and need (delivery phase)" ;
    iso:definition "Information management process - Assessment and need [...] Appoint individuals to undertake the information management function [...] Establish the project's information requirements [...] Establish the project's information delivery milestones [...] Establish the project's information standard [...] Establish the project's information production methods and procedures [...] Establish the project's reference information and shared resources [...] Establish the project's common data environment [...] Establish the project's information protocol" ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO 19650-2" ;
    iso:provenanceClause "5.1; 5.1.9; Figure 3 (1); Figure 4" .
iso:activity_invitation_to_tender_delivery a iso:IsoNode, iso:Activity ;
    iso:nodeId "activity_invitation_to_tender_delivery" ;
    iso:part "ISO 19650-2" ;
    rdfs:label "invitation to tender (delivery phase)" ;
    iso:definition "Information management process - Invitation to tender [...] Establish the appointing party's exchange information requirements [...] Assemble reference information and shared resources [...] Establish tender response requirements and evaluation criteria [...] Compile invitation to tender information" ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO 19650-2" ;
    iso:provenanceClause "5.2; 5.2.5; Figure 3 (2); Figure 5" .
iso:activity_tender_response_delivery a iso:IsoNode, iso:Activity ;
    iso:nodeId "activity_tender_response_delivery" ;
    iso:part "ISO 19650-2" ;
    rdfs:label "tender response (delivery phase)" ;
    iso:definition "Information management process - Tender response [...] Nominate individuals to undertake the information management function [...] Establish the delivery team's (pre-appointment) BIM execution plan [...] Assess task team capability and capacity [...] Establish the delivery team's capability and capacity [...] Establish the delivery team's mobilization plan [...] Establish the delivery team's risk register [...] Compile the delivery team's tender response" ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO 19650-2" ;
    iso:provenanceClause "5.3; 5.3.8; Figure 3 (3); Figure 6" .

    iso:nodeId "term_security_risk" ;
    iso:part "ISO 19650-5" ;
    rdfs:label "security risk" ;
    iso:definition "shall assess the specific security risks arising from the greater availability of information, integration of services and systems, and the increased dependency on technology-based systems, by assessing: a) the potential threats" ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO 19650-5" ;
    iso:provenanceClause "6.2; 4.2.1" .

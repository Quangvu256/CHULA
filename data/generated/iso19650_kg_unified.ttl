    rdfs:label "health and safety supporting evidence" ;
    iso:definition "The following requirements for evidence supporting the delivered information shall be considered: a) evidence to support 5.4.2 and 5.4.3; b) evidence of compliance with legislative obligations and duties." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO 19650-6" ;

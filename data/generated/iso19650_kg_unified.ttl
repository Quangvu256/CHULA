    iso:nodeId "activity_appointment_delivery" ;
    iso:part "ISO 19650-2" ;
    rdfs:label "appointment (delivery phase)" ;
    iso:definition "Information management process - Appointment [...] Confirm the delivery team's BIM execution plan [...] Establish the delivery team's detailed responsibility matrix [...] Establish the lead appointed party's exchange information requirements [...] Establish the task information delivery plan(s) [...] Establish the master information delivery plan [...] Complete lead appointed party's appointment documents [...] Complete appointed party's appointment documents" ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO 19650-2" ;
    iso:provenanceClause "5.4; 5.4.8; Figure 3 (4); Figure 7" .
iso:activity_mobilization_delivery a iso:IsoNode, iso:Activity ;

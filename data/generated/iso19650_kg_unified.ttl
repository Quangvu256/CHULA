    iso:nodeId "term_construction_operation_sequencing_model" ;
    iso:part "ISO 19650-6" ;
    rdfs:label "construction and operation sequencing model" ;
    iso:definition "sequencing model(s) can be used to support the development and visualization of safe methods of access and working, including implications of working at height, temporary works, exclusion zones, restricted areas and works with a permit system." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO 19650-6" ;
    iso:provenanceClause "4.3.6 NOTE; 4.5.3; 6.2" .
iso:term_buildability_maintainability_review a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_buildability_maintainability_review" ;
    iso:part "ISO 19650-6" ;
    rdfs:label "buildability and maintainability review" ;
    iso:definition "Each appointed party shall review whether their proposals are buildable and maintainable to identify and evaluate: a) hazards to be eliminated by informed decisions" ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO 19650-6" ;
    iso:provenanceClause "4.5.4" .
iso:term_design_factor_learning a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_design_factor_learning" ;
    iso:part "ISO 19650-6" ;
    rdfs:label "incident-to-design-factor learning" ;

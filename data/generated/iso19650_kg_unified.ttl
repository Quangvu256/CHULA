iso:term_stage a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_stage" ;
    iso:part "ISO 19650-4" ;
    rdfs:label "stage" ;
    iso:definition "distinct period in a project used as a management tool" ;
    iso:termNo "3.1.1" ;
    iso:sourceType "terms_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO 19650-4" ;
    iso:provenanceClause "3.1.1" .
iso:term_information_provider a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_information_provider" ;
    iso:part "ISO 19650-4" ;
    rdfs:label "information provider" ;
    iso:definition "actor who provides information in an information container" ;
    iso:termNo "3.2.1" ;
    iso:sourceType "terms_clause" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO 19650-4" ;
    iso:provenanceClause "3.2.1" .
iso:term_information_receiver a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_information_receiver" ;
    iso:part "ISO 19650-4" ;
    rdfs:label "information receiver" ;
    iso:definition "actor who receives information in an information container" ;
    iso:termNo "3.2.2" ;
    iso:sourceType "terms_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO 19650-4" ;
    iso:provenanceClause "3.2.2" .
iso:term_information_reviewer a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_information_reviewer" ;
    iso:part "ISO 19650-4" ;
    rdfs:label "information reviewer" ;
    iso:definition "actor who reviews information and its information container" ;
    iso:termNo "3.2.3" ;
    iso:sourceType "terms_clause" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO 19650-4" ;
    iso:provenanceClause "3.2.3" .
iso:term_information_exchange_process a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_information_exchange_process" ;
    iso:part "ISO 19650-4" ;
    rdfs:label "information exchange process" ;
    iso:definition "Each information exchange, whether executed during or at the end of a stage or trigger event, shall be executed as specified in ISO 19650-2: 2018, 5.6 and 5.7 or ISO 19650-3:2020, 5.6 and the associated governance arrangements, as summarized in Figure 1. Each process is detailed in Clause 5, each decision in Clause 6 and the criteria in Clause 7." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO 19650-4" ;
    iso:provenanceClause "4; Figure 1" .
iso:term_exchange_mobilization_testing a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_exchange_mobilization_testing" ;
    iso:part "ISO 19650-4" ;
    rdfs:label "mobilization and testing prior to information exchange" ;
    iso:definition "The methods and procedures of undertaking an information exchange shall be tested to ensure flow of information, prior to finalizing requirements and exchanging deliverables. [...] The information provider shall review and confirm the selected authoring software to use during mobilization" ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO 19650-4" ;
    iso:provenanceClause "5.1.2" .
iso:decision_a_approve_sharing a iso:IsoNode, iso:Concept ;
    iso:nodeId "decision_a_approve_sharing" ;
    iso:part "ISO 19650-4" ;
    rdfs:label "decision A - approve for sharing" ;
    iso:definition "An information provider shall review their information using the criteria in Clause 7 prior to either withholding or granting approval for the information to transition to the shared state" ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO 19650-4" ;
    iso:provenanceClause "6.1; Figure 1 (A)" .
iso:decision_b_authorize_accept_publication a iso:IsoNode, iso:Concept ;
    iso:nodeId "decision_b_authorize_accept_publication" ;
    iso:part "ISO 19650-4" ;
    rdfs:label "decision B - authorize and accept for publication" ;
    iso:definition "The information receiver shall review an information container using the criteria in Clause 7. The information receiver shall either reject or authorize and accept for the published state" ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO 19650-4" ;
    iso:provenanceClause "6.2; Figure 1 (B)" .
iso:term_exchange_review_criteria a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_exchange_review_criteria" ;
    iso:part "ISO 19650-4" ;
    rdfs:label "criteria for reviewing an information exchange" ;
    iso:definition "An information reviewer shall support or endorse the information exchange prior to decision A on sharing [...] if the acceptance criteria in Clause 7 are met, or otherwise raise the pertinent issues for resolution [...] All the criteria shall be applied to each information container, except as allowed in 6.4." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO 19650-4" ;
    iso:provenanceClause "6.3; Clause 7; Figure 3" .
iso:term_exchange_review_exception a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_exchange_review_exception" ;
    iso:part "ISO 19650-4" ;
    rdfs:label "information exchange review exception" ;
    iso:definition "The review process may exclude information containers that are not subject to revision or change as long as the quality, naming and associated metadata are checked by the information receivers." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO 19650-4" ;
    iso:provenanceClause "6.4; Figure 1 (a2)" .
iso:criterion_cde a iso:IsoNode, iso:Concept ;
    iso:nodeId "criterion_cde" ;
    iso:part "ISO 19650-4" ;
    rdfs:label "review criterion - common data environment (CDE)" ;
    iso:definition "The information reviewer shall check that the naming and metadata requirements of the CDE are correctly applied to the information container. [...] The information reviewer shall check that security and handling requirements have not been breached, especially relating to the visibility of the information container to others." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO 19650-4" ;
    iso:provenanceClause "7.1" .
iso:criterion_conformance a iso:IsoNode, iso:Concept ;
    iso:nodeId "criterion_conformance" ;
    iso:part "ISO 19650-4" ;
    rdfs:label "review criterion - conformance" ;
    iso:definition "against the chosen exchange schema and data format" ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO 19650-4" ;
    iso:provenanceClause "7.2" .
iso:criterion_continuity a iso:IsoNode, iso:Concept ;
    iso:nodeId "criterion_continuity" ;
    iso:part "ISO 19650-4" ;
    rdfs:label "review criterion - continuity" ;
    iso:definition "The information reviewer shall check for the continuity of the content compared with: other information containers; previous versions of the current information container; previous status changes; previous delivery stages and operational trigger events; previous delivery or operational phases" ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO 19650-4" ;
    iso:provenanceClause "7.3" .
iso:criterion_communication a iso:IsoNode, iso:Concept ;
    iso:nodeId "criterion_communication" ;
    iso:part "ISO 19650-4" ;
    rdfs:label "review criterion - communication" ;
    iso:definition "degradation or loss due to translation or conversion. [...] The information reviewer shall consider effects of information degradation due to changes of: da" ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO 19650-4" ;
    iso:provenanceClause "7.4" .
iso:criterion_consistency a iso:IsoNode, iso:Concept ;
    iso:nodeId "criterion_consistency" ;
    iso:part "ISO 19650-4" ;
    rdfs:label "review criterion - consistency" ;
    iso:definition "internal consistency with any referenced information containers in terms of: spatial, physical and process consistency including the absence of duplication and conflicts such as overlaps or gaps; attribute and property consistency such as contradictions; gaps or overlaps with adjacent information containers within the federation strategy" ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO 19650-4" ;
    iso:provenanceClause "7.5" .
iso:criterion_completeness a iso:IsoNode, iso:Concept ;
    iso:nodeId "criterion_completeness" ;
    iso:part "ISO 19650-4" ;
    rdfs:label "review criterion - completeness" ;
    iso:definition "presence and adequacy of the information against the level of information need specified by the EIR and any additional expectations. [...] An information reviewer shall consider the following three requirements: to satisfy the purposes associated to the immediate delive" ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO 19650-4" ;
    iso:provenanceClause "7.6" .
iso:criterion_other a iso:IsoNode, iso:Concept ;
    iso:nodeId "criterion_other" ;
    iso:part "ISO 19650-4" ;
    rdfs:label "review criterion - other (informative)" ;
    iso:definition "The information reviewer can also check for satisfaction of the asset delivery and/or operational requirements using judgement and analysis tools as appropriate." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO 19650-4" ;
    iso:provenanceClause "7.7" .
iso:term_change_action_process a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_change_action_process" ;
    iso:part "ISO 19650-4" ;
    rdfs:label "change action process" ;
    iso:definition "Change action can be required from issues and risks detected at decision A [...] Identify issues and risks [...] Allocate issues and risks [...] Implement changes" ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO 19650-4" ;
    iso:provenanceClause "5.4; Figure 2" .
iso:term_exchange_issue a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_exchange_issue" ;
    iso:part "ISO 19650-4" ;
    rdfs:label "information exchange issue" ;
    iso:definition "An information reviewer shall review the information to identify any issues and risks relevant to the purpose [...] An information reviewer shall document all identified issues and risks for revision and corrective actions to the lead appointed party or as set out in the appointment." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO 19650-4" ;
    iso:provenanceClause "5.4.2; 5.4.3" .
iso:term_open_schema_standard a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_open_schema_standard" ;
    iso:part "ISO 19650-4" ;
    rdfs:label "open schema standard" ;
    iso:definition "Table A.1 provides examples of open schemas enabling interoperability." ;
    iso:sourceType "informative_annex" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO 19650-4" ;
    iso:provenanceClause "Annex A.1; Table A.1" .
iso:term_open_data_format a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_open_data_format" ;
    iso:part "ISO 19650-4" ;
    rdfs:label "open data format standard" ;
    iso:definition "provides examples of open data formats enabling interoperability." ;
    iso:sourceType "informative_annex" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO 19650-4" ;
    iso:provenanceClause "Annex A.2; Table A.2" .
iso:term_bcf_issue_format a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_bcf_issue_format" ;
    iso:part "ISO 19650-4" ;
    rdfs:label "BCF issue exchange format" ;
    iso:definition "(BCF) is an international industry consensus specified open schema and data format for the identification, communication and exchange of issues." ;
    iso:sourceType "informative_annex" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO 19650-4" ;
    iso:provenanceClause "Annex A.2; 5.4.3" .


    iso:nodeId "term_hs_classification_health" ;
    iso:part "ISO 19650-6" ;
    rdfs:label "health issue" ;
    iso:definition "first top-level category of the example health and safety classification: 11 material effect (111 asbestos effect, 112 lead effect, 113 hazardous dust with 1131 wood dust and 1132 silica dust, 114 chemical effect); 12 mechanical effect (121 noise, 122 loss of control using hand or power tool, 123 vibration)" ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO 19650-6" ;

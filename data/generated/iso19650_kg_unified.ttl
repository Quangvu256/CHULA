    iso:nodeId "function_security_management" ;
    iso:part "ISO 19650-5" ;
    rdfs:label "security management function" ;
    iso:definition "holistic view of the security threats and vulnerabilities arising out of the use of, and reliance on, information and communications technologies relevant to the initiative, project, asset, product or service; b) offering guidance and direction on the handling of the resultant security risks; c) managing the development of a security strategy" ;

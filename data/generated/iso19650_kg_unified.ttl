iso:term_level_of_information_need a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_level_of_information_need" ;
    iso:part "ISO 19650-1" ;
    rdfs:label "level of information need" ;
    iso:definition "framework which defines the extent and granularity of information [...] The level of information need of each information deliverable should be determined according to its purpose. This should include the appropriate determination of quality, quantity and granularity of information. [...] The levels of information need should be determined by the minimum amount of information needed to answer each relevant requ" ;

    iso:nodeId "term_post_incident_review" ;
    iso:part "ISO 19650-5" ;
    rdfs:label "post-incident review" ;
    iso:definition "Following the initial containment and recovery actions, the organization(s) shall undertake an assessment of the ongoing risk" ;

    iso:part "ISO 19650-2" ;
    rdfs:label "information model delivery (delivery phase)" ;
    iso:definition "Information management process - Information model delivery [...] Submit information model for lead appointed party authorization [...] Review and authorize the information model [...] Submit information model for appointing party acceptance [...] Review and accept the information model" ;

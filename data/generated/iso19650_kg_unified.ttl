    iso:nodeId "term_tolerated_security_risk" ;
    iso:part "ISO 19650-5" ;
    rdfs:label "tolerated security risk" ;
    iso:definition "Following the development of the security mitigation measures, the organization(s) shall identify and record any residual security risks. [...] The organization(s) shall continue the processes of assessing the security risk and developing security risk mitigation measur" ;

    rdf:predicate iso:PART_OF ;
    rdf:object iso:term_security_strategy ;
    iso:provenanceStandard "ISO 19650-5" ;
    iso:provenanceClause "6.1.1 e); 6.4.3" .
iso:term_risk_appetite iso:GOVERNS iso:term_tolerated_security_risk .

    iso:pdmRelevance "low" ;
    iso:provenanceStandard "ISO/IEC 30173:2023" ;
    iso:provenanceClause "5.3.1.2" .
iso:term_dt_life_cycle_process a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_dt_life_cycle_process" ;
    iso:part "ISO/IEC 30173" ;
    rdfs:label "digital twin life cycle process" ;
    iso:definition "The life cycle of a digital entity shall include inception, design and development, verification and validation, deployment, operation and monitoring, re-evaluation and retirement." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO/IEC 30173:2023" ;
    iso:provenanceClause "5.6" .
iso:term_component_digital_twin a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_component_digital_twin" ;
    iso:part "ISO/IEC 30173" ;
    rdfs:label "component digital twin" ;
    iso:definition "The component digital twin is typically a major element that has a significant impact on the performance of the target entity to which it belongs." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO/IEC 30173:2023" ;
    iso:provenanceClause "5.7.2" .
iso:term_asset_digital_twin a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_asset_digital_twin" ;
    iso:part "ISO/IEC 30173" ;
    rdfs:label "asset digital twin" ;
    iso:definition "Asset digital twin can be collections of component digital twins and can consist of component digital twins. Asset digital twins provide visibility at the unit level." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO/IEC 30173:2023" ;
    iso:provenanceClause "5.7.3" .
iso:term_system_digital_twin a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_system_digital_twin" ;
    iso:part "ISO/IEC 30173" ;
    rdfs:label "system digital twin" ;
    iso:definition "A system digital twin is a collection of target entities and digital entities that together perform a system- or network-wide function. A system digital twin provides visibility into a set of interconnected or interdependent target entities." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO/IEC 30173:2023" ;
    iso:provenanceClause "5.7.4" .
iso:term_process_digital_twin a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_process_digital_twin" ;
    iso:part "ISO/IEC 30173" ;
    rdfs:label "process digital twin" ;
    iso:definition "A process digital twin is a digital twin that provides a view into a set of activities or operations." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO/IEC 30173:2023" ;
    iso:provenanceClause "5.7.5" .
iso:function_dt_stakeholder a iso:IsoNode, iso:Function ;
    iso:nodeId "function_dt_stakeholder" ;
    iso:part "ISO/IEC 30173" ;
    rdfs:label "digital twin stakeholder" ;
    iso:definition "stakeholders that play distinct organizational roles in the digital twin value chain, including digital twin system stakeholders (6.2) and ecosystem partners (6.3)" ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "low" ;
    iso:provenanceStandard "ISO/IEC 30173:2023" ;
    iso:provenanceClause "6.1" .
iso:term_dt_functional_loop a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_dt_functional_loop" ;
    iso:part "ISO/IEC 30173" ;
    rdfs:label "digital twin functional loop" ;
    iso:definition "Digital twin systems can be created by digitalizing and simulating target entities in the digital domain, establishing connections between the target entities and digital entities, and forming a closed or open loop by gathering data from the physical domain, integrating optimization in the digital domain, then making decisions, and applying adjustments to the physical domain based on those decisions." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO/IEC 30173:2023" ;
    iso:provenanceClause "Clause 7" .


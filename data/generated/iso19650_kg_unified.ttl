iso:term_federation_strategy a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_federation_strategy" ;
    iso:part "ISO 19650-1" ;
    rdfs:label "federation strategy" ;
    iso:definition "The federation strategy should be developed during information planning activities. It should explain how the information model is intended to be divided into one or more sets of information containers. Allocation can be done by viewing the information model in different views, such as functional, spatial or geometrical." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO 19650-1" ;
    iso:provenanceClause "10.4; Annex A" .
iso:term_information_container_breakdown_structure a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_information_container_breakdown_structure" ;
    iso:part "ISO 19650-1" ;
    rdfs:label "information container breakdown structure" ;
    iso:definition "The purpose of the federation strategy and the information container breakdown structure is to help plan the production of information by separate task teams to the appropriate level of information need [...] The federation strategy and information container breakdown structure should be updated as new task teams are appointed." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO 19650-1" ;
    iso:provenanceClause "10.4" .
iso:state_work_in_progress a iso:IsoNode, iso:State ;
    iso:nodeId "state_work_in_progress" ;
    iso:part "ISO 19650-1" ;
    rdfs:label "work in progress" ;
    iso:definition "The work in progress state is used for information while it is being developed by its task team. An information container in this state should not be visible or accessible to any other task team." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "low" ;
    iso:provenanceStandard "ISO 19650-1" ;
    iso:provenanceClause "12.2" .
iso:state_shared a iso:IsoNode, iso:State ;
    iso:nodeId "state_shared" ;
    iso:part "ISO 19650-1" ;
    rdfs:label "shared" ;
    iso:definition "The purpose of the shared state is to enable constructive and collaborative development of the information model within a delivery team. [...] The shared state is also used for information containers that have been approved for sharing with the appointing party and are ready for authorization." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO 19650-1" ;
    iso:provenanceClause "12.4" .
iso:state_published a iso:IsoNode, iso:State ;
    iso:nodeId "state_published" ;
    iso:part "ISO 19650-1" ;
    rdfs:label "published" ;
    iso:definition "The published state is used for information that has been authorized for use, for example in the construction of a new project or in the operation of an asset. The PIM at the end of a project or the AIM during asset operation contains only information in the published state or the archive state." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO 19650-1" ;
    iso:provenanceClause "12.6" .
iso:state_archive a iso:IsoNode, iso:State ;
    iso:nodeId "state_archive" ;
    iso:part "ISO 19650-1" ;
    rdfs:label "archive" ;
    iso:definition "The archive state is used to hold a journal of all information containers that have been shared and published during the information management process as well as an audit trail of their development." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO 19650-1" ;
    iso:provenanceClause "12.7" .
iso:term_information_delivery_plan a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_information_delivery_plan" ;
    iso:part "ISO 19650-1" ;
    rdfs:label "information delivery plan" ;
    iso:definition "Planning for information delivery is the responsibility of each lead appointed party and appointed party. Plans should be formulated in response to the information requirements set out by the appointing party and should reflect the scope of the appointment within the overall asset life cycle. [...] An information delivery plan should be defined for the whole project or for the short and medium term of asset management according to the schedule and appointment of the parties." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO 19650-1" ;
    iso:provenanceClause "10.1; 10.2" .
iso:term_revision_code a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_revision_code" ;
    iso:part "ISO 19650-1" ;
    rdfs:label "revision code" ;
    iso:definition "a revision code, in accordance with an agreed standard for example IEC 82045-1 [...] Metadata is initially indicated by its author and then amended by the approval and authorization processes." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO 19650-1" ;
    iso:provenanceClause "12.1" .
iso:term_information_management a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_information_management" ;
    iso:part "ISO 19650-1" ;
    rdfs:label "information management" ;
    iso:definition "management and production of information during the life cycle of built assets (referred to as \"information management\") when using building information modelling (BIM). These processes can deliver beneficial business outcomes to asset owners/operators, clients, their supply chains and those involved in project funding including increase of opportunity, reduction of risk and reduction of cost" ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO 19650-1" ;
    iso:provenanceClause "Introduction; 13" .
iso:purpose_asset_register a iso:IsoNode, iso:Purpose ;
    iso:nodeId "purpose_asset_register" ;
    iso:part "ISO 19650-1" ;
    rdfs:label "asset register" ;
    iso:definition "a register of assets should be provided to support accurate auditing and reporting; this should include both spatial and physical assets and their groupings" ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO 19650-1" ;
    iso:provenanceClause "5.1" .
iso:purpose_compliance_regulatory a iso:IsoNode, iso:Purpose ;
    iso:nodeId "purpose_compliance_regulatory" ;
    iso:part "ISO 19650-1" ;
    rdfs:label "support for compliance and regulatory responsibilities" ;
    iso:definition "the appointing party should specify the information required to support the maintenance of the health and safety of the users of the asset" ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO 19650-1" ;
    iso:provenanceClause "5.1" .
iso:purpose_risk_management a iso:IsoNode, iso:Purpose ;
    iso:nodeId "purpose_risk_management" ;
    iso:part "ISO 19650-1" ;
    rdfs:label "risk management" ;
    iso:definition "information should be required or suppressed to support risk management, especially to identify and review the risks that a project or asset can be exposed to, for example natural hazards, extreme weather events or fire" ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO 19650-1" ;
    iso:provenanceClause "5.1" .
iso:purpose_business_questions a iso:IsoNode, iso:Purpose ;
    iso:nodeId "purpose_business_questions" ;
    iso:part "ISO 19650-1" ;
    rdfs:label "support for business questions" ;
    iso:definition "support for business questions: the appointing party should specify the information required to support the review of the business case for ownership and operation of the asset" ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO 19650-1" ;
    iso:provenanceClause "5.1" .
iso:purpose_capacity_utilization a iso:IsoNode, iso:Purpose ;
    iso:nodeId "purpose_capacity_utilization" ;
    iso:part "ISO 19650-1" ;
    rdfs:label "management of capacity and utilization" ;
    iso:definition "documentation of the intended capacity and utilization of the asset should be provided as it is required to support comparisons of actual use and utilization and portfolio management" ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO 19650-1" ;
    iso:provenanceClause "5.1" .
iso:purpose_security_surveillance a iso:IsoNode, iso:Purpose ;
    iso:nodeId "purpose_security_surveillance" ;
    iso:part "ISO 19650-1" ;
    rdfs:label "management of security and surveillance" ;
    iso:definition "information should be required or suppressed to support the management of the security and surveillance of the asset and neighbouring or adjacent sites in line with security requirements" ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "low" ;
    iso:provenanceStandard "ISO 19650-1" ;
    iso:provenanceClause "5.1" .
iso:purpose_renovation a iso:IsoNode, iso:Purpose ;
    iso:nodeId "purpose_renovation" ;
    iso:part "ISO 19650-1" ;
    rdfs:label "support for renovation" ;
    iso:definition "renovation of each space or location and the whole asset should be supported with detailed information about the capacity, in terms of areas, spaces, occupancy, environmental conditions and structural load bearing" ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO 19650-1" ;
    iso:provenanceClause "5.1" .
iso:purpose_predicted_actual_impacts a iso:IsoNode, iso:Purpose ;
    iso:nodeId "purpose_predicted_actual_impacts" ;
    iso:part "ISO 19650-1" ;
    rdfs:label "predicted and actual impacts" ;
    iso:definition "the appointing party should require information relating to the impacts from quality, cost, scheduling, carbon (CO2e), energy, waste, water consumption or other environmental effects" ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO 19650-1" ;
    iso:provenanceClause "5.1" .
iso:purpose_operations a iso:IsoNode, iso:Purpose ;
    iso:nodeId "purpose_operations" ;
    iso:part "ISO 19650-1" ;
    rdfs:label "operations" ;
    iso:definition "information necessary for the normal operations of the asset should be provided to help the appointing party anticipate the cost of asset operation" ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO 19650-1" ;
    iso:provenanceClause "5.1" .
iso:purpose_maintenance_repair a iso:IsoNode, iso:Purpose ;
    iso:nodeId "purpose_maintenance_repair" ;
    iso:part "ISO 19650-1" ;
    rdfs:label "maintenance and repair" ;
    iso:definition "information on the recommended maintenance tasks, including planned preventative maintenance, should be provided to help the appointing party to anticipate and plan for costs of maintenance" ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO 19650-1" ;
    iso:provenanceClause "5.1" .
iso:purpose_replacement a iso:IsoNode, iso:Purpose ;
    iso:nodeId "purpose_replacement" ;
    iso:part "ISO 19650-1" ;
    rdfs:label "replacement" ;
    iso:definition "information on the reference or expected replacement service life and costs should be available to the appointing party to anticipate the costs of replacement; recycling of the physical assets should be supported with detailed information relating to the principal constituent materials" ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO 19650-1" ;
    iso:provenanceClause "5.1" .
iso:purpose_decommissioning_disposal a iso:IsoNode, iso:Purpose ;
    iso:nodeId "purpose_decommissioning_disposal" ;
    iso:part "ISO 19650-1" ;
    rdfs:label "decommissioning and disposal" ;
    iso:definition "information on the recommended decommissioning should be provided to help the appointing party anticipate and plan for end-of-life costs" ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO 19650-1" ;
    iso:provenanceClause "5.1" .
iso:perspective_asset_owner a iso:IsoNode, iso:Perspective ;
    iso:nodeId "perspective_asset_owner" ;
    iso:part "ISO 19650-1" ;
    rdfs:label "asset owner's perspective" ;
    iso:definition "To establish and maintain the purpose of the asset or project." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO 19650-1" ;
    iso:provenanceClause "4.3; Table 1" .
iso:perspective_asset_user a iso:IsoNode, iso:Perspective ;
    iso:nodeId "perspective_asset_user" ;
    iso:part "ISO 19650-1" ;
    rdfs:label "asset user's perspective" ;
    iso:definition "To identify the true requirements of the user" ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO 19650-1" ;
    iso:provenanceClause "4.3; Table 1" .
iso:perspective_project_delivery a iso:IsoNode, iso:Perspective ;
    iso:nodeId "perspective_project_delivery" ;
    iso:part "ISO 19650-1" ;
    rdfs:label "project delivery or asset management perspective" ;
    iso:definition "To plan and organize the work, mobilize the right resources, coordinate and control development." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "low" ;
    iso:provenanceStandard "ISO 19650-1" ;
    iso:provenanceClause "4.3; Table 1" .
iso:perspective_society a iso:IsoNode, iso:Perspective ;
    iso:nodeId "perspective_society" ;
    iso:part "ISO 19650-1" ;
    rdfs:label "society's perspective" ;
    iso:definition "To make sure the community's interest is taken care of during the asset life cycle" ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "low" ;
    iso:provenanceStandard "ISO 19650-1" ;
    iso:provenanceClause "4.3; Table 1" .
iso:function_asset_information_management a iso:IsoNode, iso:Function ;
    iso:nodeId "function_asset_information_management" ;
    iso:part "ISO 19650-1" ;
    rdfs:label "asset information management function" ;
    iso:definition "In relation to assets, asset information management can be assigned to one or more individuals from the appointing party's staff. Asset information management involves leadership in validating information supplied from each appointed party and leadership in authorizing it for inclusion in the AIM." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO 19650-1" ;
    iso:provenanceClause "7.1; 7.2" .
iso:function_project_information_management a iso:IsoNode, iso:Function ;
    iso:nodeId "function_project_information_management" ;
    iso:part "ISO 19650-1" ;
    rdfs:label "project information management function" ;
    iso:definition "Project information management involves leadership in establishing the project's information standard, the production methods and procedures, and the project's CDE. [...] The complexity of project information management functions should reflect the extent and complexity of project information." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "low" ;
    iso:provenanceStandard "ISO 19650-1" ;
    iso:provenanceClause "7.3" .
iso:function_task_information_management a iso:IsoNode, iso:Function ;
    iso:nodeId "function_task_information_management" ;
    iso:part "ISO 19650-1" ;
    rdfs:label "task information management function" ;
    iso:definition "Where delivery teams are sub-divided into task teams, information management functions should be assigned for each task team. Information management at a task team level is concerned both with the information associated with that task and with the requirement to coordinate information across multiple tasks." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "low" ;
    iso:provenanceStandard "ISO 19650-1" ;
    iso:provenanceClause "7.4" .
iso:principle_delivery_cycle_1 a iso:IsoNode, iso:Principle ;
    iso:nodeId "principle_delivery_cycle_1" ;
    iso:part "ISO 19650-1" ;
    rdfs:label "information needed across whole asset life cycle" ;
    iso:definition "information is needed for decision-making during all parts of the asset life cycle, including when there is an intention to develop a new asset, modify or enhance an existing asset, or decommission an asset, all as part of the overall asset management system" ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO 19650-1" ;
    iso:provenanceClause "6.1" .
iso:principle_delivery_cycle_2 a iso:IsoNode, iso:Principle ;
    iso:nodeId "principle_delivery_cycle_2" ;
    iso:part "ISO 19650-1" ;
    rdfs:label "progressive specification and delivery of information" ;
    iso:definition "Information is specified progressively through sets of requirements defined by the appointing party, and the delivery of information is planned and progressively delivered by the delivery teams. In addition, some reference information can also be provided by the appointing party to one or more appointed parties." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "low" ;
    iso:provenanceStandard "ISO 19650-1" ;
    iso:provenanceClause "6.1" .
iso:principle_delivery_cycle_3 a iso:IsoNode, iso:Principle ;
    iso:nodeId "principle_delivery_cycle_3" ;
    iso:part "ISO 19650-1" ;
    rdfs:label "requirements passed to the most relevant party" ;
    iso:definition "where a delivery team contains more than one party then information requirements should be passed to the most relevant party or the point at which the information can be most easily provided" ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "low" ;
    iso:provenanceStandard "ISO 19650-1" ;
    iso:provenanceClause "6.1" .
iso:principle_delivery_cycle_4 a iso:IsoNode, iso:Principle ;
    iso:nodeId "principle_delivery_cycle_4" ;
    iso:part "ISO 19650-1" ;
    rdfs:label "information exchange through a CDE with open standards" ;
    iso:definition "information exchange involves the sharing and coordination of information through a CDE, using open standards whenever possible and clearly defined operating procedures to enable a consistent approach by all organizations involved" ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO 19650-1" ;
    iso:provenanceClause "6.1" .
iso:principle_collab_a a iso:IsoNode, iso:Principle ;
    iso:nodeId "principle_collab_a" ;
    iso:part "ISO 19650-1" ;
    rdfs:label "authors control and check their own information" ;
    iso:definition "authors produce information, subject to intellectual property agreements, which they control and check, only sourcing approved information from others where required by way of reference, federation or direct information exchange" ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "low" ;
    iso:provenanceStandard "ISO 19650-1" ;
    iso:provenanceClause "9" .
iso:principle_collab_b a iso:IsoNode, iso:Principle ;
    iso:nodeId "principle_collab_b" ;
    iso:part "ISO 19650-1" ;
    rdfs:label "clearly defined information requirements" ;
    iso:definition "provision of clearly defined information requirements at high level, by interested parties associated with the project or asset, and at detailed level by the appointing party" ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "low" ;
    iso:provenanceStandard "ISO 19650-1" ;
    iso:provenanceClause "9" .
iso:principle_collab_c a iso:IsoNode, iso:Principle ;
    iso:nodeId "principle_collab_c" ;
    iso:part "ISO 19650-1" ;
    rdfs:label "review of delivery team approach, capability and capacity before appointment" ;
    iso:definition "consideration of the proposed approach, capability and capacity of each delivery team prior to appointment by an appointing party against the requirements" ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "low" ;
    iso:provenanceStandard "ISO 19650-1" ;
    iso:provenanceClause "9" .
iso:principle_collab_d a iso:IsoNode, iso:Principle ;
    iso:nodeId "principle_collab_d" ;
    iso:part "ISO 19650-1" ;
    rdfs:label "provision of a CDE for shared information" ;
    iso:definition "provision of a CDE to manage and store shared information, with appropriate and secure availability to all individuals or parties who are required to produce, use and maintain that information" ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO 19650-1" ;
    iso:provenanceClause "9" .
iso:principle_collab_e a iso:IsoNode, iso:Principle ;
    iso:nodeId "principle_collab_e" ;
    iso:part "ISO 19650-1" ;
    rdfs:label "conforming technologies" ;
    iso:definition "information models to be developed using technologies that are able to conform to this document" ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "low" ;
    iso:provenanceStandard "ISO 19650-1" ;
    iso:provenanceClause "9" .
iso:principle_collab_f a iso:IsoNode, iso:Principle ;
    iso:nodeId "principle_collab_f" ;
    iso:part "ISO 19650-1" ;
    rdfs:label "whole-life information security processes" ;
    iso:definition "processes related to security of information should be put in place during the whole life time of the asset to address issues such as unauthorized access, information loss or corruption, degradation and, as far as is practicable, obsolescence" ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO 19650-1" ;
    iso:provenanceClause "9" .
iso:term_maturity_stage_1 a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_maturity_stage_1" ;
    iso:part "ISO 19650-1" ;
    rdfs:label "maturity stage 1" ;
    iso:definition "information management based on national standards; file/model/container and information management technology based CDE; structured data (geometrical models, schedules and databases) and unstructured data (documentation, video clips and sound recordings)" ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "low" ;
    iso:provenanceStandard "ISO 19650-1" ;
    iso:provenanceClause "4.2; Figure 1" .
iso:term_maturity_stage_2 a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_maturity_stage_2" ;
    iso:part "ISO 19650-1" ;
    rdfs:label "maturity stage 2" ;
    iso:definition "information management applying ISO 19650-1 and ISO 19650-2 with regional/national annexes; federated information models; identified as 'BIM according to the ISO 19650 series' - a mixture of manual and automated information management processes used to generate a federated information model including all information containers delivered by task teams in relation to an asset or a project" ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO 19650-1" ;
    iso:provenanceClause "4.2; Figure 1" .
iso:term_maturity_stage_3 a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_maturity_stage_3" ;
    iso:part "ISO 19650-1" ;
    rdfs:label "maturity stage 3" ;
    iso:definition "future maturity stage with process standards to be developed; object based server information models; structured and unstructured (BIG) data; query/model/container/database and information management technology based CDE" ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO 19650-1" ;
    iso:provenanceClause "4.2; Figure 1" .
iso:term_information_quality a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_information_quality" ;
    iso:part "ISO 19650-1" ;
    rdfs:label "information quality" ;
    iso:definition "Information managed in the CDE should be understandable by all parties. [...] Classification of objects should be in accordance with the principles in ISO 12006-2. Object information should be in accordance with ISO 12006-3, to support object exchange. Automated checking of information in the CDE should be considered." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO 19650-1" ;
    iso:provenanceClause "11.3" .
iso:term_spatial_coordination_issue a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_spatial_coordination_issue" ;
    iso:part "ISO 19650-1" ;
    rdfs:label "spatial coordination issue (clash)" ;
    iso:definition "Issues in the information model should be avoided during the production of information rather than detected after the delivery of information. Issues could be spatial, for example structural elements and building services occupying the same space, or functional, for example fire protection materials being incompatible with the required fire rating of a wall." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO 19650-1" ;
    iso:provenanceClause "11.1" .
iso:term_generic_information a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_generic_information" ;
    iso:part "ISO 19650-1" ;
    rdfs:label "generic information" ;
    iso:definition "generic information should be used before the final product has been selected or manufactured, indicating the space required for installation, connection, maintenance and replacement, and be replaced by specific information as soon as this is available" ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO 19650-1" ;
    iso:provenanceClause "11.1" .
iso:term_capability_capacity_review a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_capability_capacity_review" ;
    iso:part "ISO 19650-1" ;
    rdfs:label "capability and capacity review" ;
    iso:definition "The appointing party should review the capability and capacity of the prospective delivery team to meet the information requirements. [...] The review of prospective delivery team capability and capacity should include at least the following" ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "low" ;
    iso:provenanceStandard "ISO 19650-1" ;
    iso:provenanceClause "8.1; 8.2" .
iso:term_information_verification_validation a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_information_verification_validation" ;
    iso:part "ISO 19650-1" ;
    rdfs:label "information verification and validation" ;
    iso:definition "the delivery of information by the lead appointed party, the checking of that information by the appointing party against the requirements, and any iteration that is needed to complete the information exchange [...] the provision of information from the appointing party to the lead appointed party, the checking of that information against what is needed to start the next project stage, and any iteration to complete the information exchange" ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO 19650-1" ;
    iso:provenanceClause "6.3.3; 6.2" .
iso:term_information_delivery_risk_assessment a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_information_delivery_risk_assessment" ;
    iso:part "ISO 19650-1" ;
    rdfs:label "information delivery risk assessment" ;
    iso:definition "documented risk assessment for delivery of asset or project information should be included in the overall asset or project risk assessment [...] consequences and likelihood of occurring are understood, communicated and managed" ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO 19650-1" ;
    iso:provenanceClause "6.3.1" .

# ---- ISO 19650-2 Nodes (data/iso19650-2_extraction_v1.json) ----

iso:term_im_process_delivery a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_im_process_delivery" ;
    iso:part "ISO 19650-2" ;
    rdfs:label "information management process (delivery phase)" ;
    iso:definition "The information management process (Figure 3) shall be applied throughout the delivery phase for each appointment, regardless of project stage." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO 19650-2" ;
    iso:provenanceClause "4; Figure 3" .
iso:term_project_team a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_project_team" ;
    iso:part "ISO 19650-2" ;
    rdfs:label "project team" ;
    iso:definition "appointing party and all delivery teams" ;
    iso:termNo "3.1.2.1" ;
    iso:sourceType "terms_clause" ;
    iso:pdmRelevance "low" ;
    iso:provenanceStandard "ISO 19650-2" ;

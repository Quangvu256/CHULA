iso:term_semiotic_triangle a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_semiotic_triangle" ;
    iso:part "ISO/IEC 30173" ;
    rdfs:label "semiotic triangle" ;
    iso:definition "The semiotic triangle is a visualization of the relationships between the phenomenon of interest and the intended semantic concept, that is, the conceptual meaning of that phenomenon, and the intended semantics of the phenomenon of interest." ;

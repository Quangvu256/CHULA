    iso:nodeId "term_managerial_costing" ;
    iso:part "ISO/TS 55010" ;
    rdfs:label "managerial costing" ;
    iso:definition "costing used internally by an organization to ensure that information for decisions reflects the characteristics of the organization's resources and operations" ;
    iso:termNo "3.3" ;
    iso:sourceType "terms_clause" ;
    iso:pdmRelevance "low" ;
    iso:provenanceStandard "ISO/TS 55010:2019" ;
    iso:provenanceClause "3.3" .
iso:term_financial_function a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_financial_function" ;
    iso:part "ISO/TS 55010" ;
    rdfs:label "financial function" ;
    iso:definition "work, or portions of work, that pertain to financial management" ;
    iso:termNo "3.4" ;
    iso:sourceType "terms_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO/TS 55010:2019" ;
    iso:provenanceClause "3.4" .
iso:term_non_financial_function a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_non_financial_function" ;
    iso:part "ISO/TS 55010" ;
    rdfs:label "non-financial function" ;
    iso:definition "work, or portions of work, that combine with the organization's financial functions in delivering its services or products" ;
    iso:termNo "3.5" ;
    iso:sourceType "terms_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO/TS 55010:2019" ;
    iso:provenanceClause "3.5" .
iso:term_internal_control a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_internal_control" ;
    iso:part "ISO/TS 55010" ;
    rdfs:label "internal control" ;
    iso:definition "process(es) used by an organization's managers to help it achieve its objectives" ;
    iso:termNo "3.6" ;
    iso:sourceType "terms_clause" ;
    iso:pdmRelevance "low" ;
    iso:provenanceStandard "ISO/TS 55010:2019" ;
    iso:provenanceClause "3.6" .
iso:term_asset_register a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_asset_register" ;
    iso:part "ISO/TS 55010" ;
    rdfs:label "asset register (asset data record)" ;
    iso:definition "record of asset data and information considered worthy of separate identification and accountability" ;
    iso:termNo "3.7" ;
    iso:sourceType "terms_clause" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO/TS 55010:2019" ;
    iso:provenanceClause "3.7" .
iso:term_capital_expenditure a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_capital_expenditure" ;
    iso:part "ISO/TS 55010" ;
    rdfs:label "capital expenditure (CapEx)" ;
    iso:definition "expenditure on acquisitions of, or improvements to, assets" ;
    iso:termNo "3.8" ;
    iso:sourceType "terms_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO/TS 55010:2019" ;
    iso:provenanceClause "3.8" .
iso:term_operational_expenditure a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_operational_expenditure" ;
    iso:part "ISO/TS 55010" ;
    rdfs:label "operational expenditure (OpEx)" ;
    iso:definition "recurrent expenditures required to provide a service or product" ;
    iso:termNo "3.9" ;
    iso:sourceType "terms_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO/TS 55010:2019" ;
    iso:provenanceClause "3.9" .
iso:term_total_expenditure a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_total_expenditure" ;
    iso:part "ISO/TS 55010" ;
    rdfs:label "total expenditure (TotEx)" ;
    iso:definition "sum of capital expenditure and operational expenditure over a period" ;
    iso:termNo "3.10" ;
    iso:sourceType "terms_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO/TS 55010:2019" ;
    iso:provenanceClause "3.10" .
iso:term_alignment a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_alignment" ;
    iso:part "ISO/TS 55010" ;
    rdfs:label "alignment (financial and non-financial functions)" ;
    iso:definition "deliberate arrangement, relationship and mutual understanding of common concerns within a particular activity or among activities" ;
    iso:termNo "3.11" ;
    iso:sourceType "terms_clause" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO/TS 55010:2019" ;
    iso:provenanceClause "3.11" .
iso:term_valuation a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_valuation" ;
    iso:part "ISO/TS 55010" ;
    rdfs:label "valuation" ;
    iso:definition "process of determining the current value of an asset" ;
    iso:termNo "3.12" ;
    iso:sourceType "terms_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO/TS 55010:2019" ;
    iso:provenanceClause "3.12" .
iso:term_book_value a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_book_value" ;
    iso:part "ISO/TS 55010" ;
    rdfs:label "book value" ;
    iso:definition "monetary expression at which an asset or group of assets are carried on a balance sheet" ;
    iso:termNo "3.13" ;
    iso:sourceType "terms_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO/TS 55010:2019" ;
    iso:provenanceClause "3.13" .
iso:term_residual_value a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_residual_value" ;
    iso:part "ISO/TS 55010" ;
    rdfs:label "residual value" ;
    iso:definition "estimated financial amount that an organization would expect to obtain from disposal of an asset, after deducting the estimated costs of disposal, if the asset were already of the age and in the condition expected at the end of its useful life" ;
    iso:termNo "3.14" ;
    iso:sourceType "terms_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO/TS 55010:2019" ;
    iso:provenanceClause "3.14" .
iso:term_useful_life a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_useful_life" ;
    iso:part "ISO/TS 55010" ;
    rdfs:label "useful life" ;
    iso:definition "period over which an asset or class of assets are expected to be available for use by an organization" ;
    iso:termNo "3.15" ;
    iso:sourceType "terms_clause" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO/TS 55010:2019" ;
    iso:provenanceClause "3.15" .
iso:term_depreciation a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_depreciation" ;
    iso:part "ISO/TS 55010" ;
    rdfs:label "depreciation" ;
    iso:definition "systematic allocation of the depreciable amount of an asset over its useful life" ;
    iso:termNo "3.16" ;
    iso:sourceType "terms_clause" ;
    iso:pdmRelevance "low" ;
    iso:provenanceStandard "ISO/TS 55010:2019" ;
    iso:provenanceClause "3.16" .
iso:term_fair_value a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_fair_value" ;
    iso:part "ISO/TS 55010" ;
    rdfs:label "fair value" ;
    iso:definition "price that would be received to sell an asset, or paid to transfer a liability, in an orderly transaction between market participants at the measurement date" ;
    iso:termNo "3.17" ;
    iso:sourceType "terms_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO/TS 55010:2019" ;
    iso:provenanceClause "3.17" .
iso:term_liability a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_liability" ;
    iso:part "ISO/TS 55010" ;
    rdfs:label "liability" ;
    iso:definition "present obligation of the organization arising from past events, the settlement of which is expected to result in an out-flow of resources from the organization" ;
    iso:termNo "3.18" ;
    iso:sourceType "terms_clause" ;
    iso:pdmRelevance "low" ;
    iso:provenanceStandard "ISO/TS 55010:2019" ;
    iso:provenanceClause "3.18" .
iso:enabler_processes a iso:IsoNode, iso:Concept ;
    iso:nodeId "enabler_processes" ;
    iso:part "ISO/TS 55010" ;
    rdfs:label "process enabler for alignment" ;
    iso:definition "Defined processes can be significant enablers for the alignment of financial and non-financial asset management functions. Processes should be properly supported by documented information and opportunities identified to link tasks across different levels, functions and processes." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO/TS 55010:2019" ;
    iso:provenanceClause "5.2.1" .
iso:enabler_leadership a iso:IsoNode, iso:Concept ;
    iso:nodeId "enabler_leadership" ;
    iso:part "ISO/TS 55010" ;
    rdfs:label "leadership enabler for alignment" ;
    iso:definition "To achieve alignment between the financial and non-financial asset management functions within the organization, top management should demonstrate leadership and commitment" ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "low" ;
    iso:provenanceStandard "ISO/TS 55010:2019" ;
    iso:provenanceClause "5.2.2" .
iso:enabler_governance a iso:IsoNode, iso:Concept ;
    iso:nodeId "enabler_governance" ;
    iso:part "ISO/TS 55010" ;
    rdfs:label "governance enabler for alignment" ;
    iso:definition "Governance should provide a framework to align financial and non-financial asset management functions. This is demonstrated by a governance process and policies designed to establish alignment relationships between stakeholders that can address any conflicting interests regarding how assets are managed." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "low" ;
    iso:provenanceStandard "ISO/TS 55010:2019" ;
    iso:provenanceClause "5.2.3" .
iso:term_asset_management_policy a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_asset_management_policy" ;
    iso:part "ISO/TS 55010" ;
    rdfs:label "asset management policy" ;
    iso:definition "Top management, through the asset management policy, should acknowledge and endorse the role of alignment between the financial and non-financial functions. Top management should provide commitment to the provision of the information, knowledge and capabilities required to achieve, maintain and continually improve alignment." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO/TS 55010:2019" ;
    iso:provenanceClause "5.3.1" .
iso:term_strategic_asset_management_plan a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_strategic_asset_management_plan" ;
    iso:part "ISO/TS 55010" ;
    rdfs:label "strategic asset management plan (SAMP)" ;
    iso:definition "documented information that contains and aligns asset management policy, objectives, strategies and approaches for developing and managing the asset portfolio and the asset management system" ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO/TS 55010:2019" ;
    iso:provenanceClause "5.3.2" ;
    iso:defProvenanceStandard "ISO 55000:2024" ;
    iso:defProvenanceClause "3.3.29" .
iso:enabler_data_information a iso:IsoNode, iso:Concept ;
    iso:nodeId "enabler_data_information" ;
    iso:part "ISO/TS 55010" ;
    rdfs:label "data and information enabler for alignment" ;
    iso:definition "Accurate, reliable and current data and the resulting information are key elements of asset management. When data are processed, interpreted, organized, structured or presented so as to make them meaningful or useful, they are called information. Data and information management is of utmost importance to facilitate and ensure the collection, accuracy, availability, integrity and completeness of data and information." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO/TS 55010:2019" ;
    iso:provenanceClause "5.3.3" .
iso:term_common_terminology a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_common_terminology" ;
    iso:part "ISO/TS 55010" ;
    rdfs:label "common terminology for financial and non-financial alignment" ;
    iso:definition "Physical-asset-holding organizations should embrace the development of common terminology within their organization. This is to ensure that all stakeholders have a clear understanding and agreement in relation to the meaning of various terms commonly employed in differing professional sectors such as finance, operations, information and communications technology (ICT), etc." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO/TS 55010:2019" ;
    iso:provenanceClause "5.5" .
iso:term_information_system a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_information_system" ;
    iso:part "ISO/TS 55010" ;
    rdfs:label "information system (asset data)" ;
    iso:definition "Organizations use their information systems to register, manage, analyse and report on asset data and activities. These systems may comprise computer hardware, computer software, databases and data warehouses, telecommunications to connect hardware to form a network, and people to operate the systems (human resources and procedures)." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO/TS 55010:2019" ;
    iso:provenanceClause "6.2" .
iso:term_data_management a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_data_management" ;
    iso:part "ISO/TS 55010" ;
    rdfs:label "data management" ;
    iso:definition "Data management is a subset of information management. It comprises all disciplines related to managing data that are used by the organization in both financial and non-financial functions." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO/TS 55010:2019" ;
    iso:provenanceClause "6.3" .
iso:term_financial_asset_register a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_financial_asset_register" ;
    iso:part "ISO/TS 55010" ;
    rdfs:label "financial asset register" ;
    iso:definition "Financial asset registers are used for managing the organization's financial functions. They are used for financial reporting purposes, as well as for other activities, including accounting, taxation, insurance, valuation and legal requirements." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO/TS 55010:2019" ;
    iso:provenanceClause "7.2" .
iso:term_non_financial_asset_register a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_non_financial_asset_register" ;
    iso:part "ISO/TS 55010" ;
    rdfs:label "non-financial asset register" ;
    iso:definition "The non-financial asset registers are the organization's definitive key source of information for all the assets it manages and operates (tangible and intangible)." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO/TS 55010:2019" ;
    iso:provenanceClause "7.3" .
iso:term_shared_granularity a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_shared_granularity" ;
    iso:part "ISO/TS 55010" ;
    rdfs:label "shared asset granularity" ;
    iso:definition "In order to collaborate, there needs to be an organization-wide consensus on shared granularity, i.e. the asset breakdown detail at which financial and non-financial data will be shared. That consensus needs to be formalized in a dictionary of standard descriptions of the assets in the shared granularity and complied with across all departmental asset register platforms. Assets at that level of granularity need to share the same identification code to ensure integrity, so that data in the different departmental asset registers can be reported together for completeness." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO/TS 55010:2019" ;
    iso:provenanceClause "7.4" .
iso:term_asset_register_alignment a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_asset_register_alignment" ;
    iso:part "ISO/TS 55010" ;
    rdfs:label "asset register alignment" ;
    iso:definition "Facilitating alignment between financial and non-financial asset management processes requires a common aspect/tag to be contained within each register. Without such commonality, full alignment will be difficult to achieve." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO/TS 55010:2019" ;
    iso:provenanceClause "7.4" .
iso:term_financial_planning a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_financial_planning" ;
    iso:part "ISO/TS 55010" ;
    rdfs:label "financial planning for asset management" ;
    iso:definition "Financial planning for asset management is an integral part of the overarching asset management process. Asset management planning aims to achieve both financial and non-financial objectives while balancing performance, cost and risk over the total life cycle of the asset systems." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO/TS 55010:2019" ;
    iso:provenanceClause "8.1" .
iso:term_capital_investment_planning a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_capital_investment_planning" ;
    iso:part "ISO/TS 55010" ;
    rdfs:label "capital investment planning" ;
    iso:definition "Capital investment planning identifies the capital investment requirements of the organization over a specified period of time, (e.g. typically a 5 to 10 year forward-planning horizon or longer, depending on the organization's circumstances)." ;
    iso:sourceType "mixed_normative_informative" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO/TS 55010:2019" ;
    iso:provenanceClause "8.2" .
iso:term_long_term_financial_planning a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_long_term_financial_planning" ;
    iso:part "ISO/TS 55010" ;
    rdfs:label "long-term financial planning" ;
    iso:definition "Long-term financial planning builds on the outputs from the asset management planning and capital investment planning. It includes all annual operation and maintenance costs over the planning timeframe. It is the process of aligning financial capacity with long-term service or product delivery objectives." ;
    iso:sourceType "mixed_normative_informative" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO/TS 55010:2019" ;
    iso:provenanceClause "8.3" .
iso:term_budgeting a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_budgeting" ;
    iso:part "ISO/TS 55010" ;
    rdfs:label "budgeting" ;
    iso:definition "The budgeting process is more efficient when informed by a long-term financial plan that has been developed collaboratively with financial and non-financial staff input. [...] When financial and non-financial areas understand the asset conditions and objectives required, they can collaboratively prepare the asset management plan and associated costs using zero-based budgeting or activity-based budgeting" ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO/TS 55010:2019" ;
    iso:provenanceClause "8.4" .
iso:term_capitalization_threshold a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_capitalization_threshold" ;
    iso:part "ISO/TS 55010" ;
    rdfs:label "capitalization threshold" ;
    iso:definition "use of capitalization threshold: some accounting standards allow the organization to capitalize only the cost of assets above a certain threshold; this threshold is then part of the valuation rule of the organization and should be applied consistently" ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO/TS 55010:2019" ;
    iso:provenanceClause "8.4" .
iso:term_performance_management a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_performance_management" ;
    iso:part "ISO/TS 55010" ;
    rdfs:label "performance management" ;
    iso:definition "Performance management is an essential element in asset management to achieve the organizational objectives. [...] A balance has to be sought when addressing performance, cost and risk. Therefore, these three elements should be measured in relation to each other." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO/TS 55010:2019" ;
    iso:provenanceClause "9.1" .
iso:term_performance_measurement a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_performance_measurement" ;
    iso:part "ISO/TS 55010" ;
    rdfs:label "performance measurement" ;
    iso:definition "Performance evaluation should be carried out in many layers against specific, measurable, achievable, relevant and time-based (SMART) objectives aligned to each layer. [...] Performance measurement involves both financial and non-financial measures." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO/TS 55010:2019" ;
    iso:provenanceClause "9.2" .
iso:term_performance_reporting a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_performance_reporting" ;
    iso:part "ISO/TS 55010" ;
    rdfs:label "performance reporting" ;
    iso:definition "Performance reporting addresses internal policies, procedures and processes, including risks, costs, value generated, asset health, life cycle performance, etc. The purpose of such reports is to recognize actual costs, to validate prior decisions, to recognize changes in value and to assess possible future value enhancements." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO/TS 55010:2019" ;
    iso:provenanceClause "9.3" .
iso:term_financial_reporting a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_financial_reporting" ;
    iso:part "ISO/TS 55010" ;
    rdfs:label "financial reporting in asset management" ;
    iso:definition "Accounting standards are used by the financial function for the organization's financial reporting. These standards contain specific guidelines regarding the definition of an asset, when to record an asset, and how to report financial information about an asset." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO/TS 55010:2019" ;
    iso:provenanceClause "9.4" .
iso:term_valuation_technique a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_valuation_technique" ;
    iso:part "ISO/TS 55010" ;
    rdfs:label "valuation technique" ;
    iso:definition "An organization should use valuation techniques that are appropriate in the circumstances and for which sufficient data are available to measure fair value, maximizing the use of relevant observable inputs and minimizing the use of unobservable inputs. [...] The objective of using a valuation technique is to estimate the fair value of the asset including the cost to replace its service capacity." ;
    iso:sourceType "informative_annex" ;
    iso:pdmRelevance "low" ;
    iso:provenanceStandard "ISO/TS 55010:2019" ;
    iso:provenanceClause "D.4" .
iso:term_depreciation_method a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_depreciation_method" ;
    iso:part "ISO/TS 55010" ;
    rdfs:label "depreciation method" ;
    iso:definition "IFRS and US GAAP (or other GAAPs) require that the depreciation method used reflect the pattern in which the asset's future economic benefits are expected to be consumed by the organization. The organization should select the method that most closely reflects the expected pattern of consumption of the future economic benefits embodied in the asset and based on what is allowed from local jurisdictions." ;
    iso:sourceType "informative_annex" ;
    iso:pdmRelevance "low" ;
    iso:provenanceStandard "ISO/TS 55010:2019" ;
    iso:provenanceClause "D.5" .
iso:term_impairment a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_impairment" ;
    iso:part "ISO/TS 55010" ;
    rdfs:label "impairment" ;
    iso:definition "decline in the future economic benefits service potential due to extrinsic or intrinsic conditions on an asset over and above the consumption reported through depreciation" ;
    iso:sourceType "informative_annex" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO/TS 55010:2019" ;
    iso:provenanceClause "D.6" .
iso:term_remaining_useful_life a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_remaining_useful_life" ;
    iso:part "ISO/TS 55010" ;
    rdfs:label "remaining useful life" ;
    iso:definition "The remaining useful life can be estimated from the condition of an asset, when reliable condition deterioration profiles are available. Remaining useful life can increase when an asset's total useful life is extended by rehabilitation work." ;
    iso:sourceType "informative_annex" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO/TS 55010:2019" ;
    iso:provenanceClause "D.7" .
iso:phase_concept a iso:IsoNode, iso:Concept ;
    iso:nodeId "phase_concept" ;
    iso:part "ISO/TS 55010" ;
    rdfs:label "concept phase (asset life cycle)" ;
    iso:definition "The decision to create a new infrastructure asset is typically triggered by some change in the need for the service provided by the assets. At this early stage of the life cycle of the assets, non-financial functions in asset management usually involve an analysis of" ;
    iso:sourceType "informative_annex" ;
    iso:pdmRelevance "low" ;
    iso:provenanceStandard "ISO/TS 55010:2019" ;
    iso:provenanceClause "E.2" .
iso:phase_planning_design a iso:IsoNode, iso:Concept ;
    iso:nodeId "phase_planning_design" ;
    iso:part "ISO/TS 55010" ;
    rdfs:label "planning and design phase" ;
    iso:definition "Where there is a need for a new service involving new assets having been approved at the concept stage, the following phase involves confirming the service required to meet customer needs and ensuring that the most effective solution is found to meet that need." ;
    iso:sourceType "informative_annex" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO/TS 55010:2019" ;
    iso:provenanceClause "E.3" .
iso:phase_asset_creation a iso:IsoNode, iso:Concept ;
    iso:nodeId "phase_asset_creation" ;
    iso:part "ISO/TS 55010" ;
    rdfs:label "asset creation phase" ;
    iso:definition "The asset creation phase involves procuring the assets and putting them into service. It typically involves significant CapEx for which financial staff need to be involved." ;
    iso:sourceType "informative_annex" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO/TS 55010:2019" ;
    iso:provenanceClause "E.4" .
iso:phase_operation_maintenance a iso:IsoNode, iso:Concept ;
    iso:nodeId "phase_operation_maintenance" ;
    iso:part "ISO/TS 55010" ;
    rdfs:label "operation and maintenance phase" ;
    iso:definition "Operation and maintenance (O&M) costs often represent a significant portion of an asset's life cycle costs. O&M directly and indirectly influence costs, level of service, risk, performance, reputation, etc. [...] The organization's operational functions should run the assets to produce the product and/or service to be delivered at the required level of service and acceptable level of risk." ;
    iso:sourceType "informative_annex" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO/TS 55010:2019" ;
    iso:provenanceClause "E.5" .
iso:phase_asset_monitoring a iso:IsoNode, iso:Concept ;
    iso:nodeId "phase_asset_monitoring" ;
    iso:part "ISO/TS 55010" ;
    rdfs:label "asset monitoring phase" ;
    iso:definition "The organization can use condition and performance monitoring for assets to demonstrate they are delivering the agreed levels of service, to predict failures and, where necessary, propose intervention before a functional failure occurs." ;
    iso:sourceType "informative_annex" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO/TS 55010:2019" ;
    iso:provenanceClause "E.6" .
iso:phase_rehabilitation_refurbishment a iso:IsoNode, iso:Concept ;
    iso:nodeId "phase_rehabilitation_refurbishment" ;
    iso:part "ISO/TS 55010" ;
    rdfs:label "rehabilitation and refurbishment phase" ;
    iso:definition "It is important for the financial and non-financial functions to collaborate when planning for asset refurbishment or replacement in order to agree on the most appropriate time in the asset life cycle to conduct these activities. [...] The economic value of assets decreases over time, while the cost of owning the asset (e.g. operation and maintenance) often increases over time. Hence, the optimum point for refurbishment and replacement needs to be mutually agreed to balance financial and non-financial requirements and constraints." ;
    iso:sourceType "informative_annex" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO/TS 55010:2019" ;
    iso:provenanceClause "E.7" .
iso:phase_disposal a iso:IsoNode, iso:Concept ;
    iso:nodeId "phase_disposal" ;
    iso:part "ISO/TS 55010" ;
    rdfs:label "disposal phase" ;
    iso:definition "The disposal phase is typically the last stage of an asset's life cycle and it commences at the time when the asset no longer fulfils the organization's needs. For example, the asset reaches the end of its useful life, which can be manifested in low or unstable reliability, a high running cost or low product/service quality being delivered or obsolescence." ;
    iso:sourceType "informative_annex" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO/TS 55010:2019" ;
    iso:provenanceClause "E.8" .
iso:term_preventive_maintenance a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_preventive_maintenance" ;
    iso:part "ISO/TS 55010" ;
    rdfs:label "preventive maintenance" ;
    iso:definition "Preventive maintenance can imply somewhat larger maintenance costs, but it is designed to increase reliability and availability without necessarily extending the useful life of the asset, while reducing total life cycle costs. Preventive maintenance aims to slow asset deterioration or failure risk whereas corrective maintenance restores serviceability by correcting failures." ;
    iso:sourceType "informative_annex" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO/TS 55010:2019" ;
    iso:provenanceClause "E.5.3" .
iso:term_predictive_maintenance a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_predictive_maintenance" ;
    iso:part "ISO/TS 55010" ;
    rdfs:label "predictive maintenance" ;
    iso:definition "predictive maintenance, including condition monitoring" ;
    iso:sourceType "informative_annex" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO/TS 55010:2019" ;
    iso:provenanceClause "E.5.3" .
iso:term_corrective_maintenance a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_corrective_maintenance" ;
    iso:part "ISO/TS 55010" ;
    rdfs:label "corrective maintenance" ;
    iso:definition "corrective maintenance restores serviceability by correcting failures" ;
    iso:sourceType "informative_annex" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO/TS 55010:2019" ;
    iso:provenanceClause "E.5.3" .
iso:term_maintenance_plan a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_maintenance_plan" ;
    iso:part "ISO/TS 55010" ;
    rdfs:label "maintenance plan" ;
    iso:definition "A maintenance plan should meet the organization's objective, purpose and policy, and align with the organization's asset management plan. The maintenance plan should be developed with agreement by both the financial and non-financial functional areas to reach an agreed solution." ;
    iso:sourceType "informative_annex" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO/TS 55010:2019" ;
    iso:provenanceClause "E.5.3" .
iso:term_asset_management_plan a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_asset_management_plan" ;
    iso:part "ISO/TS 55010" ;
    rdfs:label "asset management plan" ;
    iso:definition "documented information that specifies the activities, resources, costs and timescales required for an individual asset, or a grouping of assets, to achieve an organization's asset management objectives" ;
    iso:sourceType "informative_annex" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO/TS 55010:2019" ;
    iso:provenanceClause "B.1" ;
    iso:defProvenanceStandard "ISO 55000:2024" ;
    iso:defProvenanceClause "3.2.5" .
iso:term_total_cost_of_ownership a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_total_cost_of_ownership" ;
    iso:part "ISO/TS 55010" ;
    rdfs:label "total cost of ownership (TCO)" ;
    iso:definition "Total cost of ownership (TCO) calculations are desirably performed to inform asset creation decisions. Ideally, TCO should be factored together with non-financial aspects of the decision-making process (e.g. cost/benefit analyses, multi-criteria analysis)." ;
    iso:sourceType "informative_annex" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO/TS 55010:2019" ;
    iso:provenanceClause "E.2" .


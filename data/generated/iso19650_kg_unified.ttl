    iso:nodeId "term_baseline_sensitive_information_protection" ;
    iso:part "ISO 19650-5" ;
    rdfs:label "baseline sensitive commercial and personal information protection" ;
    iso:definition "Where an initiative, project, asset, product or service is not considered sensitive and does not have access to other third-party sensitive information, the organization(s) shall consider whether there are business benefits to be derived from applying a security-minded approach." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;

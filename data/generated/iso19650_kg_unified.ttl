    iso:provenanceStandard "ISO 19650-5" ;
    iso:provenanceClause "6.1.1 d)" ;
    iso:relationshipNote "The security strategy records both the POTENTIAL mitigation measures and the measures TO BE IMPLEMENTED." .
iso:term_residual_risk iso:DERIVED_FROM iso:term_security_risk_mitigation_measure .
iso:rel_1064 a rdf:Statement ;
    rdfs:label "reference number : 1064" ;
    rdf:subject iso:term_residual_risk ;

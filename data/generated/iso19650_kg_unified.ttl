    iso:nodeId "term_security_risk_mitigation_measure" ;
    iso:part "ISO 19650-5" ;
    rdfs:label "security risk mitigation measure" ;
    iso:definition "The organization(s) shall identify and record possible mitigation measures for each security risk or combination of risks identified. [...] the organization(s) shall consider personnel, physical, and technical securi" ;

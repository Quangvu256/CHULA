    iso:definition "trigger events that are foreseen and scheduled in advance [...] Examples of the first type of trigger event are: annual maintenance tasks, strategic estate reviews and call-off arrangements for common-place repairs." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO 19650-3" ;
    iso:provenanceClause "0.1; 5.1.5; 5.2.2 Note 1" .
iso:term_unforeseen_trigger_event a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_unforeseen_trigger_event" ;
    iso:part "ISO 19650-3" ;
    rdfs:label "unforeseen trigger event" ;
    iso:definition "trigger events that are not scheduled in advance or cannot be foreseen [...] deliberate decision to initiate a project such as the construction of a bridge or underpass. Here, the information management process could follow either ISO 19650-2 or this document." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO 19650-3" ;
    iso:provenanceClause "0.1" .
iso:term_asset_acquisition a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_asset_acquisition" ;
    iso:part "ISO 19650-3" ;
    rdfs:label "asset acquisition" ;
    iso:definition "asset being acquired from an existing owner, where information is exchanged as part of the transaction" ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO 19650-3" ;
    iso:provenanceClause "0.1; 5.7.1; Figure 4 (D, N)" .
iso:term_asset_information_standard a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_asset_information_standard" ;
    iso:part "ISO 19650-3" ;
    rdfs:label "asset information standard" ;
    iso:definition "The appointing party shall establish any specific information standards required by the appointing party's organization within the asset information standard." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO 19650-3" ;
    iso:provenanceClause "5.1.6" .

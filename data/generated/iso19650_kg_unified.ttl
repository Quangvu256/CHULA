    iso:nodeId "term_security_minded_approach" ;
    iso:part "ISO 19650-5" ;
    rdfs:label "security-minded approach" ;
    iso:definition "Where an initiative, project, asset, product or service: a) has been determined to be sensitive, whether in whole or in part; and/or b) will be holding third-party information that has been identified as sensitive, the top management of the organization(s) shall, following the requirements of this doc" ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO 19650-5" ;

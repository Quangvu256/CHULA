    iso:provenanceClause "3.3.25" .
iso:term_knowledge a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_knowledge" ;
    iso:part "ISO 55000" ;
    rdfs:label "knowledge" ;
    iso:definition "understanding of facts, information and principles acquired through experience, research or education" ;
    iso:termNo "3.3.26" ;
    iso:sourceType "terms_clause" ;
    iso:pdmRelevance "low" ;
    iso:provenanceStandard "ISO 55000:2024" ;
    iso:provenanceClause "3.3.26" .
iso:term_sustainability a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_sustainability" ;
    iso:part "ISO 55000" ;
    rdfs:label "sustainability" ;
    iso:definition "state of the global system, including environmental, social and economic aspects, in which the needs of the present are met without compromising the ability of future generations to meet their own needs" ;
    iso:termNo "3.3.27" ;
    iso:sourceType "terms_clause" ;
    iso:pdmRelevance "low" ;
    iso:provenanceStandard "ISO 55000:2024" ;
    iso:provenanceClause "3.3.27" .
iso:term_value a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_value" ;
    iso:part "ISO 55000" ;
    rdfs:label "value" ;
    iso:definition "results from satisfying needs and expectations" ;
    iso:termNo "3.3.28" ;
    iso:sourceType "terms_clause" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO 55000:2024" ;
    iso:provenanceClause "3.3.28" .
iso:term_framework a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_framework" ;
    iso:part "ISO 55000" ;
    rdfs:label "framework" ;
    iso:definition "structure of processes and specifications designed to support the accomplishment of a specific task" ;
    iso:termNo "3.3.30" ;
    iso:sourceType "terms_clause" ;
    iso:pdmRelevance "low" ;
    iso:provenanceStandard "ISO 55000:2024" ;
    iso:provenanceClause "3.3.30" .
iso:principle_am_value a iso:IsoNode, iso:Principle ;
    iso:nodeId "principle_am_value" ;
    iso:part "ISO 55000" ;
    rdfs:label "value (asset management principle)" ;
    iso:definition "Asset management focuses on the value assets provide to the organization over time. This principle encourages clear contributions to organizational objectives, life cycle management and transparent decision-making processes." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO 55000:2024" ;
    iso:provenanceClause "4.2.2" .
iso:principle_am_alignment a iso:IsoNode, iso:Principle ;
    iso:nodeId "principle_am_alignment" ;
    iso:part "ISO 55000" ;
    rdfs:label "alignment (asset management principle)" ;
    iso:definition "asset management aligns financial, technical and operational decisions with the organizational objectives, promoting vertical and horizontal coordination" ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO 55000:2024" ;
    iso:provenanceClause "4.2.3" .
iso:principle_am_leadership a iso:IsoNode, iso:Principle ;
    iso:nodeId "principle_am_leadership" ;
    iso:part "ISO 55000" ;
    rdfs:label "leadership (asset management principle)" ;
    iso:definition "Leadership and sustained commitment at all levels are crucial for successful asset management. Effective leadership establishes a clear direction, roles, responsibilities and authorities, with transparent consultation and the development of a collaborative culture that is aligned to organizational success." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "low" ;
    iso:provenanceStandard "ISO 55000:2024" ;
    iso:provenanceClause "4.2.4" .
iso:term_am_maturity a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_am_maturity" ;
    iso:part "ISO 55000" ;
    rdfs:label "asset management maturity" ;
    iso:definition "Asset management maturity is key to enhancing an organization's performance. The organization's progress can be measured by its maturity: showing how well it is performing and where targeted improvements can be made. [...] An organization's asset management and asset management system maturity are reflected in its capabilities, which are essential elements enabling success." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO 55000:2024" ;
    iso:provenanceClause "4.5" .

# ---- ISO 55011 Nodes (data/iso-55011_extraction_v1.json) ----

iso:term_capacity_building a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_capacity_building" ;
    iso:part "ISO 55011" ;
    rdfs:label "capacity building" ;
    iso:definition "provision of relevant competencies, skills, knowledge, experience, and the associated funding, technology and other resources that enable individuals or organizations to accomplish new tasks to achieve asset management objectives" ;
    iso:termNo "3.1" ;
    iso:sourceType "terms_clause" ;
    iso:pdmRelevance "low" ;
    iso:provenanceStandard "ISO 55011:2024" ;
    iso:provenanceClause "3.1" .
iso:term_enabling_environment a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_enabling_environment" ;
    iso:part "ISO 55011" ;
    rdfs:label "enabling environment for asset management" ;
    iso:definition "set of circumstances, objects or conditions, external to organizations managing the assets, that positively affect their adoption of asset management and the achievement of government objectives" ;
    iso:termNo "3.2" ;
    iso:sourceType "terms_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO 55011:2024" ;
    iso:provenanceClause "3.2" .
iso:term_governance a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_governance" ;
    iso:part "ISO 55011" ;
    rdfs:label "governance" ;
    iso:definition "system of directing and controlling" ;
    iso:termNo "3.3" ;
    iso:sourceType "terms_clause" ;
    iso:pdmRelevance "low" ;
    iso:provenanceStandard "ISO 55011:2024" ;
    iso:provenanceClause "3.3" .
iso:term_government a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_government" ;
    iso:part "ISO 55011" ;
    rdfs:label "government" ;
    iso:definition "act of, or responsibility for, managing, governing and promoting the development of a jurisdiction, including responsibilities for the definition, design, development and institutionalization of public policies expressed in the provision of products and services to its stakeholders" ;
    iso:termNo "3.4" ;
    iso:sourceType "terms_clause" ;
    iso:pdmRelevance "low" ;
    iso:provenanceStandard "ISO 55011:2024" ;
    iso:provenanceClause "3.4" .
iso:term_local_government a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_local_government" ;
    iso:part "ISO 55011" ;
    rdfs:label "local government" ;
    iso:definition "organization that is responsible for the governance of a local area and for providing services, etc." ;
    iso:termNo "3.5" ;
    iso:sourceType "terms_clause" ;
    iso:pdmRelevance "low" ;
    iso:provenanceStandard "ISO 55011:2024" ;
    iso:provenanceClause "3.5" .
iso:term_public_investment a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_public_investment" ;
    iso:part "ISO 55011" ;
    rdfs:label "public investment" ;
    iso:definition "investment spending by the government on physical infrastructure (e.g. roads, public buildings) and intangible infrastructure (e.g. human capital development, innovation, research and development) with a long-term productive life" ;
    iso:termNo "3.6" ;
    iso:sourceType "terms_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO 55011:2024" ;
    iso:provenanceClause "3.6" .
iso:term_public_policy a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_public_policy" ;
    iso:part "ISO 55011" ;
    rdfs:label "public policy" ;
    iso:definition "principled guide to a course of actions taken by the government as a response to a perceived need, formulated by a specific political process, and adopted, implemented and enforced by a specific public agency that expects results" ;
    iso:termNo "3.7" ;
    iso:sourceType "terms_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO 55011:2024" ;
    iso:provenanceClause "3.7" .
iso:term_public_policy_instrument a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_public_policy_instrument" ;
    iso:part "ISO 55011" ;
    rdfs:label "public policy instrument" ;
    iso:definition "intervention made by the government which is intended to support the achievement of public policy objectives" ;
    iso:termNo "3.8" ;
    iso:sourceType "terms_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO 55011:2024" ;
    iso:provenanceClause "3.8" .
iso:term_public_policy_maker a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_public_policy_maker" ;
    iso:part "ISO 55011" ;
    rdfs:label "public policy-maker" ;
    iso:definition "representative of the government who is responsible for developing, administering or influencing public policies" ;
    iso:termNo "3.9" ;
    iso:sourceType "terms_clause" ;
    iso:pdmRelevance "low" ;
    iso:provenanceStandard "ISO 55011:2024" ;
    iso:provenanceClause "3.9" .
iso:term_public_policy_objectives a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_public_policy_objectives" ;
    iso:part "ISO 55011" ;
    rdfs:label "public policy objectives" ;
    iso:definition "result to be achieved by a public policy" ;
    iso:termNo "3.10" ;
    iso:sourceType "terms_clause" ;
    iso:pdmRelevance "low" ;
    iso:provenanceStandard "ISO 55011:2024" ;
    iso:provenanceClause "3.10" .
iso:term_public_policy_process a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_public_policy_process" ;
    iso:part "ISO 55011" ;
    rdfs:label "public policy process" ;
    iso:definition "set of interrelated or interacting activities through which a public policy is formed, implemented and evaluated" ;
    iso:termNo "3.11" ;
    iso:sourceType "terms_clause" ;
    iso:pdmRelevance "low" ;
    iso:provenanceStandard "ISO 55011:2024" ;
    iso:provenanceClause "3.11" .
iso:term_service_delivery a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_service_delivery" ;
    iso:part "ISO 55011" ;
    rdfs:label "service delivery" ;
    iso:definition "act of providing a service to customers" ;
    iso:termNo "3.12" ;
    iso:sourceType "terms_clause" ;
    iso:pdmRelevance "low" ;
    iso:provenanceStandard "ISO 55011:2024" ;
    iso:provenanceClause "3.12" .
iso:term_subnational_government a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_subnational_government" ;
    iso:part "ISO 55011" ;
    rdfs:label "subnational government" ;
    iso:definition "level of government below national (regional and local) governments" ;
    iso:termNo "3.13" ;
    iso:sourceType "terms_clause" ;
    iso:pdmRelevance "low" ;
    iso:provenanceStandard "ISO 55011:2024" ;
    iso:provenanceClause "3.13" .
iso:function_government_participant a iso:IsoNode, iso:Function ;
    iso:nodeId "function_government_participant" ;
    iso:part "ISO 55011" ;
    rdfs:label "government participant (enabling environment)" ;
    iso:definition "Government organizations and officials, at all levels of government and regulatory agencies, are the most significant participants in developing and improving public policies. They generally have the authority to develop and improve public policy, for example, through the creation of formal rules, delegations, mandates, inducements and capacity building that directly affect the outcomes of the enabling environment for asset management." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "low" ;
    iso:provenanceStandard "ISO 55011:2024" ;
    iso:provenanceClause "4.2.1" .
iso:function_non_government_participant a iso:IsoNode, iso:Function ;
    iso:nodeId "function_non_government_participant" ;
    iso:part "ISO 55011" ;
    rdfs:label "non-government participant (enabling environment)" ;
    iso:definition "Non-government participants in the enabling environment can promote asset management through public policy by engaging with government agencies and officials in the development of their public policy instruments. Non-government participants can include asset owners, asset management advocacy groups, industry organizations and individuals that support asset owners or operators, professional associations, academia, the media, and other potential institutions and organizations (including, but not limited to, lenders, investors and insurers)." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "low" ;
    iso:provenanceStandard "ISO 55011:2024" ;
    iso:provenanceClause "4.2.2" .
iso:function_asset_owner_operator a iso:IsoNode, iso:Function ;
    iso:nodeId "function_asset_owner_operator" ;
    iso:part "ISO 55011" ;
    rdfs:label "asset owner, operator or custodian" ;
    iso:definition "Organizations that own, operate or are otherwise responsible for assets are the target audiences of other International Standards on asset management (e.g. ISO 55001, ISO 55002, ISO/TS 55010) and the ones to which those asset management requirements are addressed. Asset owners and operators are found among both government and non-government participants in the enabling environment for asset management." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO 55011:2024" ;
    iso:provenanceClause "4.2.3.1" .
iso:function_society a iso:IsoNode, iso:Function ;
    iso:nodeId "function_society" ;
    iso:part "ISO 55011" ;
    rdfs:label "society (enabling environment)" ;
    iso:definition "Society represents the entire population of a jurisdiction and is ultimately impacted by good or poor asset management practices. Members of society are uniquely positioned as the recipients of services and products enabled through the application of asset management by asset owners and service providers." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "low" ;
    iso:provenanceStandard "ISO 55011:2024" ;
    iso:provenanceClause "4.2.3.2" .
iso:practice_expertise_in_policy_making a iso:IsoNode, iso:Concept ;
    iso:nodeId "practice_expertise_in_policy_making" ;
    iso:part "ISO 55011" ;
    rdfs:label "bringing asset management expertise into policy-making" ;
    iso:definition "Good practices in government policy-making processes engage participants impacted by the prospective policy elements and give them an opportunity to comment and possibly affect the policies being developed. [...] Bringing asset management expertise and the holistic, integrative approach of asset management into applicable policy-making processes can make a significant contribution to the likelihood that the policies will achieve their intended outcomes" ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "low" ;
    iso:provenanceStandard "ISO 55011:2024" ;
    iso:provenanceClause "6.2.1" .
iso:practice_participant_relationships a iso:IsoNode, iso:Concept ;
    iso:nodeId "practice_participant_relationships" ;
    iso:part "ISO 55011" ;
    rdfs:label "defining participant actions and relationships" ;
    iso:definition "To advance asset management for specific public purposes, the participants in the enabling environment should be aware of those purposes and know how to work together to achieve them. For example, effective public and private investments in assets and infrastructure, within a country or other political jurisdiction, require the necessary relationships among participants so that actions can be appropriately understood, coordinated and executed." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "low" ;
    iso:provenanceStandard "ISO 55011:2024" ;
    iso:provenanceClause "6.2.2" .
iso:practice_instrument_mix a iso:IsoNode, iso:Concept ;
    iso:nodeId "practice_instrument_mix" ;
    iso:part "ISO 55011" ;
    rdfs:label "leveraging a range of public policy instruments" ;
    iso:definition "A good practice also involves the strategic development, and sometimes concurrent coordination, of the public policy instruments to enable asset management. In almost every area of policy-making, there are a range of policy instruments that can be used to achieve desired policy outcomes. It is common that several policy instruments are used in conjunction with each other, depending on the complexity of the issue to be addressed." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "low" ;
    iso:provenanceStandard "ISO 55011:2024" ;
    iso:provenanceClause "6.2.3" .
iso:practice_sustain_enabling_environment a iso:IsoNode, iso:Concept ;
    iso:nodeId "practice_sustain_enabling_environment" ;
    iso:part "ISO 55011" ;
    rdfs:label "sustaining or improving the enabling environment" ;
    iso:definition "Good practice for improving the enabling environment for asset management is not limited to the government participants in the enabling environment [...] Good practices to achieve this result also include sharing expertise and strengthening the capabilities and credibility of the non-government participants in the enabling environment." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "low" ;
    iso:provenanceStandard "ISO 55011:2024" ;
    iso:provenanceClause "6.2.4" .

# ---- ISO 55012 Nodes (data/iso-55012_extraction_v1.json) ----

iso:term_involvement a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_involvement" ;
    iso:part "ISO 55012" ;
    rdfs:label "involvement" ;
    iso:definition "taking part in an activity, event or situation" ;
    iso:termNo "3.1" ;
    iso:sourceType "terms_clause" ;
    iso:pdmRelevance "low" ;
    iso:provenanceStandard "ISO 55012:2024" ;
    iso:provenanceClause "3.1" .
iso:term_commitment a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_commitment" ;
    iso:part "ISO 55012" ;
    rdfs:label "commitment" ;
    iso:definition "level of work and dedication given to the asset management system" ;
    iso:termNo "3.2" ;
    iso:sourceType "terms_clause" ;
    iso:pdmRelevance "low" ;
    iso:provenanceStandard "ISO 55012:2024" ;
    iso:provenanceClause "3.2" .
iso:term_engagement a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_engagement" ;
    iso:part "ISO 55012" ;
    rdfs:label "engagement" ;
    iso:definition "involvement in, and contribution to, activities to achieve shared objectives" ;
    iso:termNo "3.3" ;
    iso:sourceType "terms_clause" ;
    iso:pdmRelevance "low" ;
    iso:provenanceStandard "ISO 55012:2024" ;
    iso:provenanceClause "3.3" .
iso:term_leader a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_leader" ;
    iso:part "ISO 55012" ;
    rdfs:label "leader" ;
    iso:definition "person who influences a group of people towards the achievement of a goal, and in turn recognizes the contribution of this, and mutual dependency with other groups, in achieving an organizational goal" ;
    iso:termNo "3.4" ;
    iso:sourceType "terms_clause" ;
    iso:pdmRelevance "low" ;
    iso:provenanceStandard "ISO 55012:2024" ;
    iso:provenanceClause "3.4" .
iso:term_organizational_culture a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_organizational_culture" ;
    iso:part "ISO 55012" ;
    rdfs:label "organizational culture" ;
    iso:definition "values, beliefs and practices that influence the conduct and behaviour of people and organizations" ;
    iso:termNo "3.6" ;
    iso:sourceType "terms_clause" ;
    iso:pdmRelevance "low" ;
    iso:provenanceStandard "ISO 55012:2024" ;
    iso:provenanceClause "3.6" .
iso:term_am_culture a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_am_culture" ;
    iso:part "ISO 55012" ;
    rdfs:label "asset management culture" ;
    iso:definition "An asset management culture which supports people in recognizing and aligning with the organization's vision can improve the organization's performance, motivate people and coordinate their behaviour, which in turn can help achieve the organization's overall asset management objectives." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO 55012:2024" ;
    iso:provenanceClause "4.3" .
iso:attribute_vision a iso:IsoNode, iso:Concept ;
    iso:nodeId "attribute_vision" ;
    iso:part "ISO 55012" ;
    rdfs:label "vision (leadership attribute)" ;
    iso:definition "Effective leaders have a clear vision for the organization which they articulate and communicate to all personnel in the organization." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "low" ;
    iso:provenanceStandard "ISO 55012:2024" ;
    iso:provenanceClause "5.2.2" .
iso:attribute_commitment a iso:IsoNode, iso:Concept ;
    iso:nodeId "attribute_commitment" ;
    iso:part "ISO 55012" ;
    rdfs:label "commitment (leadership attribute)" ;
    iso:definition "Effective leaders are passionate about their work and are committed to seeing their vision become a reality." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "low" ;
    iso:provenanceStandard "ISO 55012:2024" ;
    iso:provenanceClause "5.2.3" .
iso:attribute_integrity a iso:IsoNode, iso:Concept ;
    iso:nodeId "attribute_integrity" ;
    iso:part "ISO 55012" ;
    rdfs:label "integrity (leadership attribute)" ;
    iso:definition "By embracing and advocating for the principles and values that underlie their strategic plans, and in particular by ensuring that their own actions reflect these principles, positive leaders act as important examples to other personnel of the expectations of the organizational culture." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "low" ;
    iso:provenanceStandard "ISO 55012:2024" ;
    iso:provenanceClause "5.2.4" .
iso:attribute_communicative a iso:IsoNode, iso:Concept ;
    iso:nodeId "attribute_communicative" ;
    iso:part "ISO 55012" ;
    rdfs:label "communicative (leadership attribute)" ;
    iso:definition "Competent leaders know the importance of communicating with relevant people within the organization and they are effective at selecting the appropriate means of communication to maximize understanding and alignment depending on context." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "low" ;
    iso:provenanceStandard "ISO 55012:2024" ;
    iso:provenanceClause "5.2.5" .
iso:attribute_domain_knowledge a iso:IsoNode, iso:Concept ;
    iso:nodeId "attribute_domain_knowledge" ;
    iso:part "ISO 55012" ;
    rdfs:label "domain knowledge (leadership attribute)" ;
    iso:definition "Although a leader is not necessarily a technical subject matter expert, they should have sufficient domain knowledge to be able to appropriately evaluate risk and opportunities and ensure that strategies established are operationally correct." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "low" ;
    iso:provenanceStandard "ISO 55012:2024" ;
    iso:provenanceClause "5.2.6" .
iso:attribute_team_building a iso:IsoNode, iso:Concept ;
    iso:nodeId "attribute_team_building" ;
    iso:part "ISO 55012" ;
    rdfs:label "team building (leadership attribute)" ;
    iso:definition "Cooperative leaders recognize that a team can achieve more than a single individual; working across roles and functions can bring energy, ideas and new solutions to any task." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "low" ;
    iso:provenanceStandard "ISO 55012:2024" ;
    iso:provenanceClause "5.2.7" .
iso:attribute_decision_making a iso:IsoNode, iso:Concept ;
    iso:nodeId "attribute_decision_making" ;
    iso:part "ISO 55012" ;
    rdfs:label "decision-making (leadership attribute)" ;
    iso:definition "People often look to their leadership for prompt, thoughtful and insightful decisions so that they can focus on the achievement of the asset management objectives within agreed priorities." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "low" ;
    iso:provenanceStandard "ISO 55012:2024" ;
    iso:provenanceClause "5.2.8" .
iso:attribute_openness a iso:IsoNode, iso:Concept ;
    iso:nodeId "attribute_openness" ;
    iso:part "ISO 55012" ;
    rdfs:label "openness (leadership attribute)" ;
    iso:definition "Good, supportive leaders always consider the views of others and encourage open dialogue to foster innovation and knowledge sharing." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "low" ;
    iso:provenanceStandard "ISO 55012:2024" ;
    iso:provenanceClause "5.2.9" .
iso:term_change_management a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_change_management" ;
    iso:part "ISO 55012" ;
    rdfs:label "change management" ;
    iso:definition "change management is a critical component of successful implementation of an asset management system, as well as for supporting future iterations of the management system and ensuring it is adaptable." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO 55012:2024" ;
    iso:provenanceClause "6.1" .
iso:term_multi_level_engagement a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_multi_level_engagement" ;
    iso:part "ISO 55012" ;
    rdfs:label "multi-level engagement in strategy development" ;
    iso:definition "Effective engagement across multiple levels of the organization should include: a) identification of suitably qualified personnel (at multiple organizational levels) to provide input into the development of the SAMP and asset management objectives" ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "low" ;
    iso:provenanceStandard "ISO 55012:2024" ;
    iso:provenanceClause "6.2" .
iso:term_am_awareness a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_am_awareness" ;
    iso:part "ISO 55012" ;
    rdfs:label "asset management awareness" ;
    iso:definition "Awareness within an asset management system requires the ability to know a person's responsibilities within the asset management system, as well as an understanding of how a person can receive relevant information." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "low" ;
    iso:provenanceStandard "ISO 55012:2024" ;
    iso:provenanceClause "7.2" .
iso:term_am_skills_matrix a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_am_skills_matrix" ;
    iso:part "ISO 55012" ;
    rdfs:label "asset management skills matrix" ;
    iso:definition "development of an asset management skills matrix that lists the asset management competencies required by personnel in the different domain areas" ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO 55012:2024" ;
    iso:provenanceClause "7.2 f)" .
iso:term_individual_competence a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_individual_competence" ;
    iso:part "ISO 55012" ;
    rdfs:label "individual competence" ;
    iso:definition "Individual competence relates to the knowledge and skill encompassed by one individual, while organizational competence is a broader concept that relates to the overall aggregation of individual competencies across the organization." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO 55012:2024" ;
    iso:provenanceClause "8.2" .
iso:term_organizational_competence a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_organizational_competence" ;
    iso:part "ISO 55012" ;
    rdfs:label "organizational competence" ;
    iso:definition "Individual competence relates to the knowledge and skill encompassed by one individual, while organizational competence is a broader concept that relates to the overall aggregation of individual competencies across the organization." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO 55012:2024" ;
    iso:provenanceClause "8.2" .
iso:term_competence_requirements a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_competence_requirements" ;
    iso:part "ISO 55012" ;
    rdfs:label "competence requirements" ;
    iso:definition "organizations should determine the competence required to achieve expected results at the organizational, team, group and individual levels" ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO 55012:2024" ;
    iso:provenanceClause "8.3" .
iso:term_competence_management_plan a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_competence_management_plan" ;
    iso:part "ISO 55012" ;
    rdfs:label "competence management plan" ;
    iso:definition "When establishing a competence management plan related to roles within the asset management system, the organization should evaluate opportunities for increasing competence" ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO 55012:2024" ;
    iso:provenanceClause "8.4" .

# ---- ISO 55013 Nodes (data/iso-55013_extraction_v1.json) ----

iso:term_asset_data a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_asset_data" ;
    iso:part "ISO 55013" ;
    rdfs:label "asset data" ;
    iso:definition "data that lists and describes an asset" ;
    iso:termNo "3.1" ;
    iso:sourceType "terms_clause" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO 55013:2024" ;
    iso:provenanceClause "3.1" .
iso:term_data_asset a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_data_asset" ;
    iso:part "ISO 55013" ;
    rdfs:label "data asset" ;
    iso:definition "data that has the properties of an asset" ;
    iso:termNo "3.2" ;
    iso:sourceType "terms_clause" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO 55013:2024" ;
    iso:provenanceClause "3.2" .
iso:term_data_type a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_data_type" ;
    iso:part "ISO 55013" ;
    rdfs:label "data type" ;
    iso:definition "named category of data characterized by a set of values, a syntax for denoting these values, and a set of operations that interpret, manipulate or store the values" ;
    iso:termNo "3.3" ;
    iso:sourceType "terms_clause" ;
    iso:pdmRelevance "low" ;
    iso:provenanceStandard "ISO 55013:2024" ;
    iso:provenanceClause "3.3" .
iso:term_data_quality a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_data_quality" ;
    iso:part "ISO 55013" ;
    rdfs:label "data quality" ;
    iso:definition "degree to which a set of inherent characteristics of data fulfils requirements" ;
    iso:termNo "3.5" ;
    iso:sourceType "terms_clause" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO 55013:2024" ;
    iso:provenanceClause "3.5" .
iso:term_interoperability a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_interoperability" ;
    iso:part "ISO 55013" ;
    rdfs:label "interoperability" ;
    iso:definition "capability of two or more entities to exchange items in accordance with a set of rules and mechanisms implemented by an interface in each entity, in order to perform their specified tasks" ;
    iso:termNo "3.6" ;
    iso:sourceType "terms_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO 55013:2024" ;
    iso:provenanceClause "3.6" .
iso:term_governing_function a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_governing_function" ;
    iso:part "ISO 55013" ;
    rdfs:label "governing function" ;
    iso:definition "function responsible for the strategic guidance of the data governance programme" ;
    iso:termNo "3.7" ;
    iso:sourceType "terms_clause" ;
    iso:pdmRelevance "low" ;
    iso:provenanceStandard "ISO 55013:2024" ;
    iso:provenanceClause "3.7" .
iso:term_data_requirements a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_data_requirements" ;
    iso:part "ISO 55013" ;
    rdfs:label "data requirements" ;
    iso:definition "The organization should determine its data requirements and manage its data across its life cycle to support the scope of its asset management system to achieve both its asset management and organizational objectives [...] Quality requirements for asset data closely relate to asset data requirements." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO 55013:2024" ;
    iso:provenanceClause "4.2.1" .
iso:term_master_data_source a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_master_data_source" ;
    iso:part "ISO 55013" ;
    rdfs:label "master data source" ;
    iso:definition "one data store should be identified as the master data source that is updated first and is referred to by other data stores." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO 55013:2024" ;
    iso:provenanceClause "4.2.5" .
iso:term_documented_information_protection a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_documented_information_protection" ;
    iso:part "ISO 55013" ;
    rdfs:label "protection of documented information" ;
    iso:definition "Documented information can be required over the whole life of the assets that they represent. [...] Protection from deletion: Application of user-level permissions to restrict who may delete documented information." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO 55013:2024" ;
    iso:provenanceClause "4.3.6" .
iso:phase_data_define a iso:IsoNode, iso:Concept ;
    iso:nodeId "phase_data_define" ;
    iso:part "ISO 55013" ;
    rdfs:label "define (data life cycle stage)" ;
    iso:definition "The define activity includes provision of explicit guidance of the form, structure and meaning of asset data required by the organization." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO 55013:2024" ;
    iso:provenanceClause "4.4.2" .
iso:phase_data_collect a iso:IsoNode, iso:Concept ;
    iso:nodeId "phase_data_collect" ;
    iso:part "ISO 55013" ;
    rdfs:label "collect (data life cycle stage)" ;
    iso:definition "The collect activity includes the data acquisition, gathering and creation process, learning from previous decisions made, and additional context extracted from other data sets (internal or external)." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO 55013:2024" ;
    iso:provenanceClause "4.4.3" .
iso:phase_data_store a iso:IsoNode, iso:Concept ;
    iso:nodeId "phase_data_store" ;
    iso:part "ISO 55013" ;
    rdfs:label "store (data life cycle stage)" ;
    iso:definition "The store activity includes locating the data where it can be retrieved." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO 55013:2024" ;
    iso:provenanceClause "4.4.4" .
iso:phase_data_reporting a iso:IsoNode, iso:Concept ;
    iso:nodeId "phase_data_reporting" ;
    iso:part "ISO 55013" ;
    rdfs:label "reporting (data life cycle stage)" ;
    iso:definition "The reporting activity includes the manual or automated extraction and analysis of data [...] It is important to note that the reporting and deciding activities can be interchangeable in their order, as they have a bidirectional relationship." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO 55013:2024" ;
    iso:provenanceClause "4.4.5" .
iso:phase_data_decide a iso:IsoNode, iso:Concept ;
    iso:nodeId "phase_data_decide" ;
    iso:part "ISO 55013" ;
    rdfs:label "decide (data life cycle stage)" ;
    iso:definition "The decide activity occurs when a decision is made based on the report evaluation. The decisions may be made by people within the organization or by automated means." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO 55013:2024" ;
    iso:provenanceClause "4.4.6" .
iso:phase_data_distribute a iso:IsoNode, iso:Concept ;
    iso:nodeId "phase_data_distribute" ;
    iso:part "ISO 55013" ;
    rdfs:label "distribute (data life cycle stage)" ;
    iso:definition "The distribute activity involves extraction or copying of data via the reporting activity for circulation to external parties." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "low" ;
    iso:provenanceStandard "ISO 55013:2024" ;
    iso:provenanceClause "4.4.7" .
iso:phase_data_dispose a iso:IsoNode, iso:Concept ;
    iso:nodeId "phase_data_dispose" ;
    iso:part "ISO 55013" ;
    rdfs:label "dispose/archiving (data life cycle stage)" ;
    iso:definition "The dispose activity usually involves identifying data for disposal via the report activity and then permanently removing that data and any duplicates from the data store." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO 55013:2024" ;
    iso:provenanceClause "4.4.8" .
iso:term_data_driven_decision_making a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_data_driven_decision_making" ;
    iso:part "ISO 55013" ;
    rdfs:label "asset data driven decision-making" ;
    iso:definition "includes whole life planning, reliability analysis, risk analysis, work management optimization, demand analysis and sustainability assessment." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO 55013:2024" ;
    iso:provenanceClause "5.1" .
iso:term_asset_data_usefulness a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_asset_data_usefulness" ;
    iso:part "ISO 55013" ;
    rdfs:label "usefulness of asset data" ;
    iso:definition "Asset data are useful if they support organizational objectives. The usefulness of asset data can be improved by data management and governance processes." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO 55013:2024" ;
    iso:provenanceClause "5.2" .
iso:term_data_asset_identification a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_data_asset_identification" ;
    iso:part "ISO 55013" ;
    rdfs:label "identifying data assets" ;
    iso:definition "Treating such collections of data sets as a data asset can help an organization achieve its asset management objectives requiring additional controls to align with and support these asset management objectives." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO 55013:2024" ;
    iso:provenanceClause "6.1" .
iso:term_data_availability a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_data_availability" ;
    iso:part "ISO 55013" ;
    rdfs:label "data availability" ;
    iso:definition "Data asset availability can be assessed as: a) readily available, either internally or externally to the organization [...] Data that exists but is not accessible to the asset management function is considered as \"not available\"." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO 55013:2024" ;
    iso:provenanceClause "7.3" .
iso:term_semantic_interoperability a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_semantic_interoperability" ;
    iso:part "ISO 55013" ;
    rdfs:label "semantic data interoperability" ;
    iso:definition "Semantic data interoperability ensures that data are interpreted in the same way by different entities. Semantic data interoperability can be supported by common vocabularies or ontologies. The use of appropriate identifiers ensures that asset data from different sources is correctly associated with the same asset." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO 55013:2024" ;
    iso:provenanceClause "7.5" .
iso:term_digital_preservation a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_digital_preservation" ;
    iso:part "ISO 55013" ;
    rdfs:label "digital preservation" ;
    iso:definition "Data asset management activities support the development of approaches to ensure that the usefulness of the data asset is available for as long as is required." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO 55013:2024" ;
    iso:provenanceClause "7.6" .
iso:term_data_culture a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_data_culture" ;
    iso:part "ISO 55013" ;
    rdfs:label "asset information culture" ;
    iso:definition "The organization should promote culture and behaviours relating to the management and usage of asset data and data assets." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "low" ;
    iso:provenanceStandard "ISO 55013:2024" ;
    iso:provenanceClause "7.7" .
iso:term_data_governance a iso:IsoNode, iso:Concept ;
    iso:nodeId "term_data_governance" ;
    iso:part "ISO 55013" ;
    rdfs:label "data governance" ;
    iso:definition "Governance ensures that there is suitable oversight of the data asset and asset data related activities. [...] Approaches to governance often follow the evaluate, direct, monitor (EDM) model" ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "medium" ;
    iso:provenanceStandard "ISO 55013:2024" ;
    iso:provenanceClause "Clause 8" .


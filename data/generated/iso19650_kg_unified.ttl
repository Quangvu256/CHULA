    iso:provenanceStandard "ISO 19650-5" ;
    iso:provenanceClause "3.12; 6.4.1" ;
    iso:relationshipNote "Residual risk = risk that remains after controls have been implemented; 6.4.1 requires it to be identified and recorded following the development of the mitigation measures." .
iso:term_residual_risk iso:PART_OF iso:term_security_strategy .
iso:rel_1065 a rdf:Statement ;

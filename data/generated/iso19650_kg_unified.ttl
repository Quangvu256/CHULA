    iso:nodeId "term_information_sharing_agreement" ;
    iso:part "ISO 19650-5" ;
    rdfs:label "information sharing agreement" ;
    iso:definition "The organization(s) shall put in place information sharing agreements, or equivalent, when working outside formal appointments (for example during tendering) if access is going to be granted to sensitive information." ;
    iso:sourceType "mixed_normative_informative" ;
    iso:pdmRelevance "medium" ;

    iso:nodeId "term_security_containment_recovery" ;
    iso:part "ISO 19650-5" ;
    rdfs:label "security containment and recovery" ;
    iso:definition "The organization(s) shall set out the steps to be taken in the event of a security breach/incident to contain and recover from the event that include: a) measures for reducing further damage or loss" ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO 19650-5" ;
    iso:provenanceClause "8.3" .

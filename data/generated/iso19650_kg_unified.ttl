    iso:part "ISO 19650-5" ;
    rdfs:label "security breach or incident discovery response" ;
    iso:definition "The organization(s) shall set out the steps to be taken in the event of a discovery of a security breach or incident which shall include: a) the persons or roles to be contacted immediately and their contact details; b) the processes used to identify the concerned parties" ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO 19650-5" ;

    iso:part "ISO 19650-5" ;
    rdfs:label "sensitive built asset" ;
    iso:definition "A built asset shall be considered sensitive, as a whole or in part, if it: a) comprises critical national infrastructure, identified by the local or national government" ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO 19650-5" ;

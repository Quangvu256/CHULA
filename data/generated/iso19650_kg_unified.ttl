    iso:nodeId "term_security_management_plan" ;
    iso:part "ISO 19650-5" ;
    rdfs:label "security management plan" ;
    iso:definition "The organization(s) shall develop, maintain and implement a security management plan which enables the agreed mitigation measures set out in the security strategy to be implemented in a consistent and holistic manner." ;
    iso:sourceType "body_clause" ;
    iso:pdmRelevance "high" ;
    iso:provenanceStandard "ISO 19650-5" ;

iso:rel_539 a rdf:Statement ;
    rdfs:label "reference number : 539" ;
    rdf:subject iso:term_appointing_party ;
    rdf:predicate iso:CORRESPONDS_TO ;
    rdf:object iso:term_client ;
    iso:provenanceStandard "ISO 19650-1" ;
    iso:provenanceClause "3.2.4 Note 1" ;
    iso:relationshipNote "Note 1 to 3.2.4: 'In some countries the appointing party can be termed client (3.2.5), owner or employer but the appointing party is not limited to these functions.' The correspondence is regional and partial, which is why it is CORRESPONDS_TO and not SUBTYPE_OF." .
iso:term_capability iso:APPLIES_TO iso:term_delivery_team .
iso:rel_540 a rdf:Statement ;
    rdfs:label "reference number : 540" ;
    rdf:subject iso:term_capability ;
    rdf:predicate iso:APPLIES_TO ;
    rdf:object iso:term_delivery_team ;
    iso:provenanceStandard "ISO 19650-1" ;
    iso:provenanceClause "8.1" ;
    iso:relationshipNote "8.1: 'The appointing party should review the capability and capacity of the prospective delivery team to meet the information requirements.' 8.1 adds that capability refers to being able to perform a given activity, for example by having the necessary experience, skill or technical resources." .
iso:term_capacity iso:APPLIES_TO iso:term_delivery_team .

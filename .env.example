# Copy to .env and change the password before `docker compose up`.
# NEO4J_AUTH format is user/password (Neo4j image convention).
NEO4J_AUTH=neo4j/changeme-please
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme-please

# Where the web UI's "Neo4j Browser" link points (host-visible URL).
NEO4J_BROWSER=http://localhost:7474
